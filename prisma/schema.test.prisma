generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma-sqlite"
}

datasource db {
  provider = "sqlite"
}

// ─── Foundation: User & Auth ────────────────────────────────────────────────

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String?
  hashedPassword String?   @map("hashed_password")
  isActive       Boolean   @default(true) @map("is_active")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deactivatedAt  DateTime? @map("deactivated_at")

  sessions                  Session[]
  roleAssignments           UserRoleAssignment[]
  auditEvents               AuditEvent[]
  engagementMemberships     EngagementMembership[]
  submittedEvidence         Evidence[]                @relation("SubmittedEvidence")
  validatedEvidence         Evidence[]                @relation("ValidatedEvidence")
  recommendationApprovals   Recommendation[]
  assignedActions           Action[]                  @relation("AssignedActions")
  completedActions          Action[]                  @relation("CompletedActions")
  verifiedActions           Action[]                  @relation("VerifiedActions")

  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  token        String    @unique
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model UserRoleAssignment {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  role      String
  scope     String?
  scopeId   String?   @map("scope_id")
  grantedBy String?   @map("granted_by")
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")
  isActive  Boolean   @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, role, scope, scopeId])
  @@index([userId, isActive])
  @@map("user_role_assignments")
}

// ─── Identity: Engagement Membership ────────────────────────────────────────

model EngagementMembership {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  engagementId  String    @map("engagement_id")
  role          String
  addedBy       String?   @map("added_by")
  addedAt       DateTime  @default(now()) @map("added_at")
  removedAt     DateTime? @map("removed_at")
  isActive      Boolean   @default(true) @map("is_active")

  user       User       @relation(fields: [userId], references: [id])
  engagement Engagement @relation(fields: [engagementId], references: [id])

  @@unique([userId, engagementId, role])
  @@index([engagementId, isActive])
  @@index([userId, isActive])
  @@map("engagement_memberships")
}

// ─── Module 2: Lead ────────────────────────────────────────────────────────

model LeadRecord {
  id              String    @id @default(uuid())
  companyName     String    @map("company_name")
  contactName     String?   @map("contact_name")
  contactEmail    String?   @map("contact_email")
  contactPhone    String?   @map("contact_phone")
  source          String?
  status          String    @default("new")
  notes           String?
  estimatedValue  Float?    @map("estimated_value")
  convertedToClientId String? @map("converted_to_client_id")
  engagementId    String?   @map("engagement_id")
  assignedTo      String?   @map("assigned_to")
  createdBy       String?   @map("created_by")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  client          ClientAccount? @relation(fields: [convertedToClientId], references: [id])
  engagement      Engagement?    @relation(fields: [engagementId], references: [id])

  @@index([status])
  @@index([assignedTo])
  @@index([convertedToClientId])
  @@map("lead_records")
}

// ─── Module 2: Client Account ──────────────────────────────────────────────

model ClientAccount {
  id              String    @id @default(uuid())
  name            String
  legalName       String?   @map("legal_name")
  industry        String?
  size            String?
  status          String    @default("active")
  website         String?
  address         String?
  notes           String?
  version         Int       @default(1)
  visibility      String    @default("internal")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  archivedAt      DateTime? @map("archived_at")

  contacts        ClientContact[]
  engagements     Engagement[]
  leads           LeadRecord[]

  @@index([status])
  @@map("client_accounts")
}

model ClientContact {
  id              String    @id @default(uuid())
  clientId        String    @map("client_id")
  name            String
  email           String?
  phone           String?
  role            String?
  isPrimary       Boolean   @default(false) @map("is_primary")
  isActive        Boolean   @default(true) @map("is_active")
  notes           String?
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  client          ClientAccount @relation(fields: [clientId], references: [id])

  @@index([clientId, isActive])
  @@map("client_contacts")
}

// ─── Module 2: Engagement ──────────────────────────────────────────────────

model Engagement {
  id                    String    @id @default(uuid())
  code                  String    @unique
  title                 String
  clientId              String    @map("client_id")
  serviceTier           String    @map("service_tier")
  engagementMode        String    @map("engagement_mode")
  status                String    @default("draft")
  healthStatus          String    @default("healthy") @map("health_status")
  interventionMode      String?   @map("intervention_mode")
  interventionPhase     String?   @map("intervention_phase")
  description           String?
  startDate             DateTime? @map("start_date")
  targetEndDate         DateTime? @map("target_end_date")
  actualEndDate         DateTime? @map("actual_end_date")
  ownerId               String?   @map("owner_id")
  assignedConsultantId  String?   @map("assigned_consultant_id")
  currentScopeVersionId String?   @map("current_scope_version_id")
  parentEngagementId    String?   @map("parent_engagement_id")
  version               Int       @default(1)
  visibility            String    @default("internal")
  createdBy             String?   @map("created_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  client                ClientAccount         @relation(fields: [clientId], references: [id])
  parent                Engagement?           @relation("EngagementLineage", fields: [parentEngagementId], references: [id])
  children              Engagement[]          @relation("EngagementLineage")
  conditionProfiles     BusinessConditionProfile[]
  memberships           EngagementMembership[]
  leads                 LeadRecord[]
  stages                Stage[]
  findings              Finding[]
  recommendations       Recommendation[]
  evidence              Evidence[]
  evidenceBundles       EvidenceBundle[]
  actions               Action[]
  shockEvents           ShockEvent[]
  kpis                  KPI[]
  deliverables          Deliverable[]
  risks                 Risk[]

  @@index([clientId])
  @@index([status])
  @@index([ownerId])
  @@index([parentEngagementId])
  @@map("engagements")
}

// ─── Module 2: Business Condition Profile ──────────────────────────────────

model BusinessConditionProfile {
  id                      String    @id @default(uuid())
  engagementId            String    @map("engagement_id")
  businessStatus          String    @map("business_status")
  severityScore           Int       @map("severity_score")
  urgencyLevel            String    @map("urgency_level")
  cashPressureLevel       String    @map("cash_pressure_level")
  marginPressureLevel     String    @map("margin_pressure_level")
  clientConcentrationRisk String    @map("client_concentration_risk")
  ownerDependencyRisk     String    @map("owner_dependency_risk")
  keyPersonDependencyRisk String    @map("key_person_dependency_risk")
  processMaturityLevel    String    @map("process_maturity_level")
  managementMaturityLevel String    @map("management_maturity_level")
  executionCapacityLevel  String    @map("execution_capacity_level")
  moraleFragilityLevel    String    @map("morale_fragility_level")
  resilienceLevel         String    @map("resilience_level")
  growthReadinessLevel    String    @map("growth_readiness_level")
  notes                   String?
  assessedBy              String?   @map("assessed_by")
  version                 Int       @default(1)
  isCurrent               Boolean   @default(true) @map("is_current")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  engagement              Engagement @relation(fields: [engagementId], references: [id])

  @@index([engagementId, isCurrent])
  @@index([engagementId])
  @@map("business_condition_profiles")
}

// ─── Module: Evidence, Finding, Recommendation, Action ─────────────────────

model Evidence {
  id                String    @id @default(uuid())
  engagementId      String    @map("engagement_id")
  title             String
  description       String?
  evidenceType      String    @map("evidence_type")
  sourceReference   String?   @map("source_reference")
  status            String    @default("submitted")
  severity          String?
  relatedFindingId  String?   @map("related_finding_id")
  submittedBy       String?   @map("submitted_by")
  validatedBy       String?   @map("validated_by")
  validatedAt       DateTime? @map("validated_at")
  rejectionReason   String?   @map("rejection_reason")
  version           Int       @default(1)
  visibility        String    @default("internal")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  engagement   Engagement           @relation(fields: [engagementId], references: [id])
  finding      Finding?             @relation(fields: [relatedFindingId], references: [id])
  submitter    User?                @relation("SubmittedEvidence", fields: [submittedBy], references: [id])
  validator    User?                @relation("ValidatedEvidence", fields: [validatedBy], references: [id])
  bundleItems  EvidenceBundleItem[]

  @@index([engagementId])
  @@index([status])
  @@index([relatedFindingId])
  @@map("evidence")
}

model EvidenceBundle {
  id           String    @id @default(uuid())
  engagementId String    @map("engagement_id")
  title        String
  description  String?
  status       String    @default("active")
  createdBy    String?   @map("created_by")
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  engagement Engagement              @relation(fields: [engagementId], references: [id])
  items      EvidenceBundleItem[]

  @@index([engagementId])
  @@index([status])
  @@map("evidence_bundles")
}

model EvidenceBundleItem {
  id            String    @id @default(uuid())
  bundleId      String    @map("bundle_id")
  evidenceId    String    @map("evidence_item_id")
  addedBy       String?   @map("added_by")
  addedAt       DateTime  @default(now()) @map("added_at")
  removedAt     DateTime? @map("removed_at")

  bundle   EvidenceBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  evidence Evidence       @relation(fields: [evidenceId], references: [id])

  @@unique([bundleId, evidenceId])
  @@index([bundleId])
  @@index([evidenceId])
  @@map("evidence_bundle_items")
}

model Finding {
  id              String    @id @default(uuid())
  engagementId    String    @map("engagement_id")
  title           String
  description     String?
  findingType     String    @map("finding_type")
  impactArea      String?   @map("impact_area")
  severity        String
  rootCause       String?   @map("root_cause")
  linkedEvidence  String?   @map("linked_evidence")
  status          String    @default("draft")
  version         Int       @default(1)
  provisionalFlag Boolean   @default(false) @map("provisional_flag")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  engagement       Engagement @relation(fields: [engagementId], references: [id])
  recommendations  Recommendation[]
  evidence         Evidence[]

  @@index([engagementId])
  @@index([severity])
  @@map("findings")
}

model Recommendation {
  id              String    @id @default(uuid())
  engagementId    String    @map("engagement_id")
  findingId       String?   @map("finding_id")
  title           String
  description     String?
  rationale       String?
  priority        String
  estimatedImpact String?   @map("estimated_impact")
  status          String    @default("pending")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  version         Int       @default(1)
  visibility      String    @default("internal")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  engagement Engagement @relation(fields: [engagementId], references: [id])
  finding    Finding?   @relation(fields: [findingId], references: [id])
  approver   User?      @relation(fields: [approvedBy], references: [id])
  actions    Action[]

  @@unique([findingId, title])
  @@index([engagementId])
  @@index([status])
  @@map("recommendations")
}

model Action {
  id                  String    @id @default(uuid())
  engagementId        String    @map("engagement_id")
  recommendationId    String    @map("recommendation_id")
  title               String
  description         String?
  dueDate             DateTime? @map("due_date")
  priority            String
  status              String    @default("draft")
  assignedTo          String?   @map("assigned_to")
  completedBy         String?   @map("completed_by")
  completedAt         DateTime? @map("completed_at")
  verifiedBy          String?   @map("verified_by")
  verifiedAt          DateTime? @map("verified_at")
  notes               String?
  blockerReason       String?   @map("blocker_reason")
  version             Int       @default(1)
  visibility          String    @default("internal")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  engagement      Engagement      @relation(fields: [engagementId], references: [id])
  recommendation  Recommendation  @relation(fields: [recommendationId], references: [id])
  assignee        User?           @relation("AssignedActions", fields: [assignedTo], references: [id])
  completer       User?           @relation("CompletedActions", fields: [completedBy], references: [id])
  verifier        User?           @relation("VerifiedActions", fields: [verifiedBy], references: [id])

  @@index([engagementId])
  @@index([status])
  @@index([recommendationId])
  @@index([assignedTo])
  @@map("actions")
}

// ─── Foundation: ShockEvent ─────────────────────────────────────────────────

model ShockEvent {
  id             String    @id @default(uuid())
  engagementId   String    @map("engagement_id")
  type           String    // key_employee_loss, major_client_loss, margin_collapse, payroll_pressure, service_breakdown, supplier_failure, owner_withdrawal, compliance_issue
  severity       String    // low, medium, high, critical
  happenedAt     DateTime  @map("happened_at")
  notes          String?
  reportedBy     String?   @map("reported_by")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  engagement Engagement @relation(fields: [engagementId], references: [id])

  @@index([engagementId])
  @@index([type])
  @@index([severity])
  @@map("shock_events")
}

// ─── Foundation: Audit ──────────────────────────────────────────────────────

model AuditEvent {
  id            String   @id @default(uuid())
  eventName     String   @map("event_name")
  actorId       String?  @map("actor_id")
  actorType     String   @default("user") @map("actor_type")
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id")
  payload       String?
  correlationId String?  @map("correlation_id")
  visibility    String   @default("internal")
  occurredAt    DateTime @default(now()) @map("occurred_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([eventName])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([occurredAt])
  @@index([correlationId])
  @@map("audit_events")
}

// ─── Foundation: Idempotency ────────────────────────────────────────────────

model IdempotencyRecord {
  id            String   @id @default(uuid())
  idempotencyKey String  @unique @map("idempotency_key")
  operationName String   @map("operation_name")
  status        String   @default("pending")
  payload       String?  @map("payload")
  responseCode  Int?     @map("response_code")
  responseBody  String?  @map("response_body")
  createdAt     DateTime @default(now()) @map("created_at")
  completedAt   DateTime? @map("completed_at")
  expiresAt     DateTime @map("expires_at")

  @@index([idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ─── Foundation: Scheduler ──────────────────────────────────────────────────

model ScheduledTask {
  id            String    @id @default(uuid())
  taskName      String    @map("task_name")
  payload       String?
  status        String    @default("pending")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(3) @map("max_attempts")
  lastError     String?   @map("last_error")
  scheduledFor  DateTime  @map("scheduled_for")
  startedAt     DateTime? @map("started_at")
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, scheduledFor])
  @@index([taskName])
  @@map("scheduled_tasks")
}

// ─── Module 3: Stage ────────────────────────────────────────────────────────

model Stage {
  id                String    @id @default(uuid())
  engagementId      String    @map("engagement_id")
  title             String
  status            String    @default("draft")
  description       String?
  notes             String?
  version           Int       @default(1)
  startDate         DateTime? @map("start_date")
  targetEndDate     DateTime? @map("target_end_date")
  completedAt       DateTime? @map("completed_at")
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  engagement        Engagement @relation(fields: [engagementId], references: [id])
  deliverables      Deliverable[]
  risks             Risk[]

  @@index([engagementId])
  @@index([status])
  @@map("stages")
}

// ─── Module 3: KPI ──────────────────────────────────────────────────────────

model KPI {
  id                String    @id @default(uuid())
  engagementId      String    @map("engagement_id")
  name              String
  description       String?
  target            Float?
  currentValue      Float?    @map("current_value")
  measurementDate   DateTime? @map("measurement_date")
  direction         String    @default("up")
  version           Int       @default(1)
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  engagement        Engagement @relation(fields: [engagementId], references: [id])
  snapshots         KPISnapshot[]

  @@index([engagementId])
  @@map("kpis")
}

model KPISnapshot {
  id                String    @id @default(uuid())
  kpiId             String    @map("kpi_id")
  value             Float
  recordedAt        DateTime  @default(now()) @map("recorded_at")
  recordedBy        String?   @map("recorded_by")

  kpi               KPI       @relation(fields: [kpiId], references: [id])

  @@index([kpiId])
  @@index([recordedAt])
  @@map("kpi_snapshots")
}

// ─── Module 3: Deliverable ──────────────────────────────────────────────────

model Deliverable {
  id                String    @id @default(uuid())
  stageId           String    @map("stage_id")
  engagementId      String    @map("engagement_id")
  title             String
  description       String?
  status            String    @default("draft")
  version           Int       @default(1)
  submittedBy       String?   @map("submitted_by")
  submittedAt       DateTime? @map("submitted_at")
  approvedBy        String?   @map("approved_by")
  approvedAt        DateTime? @map("approved_at")
  rejectionReason   String?   @map("rejection_reason")
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  stage             Stage     @relation(fields: [stageId], references: [id])
  engagement        Engagement @relation(fields: [engagementId], references: [id])

  @@index([stageId])
  @@index([engagementId])
  @@index([status])
  @@map("deliverables")
}

// ─── Module 3: Risk ─────────────────────────────────────────────────────────

model Risk {
  id                String    @id @default(uuid())
  stageId           String    @map("stage_id")
  engagementId      String    @map("engagement_id")
  title             String
  description       String?
  status            String    @default("identified")
  identifiedAt      DateTime  @default(now()) @map("identified_at")
  identifiedBy      String?   @map("identified_by")
  assessedAt        DateTime? @map("assessed_at")
  assessedBy        String?   @map("assessed_by")
  mitigationStrategy String? @map("mitigation_strategy")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  stage             Stage     @relation(fields: [stageId], references: [id])
  engagement        Engagement @relation(fields: [engagementId], references: [id])

  @@index([stageId])
  @@index([engagementId])
  @@index([status])
  @@map("risks")
}
