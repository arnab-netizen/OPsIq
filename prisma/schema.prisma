}

/// Jarvis 360 Slice 6 — staff skills matrix. Tracks which skills a staff member has
/// proven, the SOP they were trained on, and whether equipment use is authorized.
model OwnerStaffSkill {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
