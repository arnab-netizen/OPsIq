  model          String    @default("SUBSCRIPTION")
  billingCycle   String    @default("MONTHLY") @map("billing_cycle")
  basePrice      Float     @map("base_price")
  currency       String    @default("USD")
  volume         Float?
  volumeUnit     String?   @map("volume_unit")
  activationDate DateTime? @map("activation_date")
  status         String    @default("DRAFT")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("revenue_stream_records")
}

// ─── Growth: Retention Cohort Persistence ────────────────────────────────────
// Replaces the BUILT_VOLATILE in-memory Map in RetentionEngine.
// Each row stores one cohort's observed retention curve and average monthly churn.
// workspaceId is an indexed plain UUID (matches Workspace.id from canonical context).
model RetentionCohort {
  id               String   @id @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  cohortMonth      String   @map("cohort_month") // YYYY-MM
  cohortSize       Int?     @map("cohort_size")
  monthlyRetention Json     @map("monthly_retention") // Record<number, number> — month → retention rate 0–1
  avgMonthlyChurn  Float    @default(0) @map("avg_monthly_churn") // 0–1
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, cohortMonth])
  @@index([workspaceId])
  @@index([workspaceId, cohortMonth])
  @@map("retention_cohorts")
}

// Phase 7: Governed Operating Policy Registry
// Owner-configurable per-workspace policies that gate expenditure and growth decisions.
// Policy evaluation returns ALLOW / WARN / BLOCK with explanation and override path.
// Every policy change emits an audit event (transactionally atomic).
model OperatingPolicy {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId                String   @map("workspace_id") @db.Uuid
  /// Stable machine key, e.g. "high_cost_low_payback" or "growth_before_capacity".
  policyKey                  String   @map("policy_key")
  category                   String // COST_CONTROL | GROWTH_GATING | CASH_PROTECTION | CAPACITY_PROTECTION
  description                String
  threshold                  Float
  thresholdUnit              String   @map("threshold_unit") // MONTHS | PERCENT | CURRENCY_GBP
  /// false = warn only; true = hard block (no action without explicit override).
  hardBlock                  Boolean  @default(false) @map("hard_block")
  /// Minimum role that may create an override: OWNER | ADMIN.
  overrideAuthorityRole      String   @map("override_authority_role")
  overrideReasonRequired     Boolean  @default(true) @map("override_reason_required")
  /// Minutes until an override auto-expires. null = override never expires (use with care).
  expiryAfterOverrideMinutes Int?     @map("expiry_after_override_minutes")
  isActive                   Boolean  @default(true) @map("is_active")
  createdBy                  String   @map("created_by") @db.Uuid
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  workspace Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  overrides OperatingPolicyOverride[]

  @@unique([workspaceId, policyKey])
  @@index([workspaceId, isActive])
  @@map("operating_policies")
}

/// Time-limited owner override of an OperatingPolicy.
/// Allows an owner to proceed past a WARN/BLOCK for a stated reason, within a configured time window.
model OperatingPolicyOverride {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyId     String    @map("policy_id") @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  overriddenBy String    @map("overridden_by") @db.Uuid
  reason       String
  /// JSON snapshot of the evaluation context that triggered the override.
  context      Json      @default("{}")
  expiresAt    DateTime? @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  revokedBy    String?   @map("revoked_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  policy    OperatingPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([workspaceId, expiresAt])
  @@map("operating_policy_overrides")
}

// ─── Phase 4: Business Operating System ──────────────────────────────────────
// Connects existing engines into a unified BOS: objective hierarchy, goal
// arbitration, resource intelligence, portfolio optimization, risk register,
// KPI ownership, cost attribution, decision confidence evolution, constraint
// lifecycle, explainability, and unified operating memory.
// All additions are additive (nullable fields, new tables). No backfill.

/// Structured business objective with parent/child hierarchy and resource budget.
/// Distinct from OwnerGoal (single financial target) — a BusinessObjective is
/// the building block of the goal arbitration and portfolio optimizer engines.
model BusinessObjective {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String    @map("workspace_id") @db.Uuid
  parentId               String?   @map("parent_id") @db.Uuid
  title                  String
  description            String?   @db.Text
  objectiveType          String    @map("objective_type") // REVENUE | COST_REDUCTION | QUALITY | COMPLIANCE | GROWTH | RESILIENCE | STRATEGIC
  targetMetricName       String?   @map("target_metric_name")
  targetValue            Float?    @map("target_value")
  currentValue           Float?    @map("current_value")
  unit                   String?
  deadline               DateTime?
  status                 String    @default("ACTIVE") // ACTIVE | PAUSED | ACHIEVED | ABANDONED
  priorityScore          Float     @default(0) @map("priority_score") // 0-100 computed by arbitration engine
  resourceBudget         Json      @default("{}") @map("resource_budget") // { budget?: number, timeHours?: number, staffCount?: number }
  constraints            Json      @default("[]") // array of GateConstraint strings that block this objective
  ownerId                String?   @map("owner_id") @db.Uuid // userId responsible
  linkedGoalId           String?   @map("linked_goal_id") @db.Uuid // FK → OwnerGoal (optional)
  linkedStartupSessionId String?   @map("linked_startup_session_id") @db.Uuid
  linkedStartupIdeaId    String?   @map("linked_startup_idea_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  parent    BusinessObjective?            @relation("ObjectiveHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  BusinessObjective[]           @relation("ObjectiveHierarchy")
  blockedBy BusinessObjectiveDependency[] @relation("BlockedObjective")
  blocks    BusinessObjectiveDependency[] @relation("BlockingObjective")

  @@index([workspaceId, status])
  @@index([workspaceId, objectiveType])
  @@index([workspaceId, parentId])
  @@map("business_objectives")
}

/// Directed dependency edge: blockingId must be achieved/unblocked before blockedId can proceed.
model BusinessObjectiveDependency {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  blockingId  String   @map("blocking_id") @db.Uuid // prerequisite objective
  blockedId   String   @map("blocked_id") @db.Uuid // dependent objective
  depType     String   @default("PREREQUISITE") @map("dep_type") // PREREQUISITE | RESOURCE_CONFLICT | SEQUENCING
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  blocking BusinessObjective @relation("BlockingObjective", fields: [blockingId], references: [id], onDelete: Cascade)
  blocked  BusinessObjective @relation("BlockedObjective", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, blockingId, blockedId])
  @@index([workspaceId, blockedId])
  @@map("business_objective_dependencies")
}

/// Persisted goal arbitration decision — records which objective won and why.
model GoalArbitrationRecord {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  candidateIds       Json     @map("candidate_ids") // string[] — all objective IDs considered
  winnerObjectiveId  String?  @map("winner_objective_id") @db.Uuid
  arbitrationResult  Json     @map("arbitration_result") // full ArbitrationResult JSON
  dominantConstraint String?  @map("dominant_constraint") // GateConstraint value if any blocked
  resourceConflict   Json?    @map("resource_conflict") // { poolId, shortage } if resource-driven
  portfolioDecisions Json?    @map("portfolio_decisions") // PortfolioDecision[] — EXECUTE_NOW|DELAY|CANCEL|MERGE|SPLIT|ESCALATE per objective
  actorId            String   @map("actor_id") @db.Uuid
  arbitratedAt       DateTime @default(now()) @map("arbitrated_at")

  @@index([workspaceId, arbitratedAt])
  @@index([workspaceId, winnerObjectiveId])
  @@map("goal_arbitration_records")
}

/// Resource pool: a finite capacity of budget, time, staff, equipment, or owner attention.
model ResourcePool {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  resourceType  String    @map("resource_type") // BUDGET | TIME_HOURS | STAFF_CAPACITY | EQUIPMENT_CAPACITY | OWNER_ATTENTION
  label         String // human-readable name, e.g. "Q3 Capex Budget"
  totalCapacity Float     @map("total_capacity")
  unit          String // USD | hours | FTE | pct | units
  periodStart   DateTime? @map("period_start")
  periodEnd     DateTime? @map("period_end")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  allocations ResourceAllocation[]

  @@index([workspaceId, isActive])
  @@index([workspaceId, resourceType])
  @@map("resource_pools")
}

/// An allocation of resource pool capacity to a business objective.
model ResourceAllocation {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  poolId           String    @map("pool_id") @db.Uuid
  objectiveId      String    @map("objective_id") @db.Uuid
  allocationAmount Float     @map("allocation_amount")
  priority         Int       @default(50) // 0-100; higher priority allocations are protected when capacity is scarce
  status           String    @default("ALLOCATED") // ALLOCATED | RELEASED | EXPIRED | OVER_COMMITTED
  allocatedBy      String    @map("allocated_by") @db.Uuid
  allocatedAt      DateTime  @default(now()) @map("allocated_at")
  releasedAt       DateTime? @map("released_at")
  idempotencyKey   String?   @unique @map("idempotency_key")

  pool ResourcePool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([workspaceId, poolId])
  @@index([workspaceId, objectiveId])
  @@index([workspaceId, status])
  @@map("resource_allocations")
}

/// Business-level risk register — distinct from engagement Risk (which is client-scoped).
/// Tracks operational, financial, market, compliance, execution, and strategic risks.
model BusinessRiskEntry {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String    @map("workspace_id") @db.Uuid
  riskCode               String    @map("risk_code") // stable machine key, e.g. "key_person_dependency"
  title                  String
  description            String?   @db.Text
  category               String // OPERATIONAL | FINANCIAL | MARKET | COMPLIANCE | EXECUTION | STRATEGIC
  likelihood             Int       @default(50) // 0-100
  impact                 Int       @default(50) // 0-100
  severity               Int       @default(50) // computed: Math.round(likelihood * impact / 100)
  status                 String    @default("IDENTIFIED") // IDENTIFIED | MITIGATING | ACCEPTED | RESOLVED | TRANSFERRED | CLOSED
  mitigationAction       String?   @map("mitigation_action") @db.Text
  mitigationOwner        String?   @map("mitigation_owner") // Name/role of person responsible for mitigation
  reviewDueDate          DateTime? @map("review_due_date") // When the risk must next be reviewed
  acceptanceRationale    String?   @map("acceptance_rationale") @db.Text // Why residual risk was accepted
  residualRisk           Int?      @map("residual_risk") // 0-100 after mitigation
  linkedObjectiveId      String?   @map("linked_objective_id") @db.Uuid
  linkedStartupSessionId String?   @map("linked_startup_session_id") @db.Uuid
  // R7: provenance — distinguishes blueprint-created artifacts from independently-created records
  originBlueprintId      String?   @map("origin_blueprint_id") @db.Uuid
  originType             String?   @map("origin_type") // BLUEPRINT_ARTIFACT | INDEPENDENT
  reviewedAt             DateTime? @map("reviewed_at")
  identifiedBy           String    @map("identified_by") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  taskLinks RiskTaskLink[]

  @@unique([workspaceId, riskCode])
  @@index([workspaceId, status])
  @@index([workspaceId, category])
  @@index([workspaceId, severity])
  @@index([workspaceId, originBlueprintId])
  @@map("business_risk_entries")
}

/// Bundle 3.4 — Risk ↔ Task linkage. One risk may have many mitigation/evidence tasks.
/// Workspace-scoped with duplicate-prevention via unique(workspaceId, riskId, taskId).
model RiskTaskLink {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  riskId      String   @map("risk_id") @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  linkType    String   @default("MITIGATION") @map("link_type") // MITIGATION | EVIDENCE
  linkedBy    String   @map("linked_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  risk BusinessRiskEntry @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, riskId, taskId], map: "risk_task_links_workspace_pair")
  @@index([workspaceId, riskId], map: "rtl_risk_idx")
  @@index([workspaceId, taskId], map: "rtl_task_idx")
  @@map("risk_task_links")
}

/// Workspace-scoped KPI ownership — links a metric to an owner and review cadence.
/// Complements engagement-scoped KPI; tracks who is accountable for each metric in the BOS.
model KPIOwnershipRecord {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  metricName        String    @map("metric_name") // stable slug, e.g. "cash_collection_lag_days"
  metricLabel       String    @map("metric_label") // human-readable
  ownerUserId       String    @map("owner_user_id") @db.Uuid
  reviewCadence     String    @map("review_cadence") // DAILY | WEEKLY | MONTHLY | QUARTERLY
  targetValue       Float?    @map("target_value")
  currentValue      Float?    @map("current_value")
  baselineValue     Float?    @map("baseline_value") // value at baseline measurement
  unit              String?
  direction         String? // HIGHER_IS_BETTER | LOWER_IS_BETTER
  trend             String? // IMPROVING | STABLE | DECLINING
  confidenceLevel   String?   @map("confidence_level") // very_high | high | moderate | low | very_low
  linkedObjectiveId String?   @map("linked_objective_id") @db.Uuid
  lastReviewedAt    DateTime? @map("last_reviewed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, metricName])
  @@index([workspaceId, ownerUserId])
  @@map("kpi_ownership_records")
}

/// Time-series record of decision confidence — enables confidence evolution tracking.
/// Each time the confidence engine scores a decision type, a row is appended.
model DecisionConfidenceRecord {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  decisionRef     String   @map("decision_ref") // stable key: e.g. "objective:uuid" or "intervention:key"
  decisionType    String   @map("decision_type") // OBJECTIVE | INTERVENTION | OUTCOME | RISK | RESOURCE
  confidenceScore Float    @map("confidence_score") // 0-100
  confidenceLevel String   @map("confidence_level") // very_high | high | moderate | low | very_low
  evidenceCount   Int      @default(0) @map("evidence_count")
  confidenceBasis Json     @map("confidence_basis") // { dataQuality, historicalAccuracy, executionCertainty }
  recordedAt      DateTime @default(now()) @map("recorded_at")

  @@index([workspaceId, decisionRef])
  @@index([workspaceId, decisionType, recordedAt])
  @@map("decision_confidence_records")
}

/// Lifecycle tracking for an identified operating constraint.
/// Extends the stateless constraint-engine.ts with persistence and resolution tracking.
model ConstraintResolutionRecord {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String    @map("workspace_id") @db.Uuid
  constraintType         String    @map("constraint_type") // from ConstraintType enum in constraint-engine.ts
  constraintSource       String    @map("constraint_source") // INTERNAL | EXTERNAL
  title                  String
  bindingScore           Float     @map("binding_score") // 0-100
  remediationAction      String?   @map("remediation_action") @db.Text
  status                 String    @default("ACTIVE") // ACTIVE | REMEDIATING | RESOLVED | ACCEPTED
  linkedObjectiveId      String?   @map("linked_objective_id") @db.Uuid
  linkedStartupSessionId String?   @map("linked_startup_session_id") @db.Uuid
  // R7: provenance — distinguishes blueprint-created artifacts from independently-created records
  originBlueprintId      String?   @map("origin_blueprint_id") @db.Uuid
  originType             String?   @map("origin_type") // BLUEPRINT_ARTIFACT | INDEPENDENT
  identifiedAt           DateTime  @default(now()) @map("identified_at")
  resolvedAt             DateTime? @map("resolved_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@index([workspaceId, constraintType])
  @@index([workspaceId, linkedStartupSessionId])
  @@index([workspaceId, originBlueprintId])
  @@map("constraint_resolution_records")
}

/// Structured explainability record for a BOS decision — queryable, auditable.
/// Produced by the Explainability Layer for every material decision.
model ExplainabilityRecord {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  decisionRef     String   @map("decision_ref") // same stable key as DecisionConfidenceRecord
  decisionType    String   @map("decision_type")
  explanationText String   @map("explanation_text") @db.Text
  factorsUsed     Json     @map("factors_used") // array of { factor, value, weight, direction }
  dataPoints      Json     @map("data_points") // array of { metric, value, source }
  confidence      Float
  confidenceLevel String   @map("confidence_level")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([workspaceId, decisionRef])
  @@index([workspaceId, decisionType, createdAt])
  @@map("explainability_records")
}

/// Append-only operating memory entry. Each write creates a new version;
/// the prior version's supersededById is set to the new entry's id.
/// Source-of-truth remains in the originating model; this is a queryable index.
model OperatingMemoryEntry {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  memoryType     String    @map("memory_type") // APPROVAL | DNR | LEARNING | SOP | CONSTRAINT | GOAL_ARBITRATION | RISK | OUTCOME
  sourceModel    String    @map("source_model") // the originating model name, e.g. "OwnerApprovalMemory"
  sourceId       String    @map("source_id") // PK of the source record
  version        Int       @default(1) // monotonically increasing per (workspace, type, source)
  key            String // stable lookup key
  summary        String    @db.Text // human-readable one-liner
  data           Json      @default("{}") // JSON snapshot of relevant fields
  validUntil     DateTime? @map("valid_until") // null = permanent
  supersededById String?   @map("superseded_by_id") @db.Uuid // set when a newer version supersedes this
  supersededAt   DateTime? @map("superseded_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@unique([workspaceId, memoryType, sourceId, version])
  @@index([workspaceId, memoryType])
  @@index([workspaceId, key])
  @@map("operating_memory_entries")
}

/// Owner's explicit override of the system's goal arbitration recommendation.
/// Persisted separately from GoalArbitrationRecord to preserve the system's rationale.
/// The UI must show both the system recommendation and the owner's override.
model OwnerArbitrationOverride {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  actorId             String   @map("actor_id") @db.Uuid
  overriddenRecordId  String   @map("overridden_record_id") @db.Uuid // FK → GoalArbitrationRecord.id
  overrideObjectiveId String?  @map("override_objective_id") @db.Uuid // which objective the owner chose instead
  overrideRationale   String   @map("override_rationale") @db.Text
  decision            String   @default("EXECUTE_NOW") // PortfolioDecision value
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([workspaceId, overriddenRecordId])
  @@index([workspaceId, createdAt])
  @@map("owner_arbitration_overrides")
}

/// Bundle 3.5 — Customer Complaint and Service Recovery.
/// Tracks the full lifecycle from intake through triage, recovery actions, and resolution.
/// Workspace-scoped. SLA is enforced by severity. Business condition re-evaluation is
/// triggered on resolution.
model CustomerComplaint {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  idempotencyKey      String    @map("idempotency_key") // caller-supplied dedup key
  status              String    @default("OPEN")
  // OPEN | TRIAGED | RECOVERING | RESOLVED | CLOSED | REOPENED
  title               String
  description         String    @db.Text
  channel             String    @default("DIRECT") // DIRECT | REFERRAL | ONLINE | PHONE | EMAIL
  severity            String?   // LOW | MEDIUM | HIGH | CRITICAL — set during triage
  slaDueAt            DateTime? @map("sla_due_at") // computed from severity at triage time
  slaBreached         Boolean   @default(false) @map("sla_breach")
  triageNotes         String?   @map("triage_notes") @db.Text // internal only; excluded from public DTO
  resolutionSummary   String?   @map("resolution_summary") @db.Text
  resolutionEvidenceId String?  @map("resolution_evidence_id") @db.Uuid
  businessId          String?   @map("business_id") @db.Uuid
  reportedBy          String?   @map("reported_by") // customer name / identifier (not a user FK)
  createdBy           String    @map("created_by") @db.Uuid // workspace actor
  updatedBy           String?   @map("updated_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  recoveryActions ComplaintRecoveryAction[]

  @@unique([workspaceId, idempotencyKey], map: "customer_complaints_workspace_idem")
  @@index([workspaceId, status])
  @@index([workspaceId, severity])
  @@index([workspaceId, slaDueAt])
  @@index([workspaceId, slaBreached])
  @@index([workspaceId, createdAt])
  @@map("customer_complaints")
}

/// Recovery action linked to a complaint. Each action tracks its own completion state.
model ComplaintRecoveryAction {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  complaintId   String    @map("complaint_id") @db.Uuid
  description   String    @db.Text
  assignedTo    String?   @map("assigned_to") // role label or user id
  dueAt         DateTime? @map("due_at")
  completedAt   DateTime? @map("completed_at")
  evidenceNote  String?   @map("evidence_note") @db.Text
  createdBy     String    @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  complaint CustomerComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([workspaceId, complaintId])
  @@index([workspaceId, completedAt])
  @@map("complaint_recovery_actions")
}

model OwnerActionAssignment {
