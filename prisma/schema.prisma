  partialSuccessCondition  String?   @db.Text
  failureCondition         String?   @db.Text
  stopCondition            String?   @db.Text
  escalationCondition      String?   @db.Text
  riskLevel                String    @default("standard") // low | standard | high | critical
  isProvisional            Boolean   @default(false)
  reviewAt                 DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  workspace                ClientAccount @relation("WorkspaceValidationCriteria", fields: [workspaceId], references: [id])

