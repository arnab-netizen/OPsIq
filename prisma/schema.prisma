  verificationMetric String?              @map("verification_metric")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  business           OwnerBusiness        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cycle              OwnerFinanceCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  actions            OwnerFinanceAction[]

  @@index([workspaceId])
  @@index([businessId])
  @@index([cycleId])
  @@index([code])
  @@index([severity])
