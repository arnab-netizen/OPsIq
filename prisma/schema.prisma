  workspaceId            String          @db.Uuid @map("workspace_id")
  periodStart            DateTime        @map("period_start")
  periodEnd              DateTime        @map("period_end")
  currency               String
  revenue                Float?
  totalCosts             Float?          @map("total_costs")
  grossProfit            Float?          @map("gross_profit")
  netProfit              Float?          @map("net_profit")
  orderCount             Float?          @map("order_count")
  kgProcessed            Float?          @map("kg_processed")
  piecesProcessed        Float?          @map("pieces_processed")
  b2cRevenue             Float?          @map("b2c_revenue")
  b2bRevenue             Float?          @map("b2b_revenue")
  newCustomers           Float?          @map("new_customers")
  repeatCustomers        Float?          @map("repeat_customers")
  dormantContacted       Float?          @map("dormant_contacted")
  averageOrderValue      Float?          @map("average_order_value")
  discountAmount         Float?          @map("discount_amount")
  refundAmount           Float?          @map("refund_amount")
  rewashCount            Float?          @map("rewash_count")
  complaintCount         Float?          @map("complaint_count")
  receivables            Float?
  staffCost              Float?          @map("staff_cost")
  rentCost               Float?          @map("rent_cost")
  utilitiesCost          Float?          @map("utilities_cost")
  materialCost           Float?          @map("material_cost")
  deliveryCost           Float?          @map("delivery_cost")
  marketingSpend         Float?          @map("marketing_spend")
  campaignConversions    Float?          @map("campaign_conversions")
