generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// Stub models to allow compilation when DATABASE_URL unavailable
// These are placeholders for actual schema that will be defined via migrations
// when DATABASE_URL becomes available

model User {
  id String @id
  email String? @unique
  name String?
  createdAt DateTime?
  updatedAt DateTime?
}

model Workspace {
  id String @id
  slug String? @unique
  name String?
  createdBy String?
  createdAt DateTime?
  updatedAt DateTime?
}

model WorkspaceMembership {
  workspaceId String
  userId      String
  role String?
  createdAt DateTime?

  @@id([workspaceId, userId])
}

model ClientAccount {
  id String @id
  name String?
  createdAt DateTime?
  updatedAt DateTime?
}

model Engagement {
  id String @id
  code String? @unique
  name String?
  createdAt DateTime?
  updatedAt DateTime?
}

model EngagementMembership {
  userId      String
  engagementId String
  role String?
  createdAt DateTime?

  @@id([userId, engagementId])
}

model AuditEvent {
  id String @id
  eventName String?
  actorId String?
  actorType String?
  entityType String?
  entityId String?
  payload Json?
  correlationId String?
  visibility String?
  occurredAt DateTime?
  createdAt DateTime?
}

model UserRoleAssignment {
  id String @id
  role String?
  scope String?
  scopeId String?
  createdAt DateTime?
}

model Recommendation {
  id String @id
  workspaceId String
  engagementId String
  title String?
  description String?
  priority String?
  createdBy String?
  status String?
  createdAt DateTime?
  updatedAt DateTime?

  @@index([workspaceId])
  @@index([engagementId])
}

model Action {
  id String @id
  createdAt DateTime?
}

model LearningRecord {
  id String @id
  success Boolean?
  problemType String?
  impact String?
  createdAt DateTime?
}

model OperatorItem {
  id String @id
  createdAt DateTime?
}

model CanonicalEvent {
  id String @id
  aggregateId String
  aggregateType String
  eventType String
  eventVersion Int
  eventNumber Int
  payload Json?
  actorId String?
  workspaceId String
  causationId String?
  correlationId String?
  idempotencyKey String? @unique
  visibilityScope String?
  sensitivityClassification String?
  occurredAt DateTime?
  recordedAt DateTime?
  checksum String?
  createdAt DateTime?

  @@index([aggregateId])
  @@index([aggregateType])
  @@index([workspaceId])
  @@index([eventNumber])
  @@unique([workspaceId, aggregateId, eventNumber])
}

model SnapshotData {
  id String @id
  aggregateId String
  aggregateType String
  workspaceId String
  eventNumber Int
  data Json?
  checksum String?
  createdAt DateTime?
  updatedAt DateTime?

  @@index([aggregateId])
  @@index([workspaceId])
  @@unique([workspaceId, aggregateId])
}
