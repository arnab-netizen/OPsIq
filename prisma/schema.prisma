  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @default(now()) @map("updated_at")

  @@index([workspaceId, status])
  @@index([workspaceId, assignedUserId])
  @@map("delegated_tasks")
}

/// Module 1 — persisted governance BusinessImpactAssessment for a recommendation.
/// Additive, workspace-scoped, no FK (mirrors DelegatedTask). The full composed
/// assessment is stored as JSON; lean_classification + evidence_confidence are
/// extracted for queryability. One assessment per (workspace, recommendation).
model RecommendationBusinessImpact {
  id                 String   @id @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  recommendationId   String   @map("recommendation_id") @db.Uuid
  leanClassification String   @map("lean_classification")
  evidenceConfidence String   @map("evidence_confidence")
  assessment         Json
  createdByUserId    String?  @map("created_by_user_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([workspaceId, recommendationId])
  @@index([workspaceId])
  @@map("recommendation_business_impacts")
}

/// Module 6 — persisted per-service/segment unit economics (computed via the
