  conflictFlags Json     @map("conflict_flags") // string[]
  staleFields   Json     @map("stale_fields") // string[]
  assessedAt    DateTime @default(now()) @map("assessed_at")
  assessedBy    String   @map("assessed_by") // "InputQualityService"
