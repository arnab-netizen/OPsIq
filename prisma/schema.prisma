// ─────────────────────────────────────────────────────────────────────────────
// Capability 13 — Startup / New Business Mode
// Persists startup validation sessions and per-idea evaluation results.
// Workspace-scoped. Ideas are Cascade-deleted with their session.
// ─────────────────────────────────────────────────────────────────────────────

/// A persisted startup validation session — full lifecycle from DRAFT through EXECUTION_PLANNED.
/// Status: DRAFT | CONTEXT_CAPTURE | DISCOVERY | IDEA_GENERATION | SCREENING |
///   VALIDATION_PLANNED | VALIDATION_IN_PROGRESS | ECONOMICS_REVIEW | READINESS_REVIEW |
///   OWNER_DECISION_REQUIRED | APPROVED | MODIFICATION_REQUIRED | ON_HOLD | REJECTED |
///   EXECUTION_PLANNED | STALE_REAPPROVAL_REQUIRED | ACTIVE (legacy)
model OwnerStartupSession {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId             String   @map("workspace_id") @db.Uuid
  actorId                 String   @map("actor_id") @db.Uuid
  sessionLabel            String?  @map("session_label")
  sessionPurpose          String?  @map("session_purpose")
  entryPath               String   @default("HAVE_IDEA") @map("entry_path") // HAVE_IDEA | NEED_OPTIONS
  intake                  Json
  status                  String   @default("DRAFT")
  profileVersion          Int      @default(0) @map("profile_version")
  currentProfileVersionId String?  @map("current_profile_version_id") @db.Uuid
  currentSystemRecId      String?  @map("current_system_rec_id") @db.Uuid
  currentOwnerDecisionId  String?  @map("current_owner_decision_id") @db.Uuid
  currentBlueprintId      String?  @map("current_blueprint_id") @db.Uuid
  /// Full StartupValidationResult persisted as JSON (legacy).
  validationResult        Json?    @map("validation_result")
  /// Name of the recommended idea (or null when none qualified).
  recommendedName         String?  @map("recommended_name")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  ideas                 StartupIdeaRecord[]
  profileVersions       StartupContextProfileVersion[]
  hypotheses            StartupHypothesis[]
  evidenceRecords       StartupEvidenceRecord[]
  validationPlans       StartupValidationPlan[]
  businessModelVersions StartupBusinessModelVersion[]
  economicModels        StartupEconomicModel[]
  marketSizings         StartupMarketSizing[]
  readinessAssessments  StartupReadinessAssessment[]
  systemRecommendations StartupSystemRecommendation[]
  ownerDecisions        StartupOwnerDecision[]
  researchPlan          StartupResearchPlan?
  executionBlueprints   StartupExecutionBlueprint[]
  initiatives           StartupInitiative[]
  ideaGenerationBatches StartupIdeaGenerationBatch[]

  @@index([workspaceId, status])
  @@map("owner_startup_session")
}

/// Immutable versioned snapshot of the owner's business-fit profile.
/// Each update increments the version; old versions are never overwritten.
model StartupContextProfileVersion {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String    @map("workspace_id") @db.Uuid
  sessionId       String    @map("session_id") @db.Uuid
  actorId         String    @map("actor_id") @db.Uuid
