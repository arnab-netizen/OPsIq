  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, scope])
  @@index([workspaceId, businessId])
  @@map("owner_standing_instruction")
}

/// Stage 3 Slice 3.2 — owner-scoped, workspace-isolated in-app alert.
/// Persists business condition, risk, and execution alerts for owner acknowledgement.
model Alert {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  type           String
  channel        String    @default("in_app")
  message        String
  entityType     String?   @map("entity_type")
  entityId       String?   @map("entity_id") @db.Uuid
  severity       String    @default("medium")
  idempotencyKey String?   @map("idempotency_key")
  isRead         Boolean   @default(false) @map("is_read")
  readAt         DateTime? @map("read_at")
  resolvedAt     DateTime? @map("resolved_at")
