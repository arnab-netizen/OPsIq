// ─────────────────────────────────────────────────────────────────────────────
// Founder / Owner-Only Real-Business Recovery Mode
// Self-contained models (relations only among themselves). Workspace isolation
// is enforced at the service layer via the workspace_id scalar. These models
// intentionally do NOT reuse the broken Action/verification primitives.
// ─────────────────────────────────────────────────────────────────────────────

model OwnerBusiness {
  id             String                @id @db.Uuid
  workspaceId    String                @db.Uuid @map("workspace_id")
  name           String
  businessType   String                @map("business_type")
  location       String?
  currency       String                @default("INR")
  operatingModel String?               @map("operating_model")
  b2cSupported   Boolean               @default(true) @map("b2c_supported")
  b2bSupported   Boolean               @default(false) @map("b2b_supported")
  isActive       Boolean               @default(true) @map("is_active")
  createdBy      String?               @db.Uuid @map("created_by")
  version        Int                   @default(1)
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  snapshots      OwnerMetricSnapshot[]
  cycles         RecoveryCycle[]
  financeSnapshots     OwnerFinancialSnapshot[]
  financeCycles        OwnerFinanceCycle[]
  financeFindings      OwnerFinanceFinding[]
  financeActions       OwnerFinanceAction[]
  financeVerifications OwnerFinanceVerification[]
  cashflowSnapshots     OwnerCashflowSnapshot[]
  cashflowCycles        OwnerCashflowCycle[]
  cashflowFindings      OwnerCashflowFinding[]
  cashflowActions       OwnerCashflowAction[]
  cashflowVerifications OwnerCashflowVerification[]
  salesSnapshots     OwnerSalesSnapshot[]
  salesCycles        OwnerSalesCycle[]
  salesFindings      OwnerSalesFinding[]
  salesActions       OwnerSalesAction[]
  salesVerifications OwnerSalesVerification[]
  operationsSnapshots     OwnerOperationsSnapshot[]
  operationsCycles        OwnerOperationsCycle[]
  operationsFindings      OwnerOperationsFinding[]
  operationsActions       OwnerOperationsAction[]
  operationsVerifications OwnerOperationsVerification[]
  sopSnapshots            OwnerSopSnapshot[]
  sopCycles               OwnerSopCycle[]
  sopFindings             OwnerSopFinding[]
  sopActions              OwnerSopAction[]
  sopVerifications        OwnerSopVerification[]
  marketingSnapshots     OwnerMarketingSnapshot[]
  marketingCycles        OwnerMarketingCycle[]
  marketingFindings      OwnerMarketingFinding[]
  marketingActions       OwnerMarketingAction[]
  marketingVerifications OwnerMarketingVerification[]
  strategySnapshots     OwnerStrategySnapshot[]
  strategyCycles        OwnerStrategyCycle[]
  strategyFindings      OwnerStrategyFinding[]
  strategyActions       OwnerStrategyAction[]
  strategyVerifications OwnerStrategyVerification[]
  dataIntakes           OwnerDataIntake[]

  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@map("owner_businesses")
}

model OwnerMetricSnapshot {
  id                     String          @id @db.Uuid
