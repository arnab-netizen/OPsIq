  @@index([inputRecordId])
  @@index([qualityStatus])
  @@index([workspaceId, assessedAt])
  @@map("owner_input_quality_assessments")
}

// ─── Owner Mode Reality Loop — Phase 6: Diagnosis Evidence Contract ───────────

// ─── Owner Mode Reality Loop — Phase 7: Structured Recommendation Tracking ────

model OwnerActionOutcome {
  id                         String        @id @default(cuid())
  workspaceId                String        @db.Uuid
  businessId                 String
  recommendationId           String?
  actionId                   String?
  outcomeStatus              String // worked | partially_worked | did_not_work | made_worse | not_measurable | too_early_to_judge | invalid_test | executed_differently | external_event_interference
  ownerReportedResult        String?       @db.Text
  actualMetricName           String?
  beforeValue                Float?
  afterValue                 Float?
  absoluteChange             Float?
  percentageChange           Float?
  measurementPeriodStart     DateTime?
  measurementPeriodEnd       DateTime?
  evidenceQuality            String? // strong | moderate | weak | anecdotal | none
  externalEventFlag          Boolean       @default(false)
  externalEventDescription   String?       @db.Text
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  workspace                  ClientAccount @relation("WorkspaceActionOutcomes", fields: [workspaceId], references: [id])
  // Phase 3 — task linkage
  taskKey                    String?       @map("task_key")
  taskType                   String?       @map("task_type") // "process_execution" | "delegated"
  // Phase 3 — verification
  verificationStatus         String?       @map("verification_status") // unverified | observation_window_open | insufficient_evidence | verified | disputed
  verificationClassification String?       @map("verification_classification") // SUCCESS | PARTIAL_SUCCESS | NO_MEASURABLE_IMPACT | FAILURE | NEGATIVE_IMPACT | INCONCLUSIVE | OBSERVATION_WINDOW_OPEN | INSUFFICIENT_EVIDENCE
  verifiedByActorId          String?       @map("verified_by_actor_id") @db.Uuid
  verifiedAt                 DateTime?     @map("verified_at")
  observationWindowDays      Int?          @map("observation_window_days")
  directCost                 Decimal?      @map("direct_cost") @db.Decimal(14, 2)
  sideEffects                String?       @map("side_effects") @db.Text
  verificationNotes          String?       @map("verification_notes") @db.Text
  // Phase 3 — learning linkage
  learningCandidateId        String?       @map("learning_candidate_id")

  @@index([workspaceId])
  @@index([businessId])
  @@index([recommendationId])
  @@index([actionId])
  @@index([outcomeStatus])
  @@index([workspaceId, verificationClassification])
  @@index([workspaceId, taskKey])
  @@map("owner_action_outcomes")
}

model OwnerReassessmentEvent {
  id                            String        @id @default(cuid())
  workspaceId                   String        @db.Uuid
  businessId                    String
  recommendationId              String?
  actionId                      String?
  outcomeId                     String?
  failureAdjudicationId         String?
  causalAttributionId           String?
  harmEventId                   String?
  sourceProofId                 String?       @db.Uuid // proof whose accepted-then-contradicted reversal triggered this reassessment (proof→reassessment linkage)
  trigger                       String // failed_outcome | disputed_outcome | harmful_outcome | external_event_invalidation | execution_invalidation | owner_dispute | evidence_retraction | new_contradicting_evidence
  triggerDescription            String        @db.Text
  status                        String // pending | in_progress | diagnosis_reopened | corrective_action_issued | closed_no_correction_needed | closed_with_correction | blocked_awaiting_human_review
  requiresHumanReview           Boolean
  reopensDiagnosis              Boolean
  assumptionsChecked            Boolean
  invalidatedAssumptions        String        @db.Text // JSON array
  proposedCorrectiveActionClass String? // retry_same_action | modify_action_parameters | switch_action_type | escalate_to_owner | defer_pending_evidence | close_as_external_cause | close_as_invalid_test | reopen_diagnosis
  correctiveActionRationale     String?       @db.Text
  ownerAcknowledged             Boolean
  createdAt                     DateTime      @default(now())
  updatedAt                     DateTime      @updatedAt
  workspace                     ClientAccount @relation("WorkspaceReassessmentEvents", fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([businessId])
  @@index([trigger])
  @@index([status])
  @@index([workspaceId, sourceProofId])
  @@map("owner_reassessment_events")
}

model ControlledLearningCandidate {
  id                     String                                  @id @default(cuid())
  workspaceId            String                                  @db.Uuid
  businessId             String
  sourceRecommendationId String?
  sourceOwnerDecisionId  String
  sourceActionId         String
  sourceOutcomeId        String
  outcomeRecordedAt      DateTime? // server-side outcome window anchor (HIGH-3); null = window unverifiable
  eligibilityStatus      String
  rejectionReasons       String                                  @db.Text
  evidenceSourceType     String
  evidenceSummary        String                                  @db.Text
  humanReviewed          Boolean                                 @default(false)
  reviewerId             String?
  promotionLocked        Boolean                                 @default(false)
  promotedAt             DateTime?
  auditFingerprint       String
  metadata               String                                  @db.Text
  createdAt              DateTime                                @default(now())
  updatedAt              DateTime                                @updatedAt
  workspace              ClientAccount                           @relation("WorkspaceControlledLearningCandidates", fields: [workspaceId], references: [id])
  auditEntries           ControlledLearningCandidateAuditEntry[]
  reviews                ControlledLearningReview[]
  admissions             ControlledLearningAdmission[]
  rejections             ControlledLearningRejection[]
  privacyControls        ControlledLearningPrivacyControl[]
  consentRecords         ControlledLearningConsentRecord[]
  regressionResults      ControlledLearningRegressionResult[]
  rolloutFlags           ControlledLearningRolloutFlag[]
  rollbackEvents         ControlledLearningRollbackEvent[]
  harmEvents             ControlledLearningHarmEvent[]
  attributionReviews     ControlledLearningAttributionReview[]

  @@unique([workspaceId, auditFingerprint])
  @@index([workspaceId])
  @@index([businessId])
  @@index([eligibilityStatus])
  @@index([promotionLocked])
