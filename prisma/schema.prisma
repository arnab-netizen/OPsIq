  UPLOAD
  INTEGRATION
  EXTERNAL
}

enum evidence_category {
  FINANCIAL
  OPERATIONAL
  HUMAN
  RESILIENCE
  CLIENT
  COMMERCIAL
  LEADERSHIP
  EXECUTION
}

enum evidence_source_type {
  PERSON
  DOCUMENT
  SYSTEM
  REPORT
}

enum evidence_traceability_status {
  COMPLETE
  PARTIAL
  MISSING
}

enum evidence_type {
  FREE_TEXT
  DOCUMENT
  INTERVIEW
  METRICS
  SYSTEM
  APPROVAL
}

enum evidence_validation_status {
  PENDING
  VALIDATED
  INVALID
}

enum evidence_visibility {
  INTERNAL
  CLIENT_VISIBLE
  RESTRICTED
}
