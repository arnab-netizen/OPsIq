  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, staffRef])
  @@map("owner_training_recommendation")
}

/// Jarvis 360 Slice 5 — SOP document lifecycle. A first-class, versioned, owner-
/// approved SOP/checklist (steps + proof requirements), distinct from the Module-7
/// SOP *diagnosis* (which stays as the measurement layer). A material change forks
/// a new draft version that needs re-approval; stale (past review date) triggers review.
model OwnerSopDocument {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  businessId        String?   @map("business_id") @db.Uuid
  process           String
  role              String?
  title             String
  steps             String[]
  proofRequirements String[]  @map("proof_requirements")
  version           Int       @default(1)
  status            String    @default("draft")
