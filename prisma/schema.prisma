// --- Module 8: Strategy & Scenario Planning ---------------------------------
// The "strategy" decision-support domain. A snapshot is ONE strategic option's
// scenario inputs; a cycle is its scored evaluation. Mirrors the proven
// sales/marketing persistence shape. Additive only.

model OwnerStrategySnapshot {
  id                    String                @id @db.Uuid
  workspaceId           String                @db.Uuid @map("workspace_id")
  businessId            String                @db.Uuid @map("business_id")
  periodStart           DateTime              @map("period_start")
  periodEnd             DateTime              @map("period_end")
  currency              String
  businessModelType     String?               @map("business_model_type")
  industryTemplate      String?               @map("industry_template")
  optionName            String?               @map("option_name")
  currentRevenue        Float?                @map("current_revenue")
  expectedRevenueChange Float?                @map("expected_revenue_change")
  costChange            Float?                @map("cost_change")
  investmentRequired    Float?                @map("investment_required")
  timeToImpactMonths    Float?                @map("time_to_impact_months")
  riskLevel             String?               @map("risk_level")
  cashAvailable         Float?                @map("cash_available")
  capacityImpactPct     Float?                @map("capacity_impact_pct")
  staffImpact           Float?                @map("staff_impact")
  notes                 String?
  dataConfidenceScore   Float                 @map("data_confidence_score")
  missingCriticalData   Json                  @map("missing_critical_data")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  business              OwnerBusiness         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cycles                OwnerStrategyCycle[]

  @@unique([businessId, periodStart, periodEnd])
  @@index([workspaceId])
  @@index([businessId])
  @@index([periodEnd])
  @@map("owner_strategy_snapshots")
}

