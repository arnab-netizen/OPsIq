  verificationMetric String           @map("verification_metric")
  createdAt          DateTime         @default(now()) @map("created_at")
  cycle              RecoveryCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  actions            RecoveryAction[]

  @@index([cycleId])
  @@index([workspaceId])
  @@map("recovery_findings")
}

model RecoveryAction {
  id                     String                 @id @db.Uuid
