// Additive models. Cross-aggregate references are plain scalar columns (no
// @relation) to keep existing models untouched, matching the OperatorItem style.

model WorkOrder {
  id              String   @id @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
