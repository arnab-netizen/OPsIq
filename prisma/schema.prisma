// --- Module 10: Connectors & Data Intake ------------------------------------
// One uploaded/imported intake record per business. Additive only. Stores the
// deterministic intake candidate (source, statuses, normalized records, error
// report) and the owner-confirmation flag — connector data never feeds a diagnosis
// until the owner confirms (execution.md §17).

model OwnerDataIntake {
  id                  String             @id @db.Uuid
  workspaceId         String             @map("workspace_id") @db.Uuid
  businessId          String             @map("business_id") @db.Uuid
  source              String
  targetDomain        String?            @map("target_domain")
  rowCount            Int                @map("row_count")
  validationStatus    String             @map("validation_status")
  normalizationStatus String             @map("normalization_status")
  mappedFields        Json               @map("mapped_fields")
  unmappedColumns     Json               @map("unmapped_columns")
  records             Json
  errorReport         Json               @map("error_report")
  ownerConfirmed      Boolean            @default(false) @map("owner_confirmed")
  confirmedAt         DateTime?          @map("confirmed_at")
  confirmedBy         String?            @map("confirmed_by") @db.Uuid
  notes               String?
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  business            OwnerBusiness      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviewActions       FactReviewAction[]

  @@index([workspaceId])
  @@index([businessId])
  @@index([source])
  @@index([validationStatus])
  @@index([ownerConfirmed])
  @@map("owner_data_intakes")
}

model FactReviewAction {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intakeId         String          @map("intake_id") @db.Uuid
  factId           String          @map("fact_id")
  action           String          @map("action") // "approved" | "corrected" | "rejected" | "marked_unknown"
  previousValue    Json?           @map("previous_value")
  newValue         Json?           @map("new_value")
  correctionReason String?         @map("correction_reason")
  actorId          String          @map("actor_id") @db.Uuid
  workspaceId      String          @map("workspace_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  intake           OwnerDataIntake @relation(fields: [intakeId], references: [id], onDelete: Cascade)

  @@index([intakeId])
  @@index([factId])
  @@index([workspaceId, intakeId])
  @@index([action])
  @@map("fact_review_actions")
}

// B12: External Systems Connector Layer — Export Imports
// Handles CRM/accounting/POS/marketing exports (CSV/XLSX) from providers like HubSpot, Salesforce, Zoho, QuickBooks

model ExternalProvider {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String                   @db.VarChar(100)
  category              String                   @db.VarChar(50) // "CRM", "accounting", "POS", "ads"
  isActive              Boolean                  @default(true) @map("is_active")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  templates             ExternalImportTemplate[]
  rawRecords            ExternalRawRecord[]
  connections           ExternalConnection[]
  browserImportSessions BrowserImportSession[]

  @@map("external_providers")
}

model ExternalImportTemplate {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerId        String                 @map("provider_id") @db.Uuid
  workspaceId       String                 @map("workspace_id") @db.Uuid
  templateName      String                 @map("template_name") @db.VarChar(255)
  description       String?
  expectedColumns   String[]               @map("expected_columns") // CSV header columns
  requiredColumns   String[]               @map("required_columns")
  fieldMappings     Json                   @map("field_mappings") // { "csv_col": { "target": "...", "type": "..." } }
  isTemplate        Boolean                @default(true) @map("is_template")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  provider          ExternalProvider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  rawRecords        ExternalRawRecord[]
  fieldMappings_rel ExternalFieldMapping[]

  @@index([workspaceId])
  @@index([providerId])
  @@map("external_import_templates")
}

model ExternalRawRecord {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String                 @map("workspace_id") @db.Uuid
  engagementId String                 @map("engagement_id") @db.Uuid
  providerId   String                 @map("provider_id") @db.Uuid
  templateId   String                 @map("template_id") @db.Uuid
  rawData      Json                   @map("raw_data") // Original record from CSV/import
  parsedData   Json?                  @map("parsed_data") // After parsing/normalization
  factId       String?                @map("fact_id") @db.VarChar(255) // Links to business fact
  status       String                 @default("pending") // pending|processed|failed|approved
  errorMessage String?                @map("error_message")
  createdAt    DateTime               @default(now()) @map("created_at")
  updatedAt    DateTime               @updatedAt @map("updated_at")
  provider     ExternalProvider       @relation(fields: [providerId], references: [id])
  template     ExternalImportTemplate @relation(fields: [templateId], references: [id])
  lineage      ExternalDataLineage[]

  @@index([workspaceId])
  @@index([engagementId])
  @@index([providerId])
  @@index([status])
  @@index([factId])
  @@map("external_raw_records")
}

model ExternalFieldMapping {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId         String                 @map("template_id") @db.Uuid
  sourceField        String                 @map("source_field") @db.VarChar(255) // Field from provider export
  targetField        String                 @map("target_field") @db.VarChar(255) // Field in business fact
  transformationRule Json?                  @map("transformation_rule") // { "type": "multiply", "factor": 1000 }
  confidence         Decimal                @default(0.80) // 0.0-1.0
  createdAt          DateTime               @default(now()) @map("created_at")
  template           ExternalImportTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("external_field_mappings")
}

model ExternalDataLineage {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String            @map("workspace_id") @db.Uuid
  sourceRecordId    String            @map("source_record_id") @db.Uuid
  processedRecordId String?           @map("processed_record_id") @db.Uuid
  factId            String?           @map("fact_id") @db.VarChar(255)
  lineageChain      String[]          @map("lineage_chain") // ["import:provider", "normalize", "map:template"]
  createdAt         DateTime          @default(now()) @map("created_at")
  sourceRecord      ExternalRawRecord @relation(fields: [sourceRecordId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sourceRecordId])
  @@index([factId])
  @@map("external_data_lineage")
}

// B13: OAuth Connection Management
model ExternalConnection {
  id               String    @id
  workspaceId      String    @map("workspace_id") @db.Uuid
  providerId       String    @map("provider_id") @db.Uuid
  connectionName   String    @map("connection_name")
  status           String    @default("active") // "active" | "revoked" | "expired" | "error"
  lastSyncAt       DateTime? @map("last_sync_at")
  lastErrorAt      DateTime? @map("last_error_at")
  lastErrorMessage String?   @map("last_error_message")
  oauthScope       String[]  @map("oauth_scope")
  disconnectToken  String?   @map("disconnect_token") // token used for revocation
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workspace Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider  ExternalProvider            @relation(fields: [providerId], references: [id], onDelete: Restrict)
  token     ExternalOAuthToken?
  consents  ExternalConnectionConsent[]
  syncJobs  ExternalSyncJob[]

  @@unique([workspaceId, providerId])
  @@index([workspaceId])
  @@index([status])
  @@map("external_connections")
}

// B13: Encrypted OAuth Tokens
model ExternalOAuthToken {
  id           String    @id
  connectionId String    @unique @map("connection_id")
  accessToken  String    @map("access_token") // encrypted at rest
  refreshToken String?   @map("refresh_token") // encrypted at rest
  expiresAt    DateTime? @map("expires_at")
  tokenType    String    @default("Bearer") @map("token_type")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  connection ExternalConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@map("external_oauth_tokens")
}

// B13: User Consent Tracking
model ExternalConnectionConsent {
  id           String   @id
  workspaceId  String   @map("workspace_id") @db.Uuid
