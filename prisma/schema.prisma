  hashChecksum String   @map("hash_checksum") @db.VarChar(64)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  workspace          ClientAccount                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  qualityAssessments OwnerInputQualityAssessment[]

  @@index([workspaceId])
  @@index([workspaceId, inputPeriod])
  @@index([submittedBy])
  @@index([createdAt])
  @@map("owner_input_records")
}

model OwnerInputQualityAssessment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String   @map("workspace_id") @db.Uuid
  inputRecordId String   @map("input_record_id") @db.Uuid
  qualityStatus String   @map("quality_status")
  // complete | partial | data_limited | critical_missing | conflicting
  // | stale | owner_estimate_only | unsafe_for_strong_recommendation
