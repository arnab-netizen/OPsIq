  @@index([processedAt], map: "idx_webhook_events_processed_at")
  @@index([status], map: "idx_webhook_events_status")
  @@index([status, attempts], map: "idx_webhook_events_status_attempts")
  @@index([stripeEventId], map: "idx_webhook_events_stripe_event_id")
  @@index([stripeTimestamp], map: "idx_webhook_events_stripe_timestamp")
  @@index([type], map: "idx_webhook_events_type")
  @@map("webhook_events")
}

model WorkspaceMembership {
