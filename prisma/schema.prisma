/// Jarvis 360 Slice 4 — owner approval memory. Records an owner's approval of a
/// content-hashed decision/rule so it can be reused WITHOUT re-asking, but only
/// when workspace + scope + content hash match and the requested risk is the same
/// or lower. A material change (different content hash) forces re-approval.
model OwnerApprovalMemory {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId            String    @map("workspace_id") @db.Uuid
  scope                  String
  contentHash            String    @map("content_hash")
  version                Int       @default(1)
  riskClass              String    @map("risk_class")
  approvalStatus         String    @default("approved") @map("approval_status")
  approvedByUserId       String    @map("approved_by_user_id") @db.Uuid
  validUntil             DateTime? @map("valid_until")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  // Phase 3 — task binding for explicit per-task revocation
  taskKey                String?   @map("task_key")
  processExecutionTaskId String?   @map("process_execution_task_id") @db.Uuid
  materialParameters     Json?     @map("material_parameters")

  @@unique([workspaceId, scope, contentHash])
  @@index([workspaceId, scope])
  @@map("owner_approval_memory")
}

/// Jarvis 360 Slice 4 — owner standing instruction. An owner-defined rule that
/// auto-allows or forbids a class of actions within a scope (and optional amount
/// ceiling), so routine actions need not be re-approved.
/// Jarvis 360 Slice 14 — compliance item (licence/permit/insurance/tax) with expiry,
/// so OpsIQ can flag professional-review boundaries without giving definitive advice.
model OwnerComplianceItem {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String    @map("workspace_id") @db.Uuid
  businessId           String?   @map("business_id") @db.Uuid
  kind                 String
  name                 String
  reference            String?
  expiresAt            DateTime? @map("expires_at")
  /// Managed status: active | evidence_pending | review_pending | compliant | breached | waived
  /// Temporal states (upcoming/overdue/action_required) are computed from expiresAt.
  status               String    @default("active")
  createdByUserId      String    @map("created_by_user_id") @db.Uuid
  /// Where this obligation applies (e.g. "England and Wales", "UK", "Federal").
  jurisdiction         String?
  /// The specific law, regulation, or contract clause that creates this obligation.
  legalBasis           String?   @map("legal_basis")
  /// Who inside the business is responsible for maintaining this obligation.
  obligationOwner      String?   @map("obligation_owner")
  /// How many days the evidence/certificate is valid after issue.
  evidenceValidityDays Int?      @map("evidence_validity_days")
  /// Recurrence period in months (null = one-off).
  recurrenceMonths     Int?      @map("recurrence_months")
  /// Consequence of non-compliance (description, NOT legal advice).
  penaltyDescription   String?   @map("penalty_description")
  /// Provenance: "owner_input" | "professional_input" | "authoritative_document".
  provenanceSource     String?   @map("provenance_source")
  /// When this item was last formally reviewed.
  reviewedAt           DateTime? @map("reviewed_at")
  /// Who performed the last formal review.
  reviewedBy           String?   @map("reviewed_by") @db.Uuid
  /// Notes from the last review action.
  complianceNotes      String?   @map("compliance_notes") @db.Text
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  taskLinks ComplianceTaskLink[]

  @@index([workspaceId, kind])
  @@index([workspaceId, status])
  @@map("owner_compliance_item")
}

/// Bundle 3.4 — Compliance ↔ Task linkage. One obligation may have many remediation/evidence tasks.
/// Workspace-scoped with duplicate-prevention via unique(workspaceId, complianceItemId, taskId).
model ComplianceTaskLink {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  complianceItemId String   @map("compliance_item_id") @db.Uuid
  taskId           String   @map("task_id") @db.Uuid
  linkType         String   @default("REMEDIATION") @map("link_type") // REMEDIATION | EVIDENCE
  linkedBy         String   @map("linked_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  complianceItem OwnerComplianceItem @relation(fields: [complianceItemId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, complianceItemId, taskId], map: "compliance_task_links_workspace_pair")
  @@index([workspaceId, complianceItemId], map: "ctl_compliance_idx")
  @@index([workspaceId, taskId], map: "ctl_task_idx")
  @@map("compliance_task_links")
}

/// Jarvis 360 Slice 12 — do-not-repeat rule. A dedicated, fully-migrated store for
/// "do not repeat this" rules keyed by a deterministic memory key (e.g. finding code),
/// checked at recommendation promotion. (Self-contained — does not depend on the
/// schema-only OwnerDecisionMemory model, which has no creating migration.)
model OwnerDoNotRepeatRule {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId               String   @map("workspace_id") @db.Uuid
  businessId                String?  @map("business_id") @db.Uuid
  memoryKey                 String   @map("memory_key")
  summary                   String
  reason                    String
  blocksRepetition          Boolean  @default(true) @map("blocks_repetition")
  changedContextExplanation String?  @map("changed_context_explanation")
  recommendationId          String?  @map("recommendation_id") @db.Uuid
  active                    Boolean  @default(true)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, memoryKey])
  @@map("owner_do_not_repeat_rule")
}

/// Jarvis 360 Slice 13 — OpsIQ self-evaluation. Records whether a recommendation/
/// action worked, and when it failed, why (closing the modeled-but-open loop).
model OwnerSelfEvaluation {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String    @map("workspace_id") @db.Uuid
  recommendationId     String?   @map("recommendation_id") @db.Uuid
  actionId             String?   @map("action_id") @db.Uuid
  expectedOutcome      String    @map("expected_outcome")
  actualOutcome        String?   @map("actual_outcome")
  result               String
  failureReason        String?   @map("failure_reason")
  ownerWorkloadImpact  String?   @map("owner_workload_impact")
  reassessmentRequired Boolean   @default(false) @map("reassessment_required")
  nextReassessmentAt   DateTime? @map("next_reassessment_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, result])
  @@map("owner_self_evaluation")
}

/// Jarvis 360 Slice 8 — process inventory + review. Each process has an owner role,
/// a linked SOP, a metric/target, and a review cadence; reviews fire on schedule or
/// on a failure signal so processes become living controls.
model OwnerProcess {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  businessId          String?   @map("business_id") @db.Uuid
  name                String
  processType         String    @map("process_type")
  ownerRole           String    @map("owner_role")
  sopId               String?   @map("sop_id") @db.Uuid
  metric              String
  target              String?
  reviewFrequencyDays Int       @default(30) @map("review_frequency_days")
  lastReviewAt        DateTime? @map("last_review_at")
  nextReviewAt        DateTime? @map("next_review_at")
  status              String    @default("active")
  createdByUserId     String    @map("created_by_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, processType])
  @@map("owner_process")
}

/// Jarvis 360 Slice 7 — equipment / capacity / maintenance. Minimal rated/practical
/// capacity + utilization + maintenance/downtime so growth decisions can be gated.
model OwnerEquipment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
