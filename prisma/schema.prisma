/// Jarvis 360 Slice 4 — owner approval memory. Records an owner's approval of a
/// content-hashed decision/rule so it can be reused WITHOUT re-asking, but only
/// when workspace + scope + content hash match and the requested risk is the same
/// or lower. A material change (different content hash) forces re-approval.
model OwnerApprovalMemory {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  scope            String
  contentHash      String    @map("content_hash")
  version          Int       @default(1)
  riskClass        String    @map("risk_class")
  approvalStatus   String    @default("approved") @map("approval_status")
  approvedByUserId String    @map("approved_by_user_id") @db.Uuid
  validUntil       DateTime? @map("valid_until")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, scope, contentHash])
  @@index([workspaceId, scope])
  @@map("owner_approval_memory")
}

/// Jarvis 360 Slice 4 — owner standing instruction. An owner-defined rule that
/// auto-allows or forbids a class of actions within a scope (and optional amount
/// ceiling), so routine actions need not be re-approved.
/// Jarvis 360 Slice 14 — compliance item (licence/permit/insurance/tax) with expiry,
/// so OpsIQ can flag professional-review boundaries without giving definitive advice.
model OwnerComplianceItem {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  businessId  String?   @map("business_id") @db.Uuid
  kind        String
  name        String
  reference   String?
  expiresAt   DateTime? @map("expires_at")
  status      String    @default("active")
  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, kind])
  @@map("owner_compliance_item")
}

/// Jarvis 360 Slice 12 — do-not-repeat rule. A dedicated, fully-migrated store for
/// "do not repeat this" rules keyed by a deterministic memory key (e.g. finding code),
/// checked at recommendation promotion. (Self-contained — does not depend on the
/// schema-only OwnerDecisionMemory model, which has no creating migration.)
model OwnerDoNotRepeatRule {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId               String   @map("workspace_id") @db.Uuid
  businessId                String?  @map("business_id") @db.Uuid
  memoryKey                 String   @map("memory_key")
  summary                   String
  reason                    String
  blocksRepetition          Boolean  @default(true) @map("blocks_repetition")
  changedContextExplanation String?  @map("changed_context_explanation")
  recommendationId          String?  @map("recommendation_id") @db.Uuid
  active                    Boolean  @default(true)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, memoryKey])
  @@map("owner_do_not_repeat_rule")
}

/// Jarvis 360 Slice 13 — OpsIQ self-evaluation. Records whether a recommendation/
/// action worked, and when it failed, why (closing the modeled-but-open loop).
model OwnerSelfEvaluation {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String    @map("workspace_id") @db.Uuid
  recommendationId     String?   @map("recommendation_id") @db.Uuid
  actionId             String?   @map("action_id") @db.Uuid
  expectedOutcome      String    @map("expected_outcome")
  actualOutcome        String?   @map("actual_outcome")
  result               String
  failureReason        String?   @map("failure_reason")
  ownerWorkloadImpact  String?   @map("owner_workload_impact")
  reassessmentRequired Boolean   @default(false) @map("reassessment_required")
  nextReassessmentAt   DateTime? @map("next_reassessment_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, result])
  @@map("owner_self_evaluation")
}

/// Jarvis 360 Slice 8 — process inventory + review. Each process has an owner role,
/// a linked SOP, a metric/target, and a review cadence; reviews fire on schedule or
/// on a failure signal so processes become living controls.
model OwnerProcess {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  businessId          String?   @map("business_id") @db.Uuid
  name                String
  processType         String    @map("process_type")
  ownerRole           String    @map("owner_role")
  sopId               String?   @map("sop_id") @db.Uuid
  metric              String
  target              String?
  reviewFrequencyDays Int       @default(30) @map("review_frequency_days")
  lastReviewAt        DateTime? @map("last_review_at")
  nextReviewAt        DateTime? @map("next_review_at")
  status              String    @default("active")
  createdByUserId     String    @map("created_by_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, processType])
  @@map("owner_process")
}

/// Jarvis 360 Slice 7 — equipment / capacity / maintenance. Minimal rated/practical
/// capacity + utilization + maintenance/downtime so growth decisions can be gated.
model OwnerEquipment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  businessId        String?   @map("business_id") @db.Uuid
  equipmentType     String    @map("equipment_type")
  name              String
  ratedCapacity     Float?    @map("rated_capacity")
  practicalCapacity Float?    @map("practical_capacity")
  unit              String?
  utilization       Float?
  status            String    @default("operational")
  downtimeState     String    @default("up") @map("downtime_state")
  maintenanceDueAt  DateTime? @map("maintenance_due_at")
  operatorSkill     String?   @map("operator_skill")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, businessId])
  @@map("owner_equipment")
}

/// Jarvis 360 Slice 6 — staff skills matrix. Tracks which skills a staff member has
/// proven, the SOP they were trained on, and whether equipment use is authorized.
model OwnerStaffSkill {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  staffRef            String   @map("staff_ref")
  role                String?
  skill               String
  proven              Boolean  @default(false)
  sopId               String?  @map("sop_id") @db.Uuid
  equipmentAuthorized Boolean  @default(false) @map("equipment_authorized")
  lastProvenAt        DateTime? @map("last_proven_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, staffRef, skill])
  @@index([workspaceId, staffRef])
  @@map("owner_staff_skill")
}

/// Jarvis 360 Slice 6 — observed-gap training recommendation. Every recommendation
/// must cite observed evidence (no generic training); effectiveness is rechecked.
model OwnerTrainingRecommendation {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  staffRef            String    @map("staff_ref")
  reasonCode          String    @map("reason_code")
  evidenceRef         String?   @map("evidence_ref")
  processAffected     String    @map("process_affected")
  metric              String
  expectedImprovement String    @map("expected_improvement")
  status              String    @default("recommended")
  proofOfCompletion   String?   @map("proof_of_completion")
  recheckDate         DateTime? @map("recheck_date")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, staffRef])
  @@map("owner_training_recommendation")
}

/// Jarvis 360 Slice 5 — SOP document lifecycle. A first-class, versioned, owner-
/// approved SOP/checklist (steps + proof requirements), distinct from the Module-7
/// SOP *diagnosis* (which stays as the measurement layer). A material change forks
/// a new draft version that needs re-approval; stale (past review date) triggers review.
model OwnerSopDocument {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  businessId        String?   @map("business_id") @db.Uuid
  process           String
  role              String?
  title             String
  steps             String[]
  proofRequirements String[]  @map("proof_requirements")
  version           Int       @default(1)
  status            String    @default("draft")
  contentHash       String    @map("content_hash")
  approvedByUserId  String?   @map("approved_by_user_id") @db.Uuid
  effectiveDate     DateTime? @map("effective_date")
  reviewDate        DateTime? @map("review_date")
  supersedesId      String?   @map("supersedes_id") @db.Uuid
  createdByUserId   String    @map("created_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, process, status])
  @@map("owner_sop_document")
}

model OwnerStandingInstruction {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String    @map("workspace_id") @db.Uuid
  scope                String
  allowedActionTypes   String[]  @map("allowed_action_types")
  forbiddenActionTypes String[]  @map("forbidden_action_types")
  maxAmount            Float?    @map("max_amount")
  riskClass            String    @map("risk_class")
  status               String    @default("active")
  createdByUserId      String    @map("created_by_user_id") @db.Uuid
  validUntil           DateTime? @map("valid_until")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, scope])
  @@map("owner_standing_instruction")
}

/// Jarvis 360 Slice 4 — owner attention event. Records each alert/approval/escalation
/// with its disposition so OpsIQ can protect owner attention and report load saved.
model OwnerAttentionEvent {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String   @map("workspace_id") @db.Uuid
  eventType            String   @map("event_type")
  severity             String
  disposition          String
  ownerDecisionRequired Boolean @default(false) @map("owner_decision_required")
  handledByOpsIQ       Boolean  @default(false) @map("handled_by_opsiq")
  sourceRef            String?  @map("source_ref")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@map("owner_attention_event")
}

model ApprovalRequest {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  operatorItemId   String       @map("operator_item_id") @db.Uuid
  requestedBy      String       @map("requested_by") @db.Uuid
  requestedAt      DateTime     @default(now()) @map("requested_at")
  approverUserId   String       @map("approver_user_id") @db.Uuid
  approvalStatus   String       @default("pending") @map("approval_status")
  approvalDecision String?      @map("approval_decision")
  approvedAt       DateTime?    @map("approved_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  operatorItem     OperatorItem @relation(fields: [operatorItemId], references: [id], onDelete: Cascade)
  requester        User         @relation("approval_requests_requested_by", fields: [requestedBy], references: [id])
  approver         User         @relation("approval_requests_approver", fields: [approverUserId], references: [id])

  @@unique([operatorItemId, approverUserId])
  @@index([approvalStatus])
  @@index([approverUserId, approvalStatus])
  @@index([requestedAt])
  @@map("approval_requests")
}

model AggregateLock {
  aggregateId   String   @id @map("aggregate_id")
  aggregateType String   @map("aggregate_type")
  workspaceId   String   @map("workspace_id") @db.Uuid
  version       Int      @default(0)
  lockedAt      DateTime @default(now()) @map("locked_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([aggregateId, aggregateType, workspaceId])
  @@map("aggregate_locks")
}

model StartupStatus {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status      String // NOT_STARTED | STARTING | READY | FAILED
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")
  error       String?
  version     String // app version that started up
  instanceId  String    @default("unknown") @map("instance_id")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([instanceId])
  @@index([instanceId, updatedAt(sort: Desc)])
  @@map("startup_status")
}

// ─────────────────────────────────────────────────────────────────────────────
// Founder / Owner-Only Real-Business Recovery Mode
// Self-contained models (relations only among themselves). Workspace isolation
// is enforced at the service layer via the workspace_id scalar. These models
// intentionally do NOT reuse the broken Action/verification primitives.
// ─────────────────────────────────────────────────────────────────────────────

model OwnerBusiness {
  id                      String                        @id @db.Uuid
  workspaceId             String                        @map("workspace_id") @db.Uuid
  name                    String
  businessType            String                        @map("business_type")
  location                String?
  currency                String                        @default("INR")
  operatingModel          String?                       @map("operating_model")
  b2cSupported            Boolean                       @default(true) @map("b2c_supported")
  b2bSupported            Boolean                       @default(false) @map("b2b_supported")
  isActive                Boolean                       @default(true) @map("is_active")
  createdBy               String?                       @map("created_by") @db.Uuid
  version                 Int                           @default(1)
  createdAt               DateTime                      @default(now()) @map("created_at")
  updatedAt               DateTime                      @updatedAt @map("updated_at")
  snapshots               OwnerMetricSnapshot[]
  cycles                  RecoveryCycle[]
  financeSnapshots        OwnerFinancialSnapshot[]
  financeCycles           OwnerFinanceCycle[]
  financeFindings         OwnerFinanceFinding[]
  financeActions          OwnerFinanceAction[]
  budgetActions           OwnerBudgetAction[]
  workingCapitalItems     OwnerWorkingCapitalItem[]
  archetypeMetrics        OwnerArchetypeMetric[]
  financeVerifications    OwnerFinanceVerification[]
  cashflowSnapshots       OwnerCashflowSnapshot[]
  cashflowCycles          OwnerCashflowCycle[]
  cashflowFindings        OwnerCashflowFinding[]
  cashflowActions         OwnerCashflowAction[]
  cashflowVerifications   OwnerCashflowVerification[]
  salesSnapshots          OwnerSalesSnapshot[]
  salesCycles             OwnerSalesCycle[]
  salesFindings           OwnerSalesFinding[]
  salesActions            OwnerSalesAction[]
  salesVerifications      OwnerSalesVerification[]
  operationsSnapshots     OwnerOperationsSnapshot[]
  operationsCycles        OwnerOperationsCycle[]
  operationsFindings      OwnerOperationsFinding[]
  operationsActions       OwnerOperationsAction[]
  operationsVerifications OwnerOperationsVerification[]
  sopSnapshots            OwnerSopSnapshot[]
  sopCycles               OwnerSopCycle[]
  sopFindings             OwnerSopFinding[]
  sopActions              OwnerSopAction[]
  sopVerifications        OwnerSopVerification[]
  marketingSnapshots      OwnerMarketingSnapshot[]
  marketingCycles         OwnerMarketingCycle[]
  marketingFindings       OwnerMarketingFinding[]
  marketingActions        OwnerMarketingAction[]
  marketingVerifications  OwnerMarketingVerification[]
  strategySnapshots       OwnerStrategySnapshot[]
  strategyCycles          OwnerStrategyCycle[]
  strategyFindings        OwnerStrategyFinding[]
  strategyActions         OwnerStrategyAction[]
  strategyVerifications   OwnerStrategyVerification[]
  dataIntakes             OwnerDataIntake[]

  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@map("owner_businesses")
}

model OwnerMetricSnapshot {
  id                     String          @id @db.Uuid
  businessId             String          @map("business_id") @db.Uuid
  workspaceId            String          @map("workspace_id") @db.Uuid
  periodStart            DateTime        @map("period_start")
  periodEnd              DateTime        @map("period_end")
  currency               String
  revenue                Float?
  totalCosts             Float?          @map("total_costs")
  grossProfit            Float?          @map("gross_profit")
  netProfit              Float?          @map("net_profit")
  orderCount             Float?          @map("order_count")
  kgProcessed            Float?          @map("kg_processed")
  piecesProcessed        Float?          @map("pieces_processed")
  b2cRevenue             Float?          @map("b2c_revenue")
  b2bRevenue             Float?          @map("b2b_revenue")
  newCustomers           Float?          @map("new_customers")
  repeatCustomers        Float?          @map("repeat_customers")
  dormantContacted       Float?          @map("dormant_contacted")
  averageOrderValue      Float?          @map("average_order_value")
  discountAmount         Float?          @map("discount_amount")
  refundAmount           Float?          @map("refund_amount")
  rewashCount            Float?          @map("rewash_count")
  complaintCount         Float?          @map("complaint_count")
  receivables            Float?
  staffCost              Float?          @map("staff_cost")
  rentCost               Float?          @map("rent_cost")
  utilitiesCost          Float?          @map("utilities_cost")
  materialCost           Float?          @map("material_cost")
  deliveryCost           Float?          @map("delivery_cost")
  marketingSpend         Float?          @map("marketing_spend")
  campaignConversions    Float?          @map("campaign_conversions")
  averageTurnaroundHours Float?          @map("average_turnaround_hours")
  staffProductivity      Float?          @map("staff_productivity")
  notes                  String?
  createdBy              String?         @map("created_by") @db.Uuid
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  business               OwnerBusiness   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cycles                 RecoveryCycle[]

  @@unique([businessId, periodStart, periodEnd])
  @@index([businessId])
  @@index([workspaceId])
  @@map("owner_metric_snapshots")
}

model RecoveryCycle {
  id              String              @id @db.Uuid
  businessId      String              @map("business_id") @db.Uuid
  workspaceId     String              @map("workspace_id") @db.Uuid
  snapshotId      String              @map("snapshot_id") @db.Uuid
  previousCycleId String?             @map("previous_cycle_id") @db.Uuid
  cycleNumber     Int                 @map("cycle_number")
  status          String              @default("open")
  healthStatus    String              @map("health_status")
  healthScore     Float               @map("health_score")
  summary         String?
  createdBy       String?             @map("created_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  business        OwnerBusiness       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  snapshot        OwnerMetricSnapshot @relation(fields: [snapshotId], references: [id])
  previousCycle   RecoveryCycle?      @relation("CycleHistory", fields: [previousCycleId], references: [id])
  nextCycles      RecoveryCycle[]     @relation("CycleHistory")
  findings        RecoveryFinding[]
  actions         RecoveryAction[]

  @@index([businessId])
  @@index([workspaceId])
  @@map("recovery_cycles")
}

model RecoveryFinding {
  id                 String           @id @db.Uuid
  cycleId            String           @map("cycle_id") @db.Uuid
  businessId         String           @map("business_id") @db.Uuid
  workspaceId        String           @map("workspace_id") @db.Uuid
  code               String
  title              String
  sourceMetric       String           @map("source_metric")
  currentValue       Float?           @map("current_value")
  comparisonValue    Float?           @map("comparison_value")
  threshold          Float?
  severity           String
  evidence           String
  whyItMatters       String           @map("why_it_matters")
  impactEstimate     Float?           @map("impact_estimate")
  impactCurrency     String?          @map("impact_currency")
  confidence         Float
  recommendedAction  String           @map("recommended_action")
  verificationMetric String           @map("verification_metric")
  createdAt          DateTime         @default(now()) @map("created_at")
  cycle              RecoveryCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  actions            RecoveryAction[]

  @@index([cycleId])
  @@index([workspaceId])
  @@map("recovery_findings")
}

model RecoveryAction {
  id                     String                 @id @db.Uuid
  cycleId                String                 @map("cycle_id") @db.Uuid
  findingId              String?                @map("finding_id") @db.Uuid
  businessId             String                 @map("business_id") @db.Uuid
  workspaceId            String                 @map("workspace_id") @db.Uuid
  title                  String
  description            String
  assignedToRole         String                 @map("assigned_to_role")
  assignedToUserId       String?                @map("assigned_to_user_id") @db.Uuid
  priority               String
