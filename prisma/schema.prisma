  @@index([actionId])
  @@index([workspaceId])
  @@map("recovery_verifications")
}

// === Module 2 — Financial Intelligence (finance-specific, additive) ===
// Separate from recovery_* tables (per MODULE2_SLICE0_SCHEMA_DECISION_NOTE.md).
// Reuses OwnerBusiness; does not mutate any recovery_* or owner_metric_snapshots.

model OwnerFinancialSnapshot {
  id                  String              @id @db.Uuid
  workspaceId         String              @db.Uuid @map("workspace_id")
  businessId          String              @db.Uuid @map("business_id")
  periodStart         DateTime            @map("period_start")
  periodEnd           DateTime            @map("period_end")
  currency            String
  businessModelType   String?             @map("business_model_type")
  industryTemplate    String?             @map("industry_template")
  revenue             Float?
  costOfGoods         Float?              @map("cost_of_goods")
  fixedCosts          Float?              @map("fixed_costs")
  variableCosts       Float?              @map("variable_costs")
  rent                Float?
  payroll             Float?
  utilities           Float?
  deliveryCost        Float?              @map("delivery_cost")
  marketingSpend      Float?              @map("marketing_spend")
  discountAmount      Float?              @map("discount_amount")
  refundReworkCost    Float?              @map("refund_rework_cost")
  debtPayments        Float?              @map("debt_payments")
  cashOnHand          Float?              @map("cash_on_hand")
  receivables         Float?
  overdueReceivables  Float?              @map("overdue_receivables")
  payables            Float?
  overduePayables     Float?              @map("overdue_payables")
  ownerWithdrawals    Float?              @map("owner_withdrawals")
