// B14: Browser-Assisted Import (Restricted Fallback)
model BrowserImportSession {
  id            String    @id
  workspaceId   String    @map("workspace_id") @db.Uuid
  providerId    String    @map("provider_id") @db.Uuid
  userId        String    @map("user_id")
  status        String    @default("active") // active|completed|failed|abandoned
  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  failureReason String?   @map("failure_reason")
  userAgent     String    @map("user_agent")
  ipAddress     String    @map("ip_address")

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider  ExternalProvider        @relation(fields: [providerId], references: [id], onDelete: Restrict)
  events    BrowserImportEvent[]
  tables    BrowserExtractedTable[]
  consent   BrowserImportConsent?

  @@index([workspaceId])
  @@index([status])
  @@index([startedAt])
