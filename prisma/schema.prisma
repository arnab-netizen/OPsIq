  cycles                 RecoveryCycle[]

  @@unique([businessId, periodStart, periodEnd])
  @@index([businessId])
  @@index([workspaceId])
  @@map("owner_metric_snapshots")
}

model RecoveryCycle {
  id              String              @id @db.Uuid
  businessId      String              @db.Uuid @map("business_id")
  workspaceId     String              @db.Uuid @map("workspace_id")
  snapshotId      String              @db.Uuid @map("snapshot_id")
  previousCycleId String?             @db.Uuid @map("previous_cycle_id")
  cycleNumber     Int                 @map("cycle_number")
  status          String              @default("open")
  healthStatus    String              @map("health_status")
  healthScore     Float               @map("health_score")
  summary         String?
  createdBy       String?             @db.Uuid @map("created_by")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  business        OwnerBusiness       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  snapshot        OwnerMetricSnapshot @relation(fields: [snapshotId], references: [id])
  previousCycle   RecoveryCycle?      @relation("CycleHistory", fields: [previousCycleId], references: [id])
  nextCycles      RecoveryCycle[]     @relation("CycleHistory")
  findings        RecoveryFinding[]
  actions         RecoveryAction[]

  @@index([businessId])
  @@index([workspaceId])
  @@map("recovery_cycles")
}

model RecoveryFinding {
  id                 String           @id @db.Uuid
  cycleId            String           @db.Uuid @map("cycle_id")
