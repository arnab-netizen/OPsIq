/// Persistent controlled-learning artifact for behavioral validation. A corrected-behavior rule
/// distilled from a scored failure. Workspace-scoped by default (workspace_private); promotion to a
/// shareable/global template requires approval. Future advice READS active, in-scope artifacts and
/// records which it applied. Versioned + revertible; never silently rewritten.
model BehavioralLearningArtifact {
  id                     String  @id
  sourceCaseId           String  @map("source_case_id")
  businessType           String  @map("business_type")
  archetype              String
  locationKey            String  @map("location_key") // abstracted country|tier — never raw private data
  failureLabel           String  @map("failure_label")
  originalFailedBehavior String  @map("original_failed_behavior")
  correctedBehavior      String  @map("corrected_behavior")
  scopeArchetype         String? @map("scope_archetype")
  scopeDecisionCategory  String? @map("scope_decision_category")
  scopeLocationKey       String? @map("scope_location_key")
  riskLevel              String  @map("risk_level") // low | medium | high
  approvalStatus         String  @map("approval_status") // pending | approved | rejected
  scope                  String // local_only | archetype_level | global_template
  privacyClassification  String  @map("privacy_classification") // workspace_private | abstracted_shareable
  workspaceId            String? @map("workspace_id") // set for workspace_private artifacts
  version                Int     @default(1)
  supersededByVersion    Int?    @map("superseded_by_version")
  active                 Boolean @default(true)
  createdAt              String  @map("created_at") // ISO, stamped by caller
  auditTrail             Json    @map("audit_trail")

  @@index([workspaceId])
  @@index([archetype])
  @@index([approvalStatus])
  @@index([sourceCaseId])
  @@map("behavioral_learning_artifacts")
}

// ─── Growth: Acquisition Metrics Persistence ─────────────────────────────────
// Replaces the BUILT_VOLATILE in-memory Map in AcquisitionEngine.
// Each row stores one channel-month acquisition snapshot.
// workspaceId is an indexed plain UUID (matches Workspace.id from canonical context).
model AcquisitionMetricsRecord {
  id                 String   @id @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  channel            String // AcquisitionChannel enum value
  month              String // YYYY-MM
  leads              Int      @default(0)
  qualifiedLeads     Int?     @map("qualified_leads")
  conversions        Int      @default(0)
  costPerLead        Float    @default(0) @map("cost_per_lead")
  costPerAcquisition Float    @default(0) @map("cost_per_acquisition")
  targetCPA          Float    @default(0) @map("target_cpa")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, channel, month])
  @@map("acquisition_metrics_records")
}

// ─── Growth: Price Tier Persistence ──────────────────────────────────────────
// Replaces the BUILT_VOLATILE in-memory Map in PricingEngine.
// Implements plan-required schema: currency, unit of measure, effective dates,
// version history (append-only via supersededById), variable/allocated costs,
// customer segment, channel, quantity breaks, discount structure, approval status,
// provenance. Derived margin is computed at read time — NOT stored.
model GrowthPriceTier {
  id                String    @id @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  name              String
  currency          String    @default("USD")
  unitOfMeasure     String    @default("seat") @map("unit_of_measure")
  entryPrice        Float     @map("entry_price")
  maxPrice          Float     @map("max_price")
  variableCost      Float?    @map("variable_cost")
  allocatedCost     Float?    @map("allocated_cost")
  customerSegment   String?   @map("customer_segment")
  channel           String?
  quantityBreaks    Json?     @map("quantity_breaks")
  discountStructure Json?     @map("discount_structure")
  features          Json      @default("[]")
  status            String    @default("DRAFT")
  approvalStatus    String    @default("pending_approval") @map("approval_status")
  approvedBy        String?   @map("approved_by") @db.Uuid
  approvedAt        DateTime? @map("approved_at")
  provenance        String?
  effectiveFrom     DateTime? @map("effective_from")
  effectiveTo       DateTime? @map("effective_to")
  version           Int       @default(1)
  supersededById    String?   @map("superseded_by_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, approvalStatus])
  @@index([workspaceId, status])
  @@map("growth_price_tiers")
}

// ─── Growth: Sales Deal Persistence ──────────────────────────────────────────
// Replaces the BUILT_VOLATILE in-memory Map in SalesPipelineEngine.
// Each row represents one sales deal with its current pipeline stage.
// workspaceId is an indexed plain UUID (matches Workspace.id from canonical context).
model SalesDealRecord {
