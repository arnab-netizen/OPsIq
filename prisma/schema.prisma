// profit lens of Module 2). Mirrors the finance persistence shape so the shared
// Owner Intelligence Spine reads both domains uniformly.

model OwnerCashflowSnapshot {
  id                  String               @id @db.Uuid
  workspaceId         String               @db.Uuid @map("workspace_id")
  businessId          String               @db.Uuid @map("business_id")
  periodStart         DateTime             @map("period_start")
  periodEnd           DateTime             @map("period_end")
  currency            String
  businessModelType   String?              @map("business_model_type")
  industryTemplate    String?              @map("industry_template")
