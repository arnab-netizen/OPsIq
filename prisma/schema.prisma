  metricDate      DateTime      @map("metric_date")
  value           Float
  unit            String?
  sourceType      String        @default("MANUAL") @map("source_type") // MANUAL | IMPORT (never live feed)
  sourceRef       String?       @map("source_ref")
  confidenceState String        @default("unverified") @map("confidence_state")
  createdBy       String?       @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  business        OwnerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

