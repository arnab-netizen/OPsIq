  workspaceId            String    @map("workspace_id") @db.Uuid
  sessionId              String    @map("session_id") @db.Uuid
  ideaId                 String?   @map("idea_id") @db.Uuid
  decisionType           String    @map("decision_type") // GO | MODIFY | HOLD | REJECT | REQUEST_MORE_EVIDENCE
  rationale              String?   @db.Text
  actorId                String    @map("actor_id") @db.Uuid
  spendingLimitCents     BigInt?   @map("spending_limit_cents")
  permittedActions       Json      @default("[]") @map("permitted_actions")
  prohibitedActions      Json      @default("[]") @map("prohibited_actions")
  validUntil             DateTime? @map("valid_until")
  reviewDate             DateTime? @map("review_date")
  materialAssumptions    Json      @default("[]") @map("material_assumptions")
  linkedSystemRecId      String?   @map("linked_system_rec_id") @db.Uuid
  linkedProfileVersionId String?   @map("linked_profile_version_id") @db.Uuid
  linkedEconomicModelId  String?   @map("linked_economic_model_id") @db.Uuid
  linkedReadinessId      String?   @map("linked_readiness_id") @db.Uuid
  // Approval package completeness — snapshot every versioned artifact at decision time
  linkedIdeaVersionId    String?   @map("linked_idea_version_id") @db.Uuid
  linkedBusinessModelId  String?   @map("linked_business_model_id") @db.Uuid
  linkedMarketSizingId   String?   @map("linked_market_sizing_id") @db.Uuid
  linkedValidationPlanId String?   @map("linked_validation_plan_id") @db.Uuid
  packageHashSha256      String?   @map("package_hash_sha256") // SHA-256 of all 21 bound fields — detects any post-approval mutation
  evidenceSnapshotIds    Json      @default("[]") @map("evidence_snapshot_ids") // IDs of all evidence records at decision time
  riskSnapshotIds        Json      @default("[]") @map("risk_snapshot_ids") // IDs of all risk entries at decision time
  constraintSnapshotIds  Json      @default("[]") @map("constraint_snapshot_ids") // IDs of all constraint records at decision time
  resourceSnapshotIds    Json      @default("[]") @map("resource_snapshot_ids") // IDs of all resource allocations at decision time
