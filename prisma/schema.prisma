  @@map("owner_finance_verifications")
}

// === Module 5 — Cashflow Intelligence (cashflow-specific, additive) ===
// Separate from recovery_* and owner_finance_* tables. Reuses OwnerBusiness via
// FK; does not mutate any existing table. Liquidity lens (distinct from the
// profit lens of Module 2). Mirrors the finance persistence shape so the shared
// Owner Intelligence Spine reads both domains uniformly.

model OwnerCashflowSnapshot {
  id                  String               @id @db.Uuid
  workspaceId         String               @db.Uuid @map("workspace_id")
  businessId          String               @db.Uuid @map("business_id")
  periodStart         DateTime             @map("period_start")
  periodEnd           DateTime             @map("period_end")
  currency            String
  businessModelType   String?              @map("business_model_type")
  industryTemplate    String?              @map("industry_template")
  cashInHand          Float?               @map("cash_in_hand")
  bankBalance         Float?               @map("bank_balance")
  dailyCollections    Float?               @map("daily_collections")
  receivables         Float?
  receivablesOverdue  Float?               @map("receivables_overdue")
  payables            Float?
  payablesOverdue     Float?               @map("payables_overdue")
  upcomingEmi         Float?               @map("upcoming_emi")
  rentDue             Float?               @map("rent_due")
  salaryDue           Float?               @map("salary_due")
  vendorDue           Float?               @map("vendor_due")
  taxDue              Float?               @map("tax_due")
  ownerWithdrawal     Float?               @map("owner_withdrawal")
  notes               String?
  dataConfidenceScore Float                @map("data_confidence_score")
  missingCriticalData Json                 @map("missing_critical_data")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  business            OwnerBusiness        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cycles              OwnerCashflowCycle[]

  @@unique([businessId, periodStart, periodEnd])
  @@index([workspaceId])
  @@index([businessId])
  @@index([periodEnd])
  @@map("owner_cashflow_snapshots")
}

model OwnerCashflowCycle {
  id                  String                 @id @db.Uuid
  workspaceId         String                 @db.Uuid @map("workspace_id")
  businessId          String                 @db.Uuid @map("business_id")
  snapshotId          String                 @db.Uuid @map("snapshot_id")
  sequenceNumber      Int                    @map("sequence_number")
  status              String                 @default("open")
  healthScore         Float                  @map("health_score")
  dangerScore         Float                  @map("danger_score")
  opportunityScore    Float                  @map("opportunity_score")
  dataConfidenceScore Float                  @map("data_confidence_score")
  cashflowState       String                 @map("cashflow_state")
  generatedAt         DateTime               @map("generated_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  business            OwnerBusiness          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  snapshot            OwnerCashflowSnapshot  @relation(fields: [snapshotId], references: [id])
  findings            OwnerCashflowFinding[]
  actions             OwnerCashflowAction[]

  @@unique([businessId, sequenceNumber])
  @@index([workspaceId])
