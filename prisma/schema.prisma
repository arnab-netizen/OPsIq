generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Foundation: User & Auth ────────────────────────────────────────────────

model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  name           String?
  hashedPassword String?   @map("hashed_password")
  isActive       Boolean   @default(true) @map("is_active")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deactivatedAt  DateTime? @map("deactivated_at")

  sessions              Session[]
  roleAssignments       UserRoleAssignment[]
  auditEvents           AuditEvent[]
  engagementMemberships EngagementMembership[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?   @map("ip_address")
  userAgent String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model UserRoleAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      String
  scope     String?
  scopeId   String?   @map("scope_id") @db.Uuid
  grantedBy String?   @map("granted_by") @db.Uuid
  grantedAt DateTime  @default(now()) @map("granted_at")
  revokedAt DateTime? @map("revoked_at")
  isActive  Boolean   @default(true) @map("is_active")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, role, scope, scopeId])
  @@index([userId, isActive])
  @@map("user_role_assignments")
}

// ─── Identity: Engagement Membership ────────────────────────────────────────

model EngagementMembership {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  engagementId String    @map("engagement_id") @db.Uuid
  role         String // engagement-scoped role
  addedBy      String?   @map("added_by") @db.Uuid
  addedAt      DateTime  @default(now()) @map("added_at")
  removedAt    DateTime? @map("removed_at")
  isActive     Boolean   @default(true) @map("is_active")

  user       User       @relation(fields: [userId], references: [id])
  engagement Engagement @relation(fields: [engagementId], references: [id])

  @@unique([userId, engagementId, role])
  @@index([engagementId, isActive])
  @@index([userId, isActive])
  @@map("engagement_memberships")
}

// ─── Module 2: Lead ────────────────────────────────────────────────────────

model LeadRecord {
  id                  String   @id @default(uuid()) @db.Uuid
  companyName         String   @map("company_name")
  contactName         String?  @map("contact_name")
  contactEmail        String?  @map("contact_email")
  contactPhone        String?  @map("contact_phone")
  source              String? // e.g. "referral", "website", "outbound"
  status              String   @default("new") // "new" | "qualifying" | "qualified" | "converted" | "lost"
  notes               String?
  estimatedValue      Float?   @map("estimated_value")
  convertedToClientId String?  @map("converted_to_client_id") @db.Uuid
  engagementId        String?  @map("engagement_id") @db.Uuid
  assignedTo          String?  @map("assigned_to") @db.Uuid
  createdBy           String?  @map("created_by") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  client     ClientAccount? @relation(fields: [convertedToClientId], references: [id])
  engagement Engagement?    @relation(fields: [engagementId], references: [id])

  @@index([status])
  @@index([assignedTo])
  @@index([convertedToClientId])
  @@map("lead_records")
}

// ─── Module 2: Client Account ──────────────────────────────────────────────

model ClientAccount {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  legalName  String?   @map("legal_name")
  industry   String?
  size       String? // "micro" | "small" | "medium" | "large"
  status     String    @default("active") // "active" | "inactive" | "archived"
  website    String?
  address    String?
  notes      String?
  version    Int       @default(1)
  visibility String    @default("internal") // "internal" | "client_visible"
  createdBy  String?   @map("created_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  contacts    ClientContact[]
  engagements Engagement[]
  leads       LeadRecord[]

  @@index([status])
  @@map("client_accounts")
}

model ClientContact {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  name      String
  email     String?
  phone     String?
  role      String? // e.g. "owner", "cfo", "operations_manager"
  isPrimary Boolean  @default(false) @map("is_primary")
  isActive  Boolean  @default(true) @map("is_active")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  client ClientAccount @relation(fields: [clientId], references: [id])

  @@index([clientId, isActive])
  @@map("client_contacts")
}

// ─── Module 2: Engagement ──────────────────────────────────────────────────

model Engagement {
  id                    String    @id @default(uuid()) @db.Uuid
  code                  String    @unique // human-readable engagement code
  title                 String
  clientId              String    @map("client_id") @db.Uuid
  serviceTier           String    @map("service_tier") // "standard" | "premium" | "enterprise"
  engagementMode        String    @map("engagement_mode") // "beginner" | "expert"
  status                String    @default("draft") // governed by ENGAGEMENT_STATUSES
  healthStatus          String    @default("healthy") @map("health_status") // "healthy" | "at_risk" | "critical" | "unknown"
  interventionMode      String    @default("recovery") @map("intervention_mode") // governed by INTERVENTION_MODES
  description           String?
  startDate             DateTime? @map("start_date")
  targetEndDate         DateTime? @map("target_end_date")
  actualEndDate         DateTime? @map("actual_end_date")
  ownerId               String?   @map("owner_id") @db.Uuid // primary consultant
  assignedConsultantId  String?   @map("assigned_consultant_id") @db.Uuid
  currentScopeVersionId String?   @map("current_scope_version_id") @db.Uuid // placeholder for future scope module
  parentEngagementId    String?   @map("parent_engagement_id") @db.Uuid // retainer/micro-engagement lineage
  version               Int       @default(1)
  visibility            String    @default("internal") // "internal" | "client_visible"
  createdBy             String?   @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  client            ClientAccount              @relation(fields: [clientId], references: [id])
  parent            Engagement?                @relation("EngagementLineage", fields: [parentEngagementId], references: [id])
  children          Engagement[]               @relation("EngagementLineage")
  conditionProfiles BusinessConditionProfile[]
  memberships       EngagementMembership[]
  leads             LeadRecord[]
  healthChecks      HealthCheckRecord[]

  @@index([clientId])
  @@index([status])
  @@index([ownerId])
  @@index([parentEngagementId])
  @@map("engagements")
}

// ─── Module 2: Business Condition Profile ──────────────────────────────────

model BusinessConditionProfile {
  id                      String   @id @default(uuid()) @db.Uuid
  engagementId            String   @map("engagement_id") @db.Uuid
  businessStatus          String   @map("business_status") // governed by BUSINESS_CONDITION_RATINGS
  severityScore           Int      @map("severity_score") // 1-10
  urgencyLevel            String   @map("urgency_level") // "low" | "medium" | "high" | "critical"
  cashPressureLevel       String   @map("cash_pressure_level") // "low" | "medium" | "high" | "critical"
  marginPressureLevel     String   @map("margin_pressure_level") // "low" | "medium" | "high" | "critical"
  clientConcentrationRisk String   @map("client_concentration_risk") // "low" | "medium" | "high" | "critical"
  ownerDependencyRisk     String   @map("owner_dependency_risk") // "low" | "medium" | "high" | "critical"
  keyPersonDependencyRisk String   @map("key_person_dependency_risk") // "low" | "medium" | "high" | "critical"
  processMaturityLevel    String   @map("process_maturity_level") // "low" | "medium" | "high"
  managementMaturityLevel String   @map("management_maturity_level") // "low" | "medium" | "high"
  executionCapacityLevel  String   @map("execution_capacity_level") // "low" | "medium" | "high"
  moraleFragilityLevel    String   @map("morale_fragility_level") // "low" | "medium" | "high" | "critical"
  resilienceLevel         String   @map("resilience_level") // "low" | "medium" | "high"
  growthReadinessLevel    String   @map("growth_readiness_level") // "low" | "medium" | "high"
  notes                   String?
  assessedBy              String?  @map("assessed_by") @db.Uuid
  version                 Int      @default(1)
  isCurrent               Boolean  @default(true) @map("is_current") // only one current per engagement
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  engagement Engagement @relation(fields: [engagementId], references: [id])

  @@index([engagementId, isCurrent])
  @@index([engagementId])
  @@map("business_condition_profiles")
}

// ─── Foundation: Audit ──────────────────────────────────────────────────────

model AuditEvent {
  id            String   @id @default(uuid()) @db.Uuid
  eventName     String   @map("event_name")
  actorId       String?  @map("actor_id") @db.Uuid
  actorType     String   @default("user") @map("actor_type")
  entityType    String?  @map("entity_type")
  entityId      String?  @map("entity_id") @db.Uuid
  payload       Json?
  correlationId String?  @map("correlation_id")
  visibility    String   @default("internal") // "internal" | "client_visible"
  occurredAt    DateTime @default(now()) @map("occurred_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([eventName])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([occurredAt])
  @@index([correlationId])
  @@map("audit_events")
}

// ─── Foundation: Idempotency ────────────────────────────────────────────────

model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  idempotencyKey String    @unique @map("idempotency_key")
  operationName  String    @map("operation_name")
  status         String    @default("pending") // "pending" | "completed" | "failed"
  responseCode   Int?      @map("response_code")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")
  expiresAt      DateTime  @map("expires_at")

  @@index([idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ─── Foundation: Scheduler ──────────────────────────────────────────────────

model ScheduledTask {
  id           String    @id @default(uuid()) @db.Uuid
  taskName     String    @map("task_name")
  payload      Json?
  status       String    @default("pending") // "pending" | "running" | "completed" | "failed" | "dead_letter"
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3) @map("max_attempts")
  lastError    String?   @map("last_error")
  scheduledFor DateTime  @map("scheduled_for")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([status, scheduledFor])
  @@index([taskName])
  @@map("scheduled_tasks")
}

// ─── Module 3: Findings & Evidence ──────────────────────────────────────────

enum FindingStatus {
  DRAFT
  VALIDATED
  CLOSED
  DISPUTED
  SUPERSEDED
}

enum ConfidenceLabel {
  LOW
  MEDIUM
  HIGH
  PROVISIONAL
}

model FindingRecord {
  id                  String          @id @default(uuid()) @db.Uuid
  engagementId        String          @map("engagement_id") @db.Uuid
  title               String
  statement           String
  severity            String
  status              FindingStatus
  confidenceLabel     ConfidenceLabel @map("confidence_label")
  provisionalFlag     Boolean         @default(false) @map("provisional_flag")
  clientVisibility    String          @map("client_visibility")
  issueKey            String?         @map("issue_key")
  supersedesFindingId String?         @map("supersedes_finding_id") @db.Uuid
  createdByUserId     String?         @map("created_by_user_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  @@index([engagementId, status])
  @@index([engagementId, severity])
  @@index([engagementId, provisionalFlag])
  @@map("finding_records")
}

// ─── Module 3: Recommendations ──────────────────────────────────────────────

enum RecommendationClass {
  CONTAINMENT
  STABILIZATION
  STRUCTURAL_REPAIR
  GROWTH_ENABLEMENT
  RESILIENCE_PROTECTION
}

model RecommendationRecord {
  id                      String              @id @default(uuid()) @db.Uuid
  engagementId            String              @map("engagement_id") @db.Uuid
  findingId               String?             @map("finding_id") @db.Uuid
  recommendationCode      String              @map("recommendation_code")
  title                   String
  recommendationClass     RecommendationClass @map("recommendation_class")
  rationale               String
  businessCriticality     Int                 @map("business_criticality")
  timeToEffect            Int                 @map("time_to_effect")
  cashRequirement         Int                 @map("cash_requirement")
  ownerDependency         Int                 @map("owner_dependency")
  staffingDependency      Int                 @map("staffing_dependency")
  resistanceRisk          Int                 @map("resistance_risk")
  executionFeasibility    Int                 @map("execution_feasibility")
  failureConsequence      Int                 @map("failure_consequence")
  contingencyAvailability Int                 @map("contingency_availability")
  createdByUserId         String?             @map("created_by_user_id") @db.Uuid
  createdAt               DateTime            @default(now()) @map("created_at")
  updatedAt               DateTime            @updatedAt @map("updated_at")

  @@index([engagementId, recommendationClass])
  @@map("recommendation_records")
}

// ─── Module 3: Actions & Execution ──────────────────────────────────────────

enum ActionStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED
}

model ActionRecord {
  id               String       @id @default(uuid()) @db.Uuid
  engagementId     String       @map("engagement_id") @db.Uuid
  recommendationId String?      @map("recommendation_id") @db.Uuid
  title            String
  description      String
  phase            String
  ownerUserId      String?      @map("owner_user_id") @db.Uuid
  dueDate          DateTime?    @map("due_date")
  status           ActionStatus
  contingencyPlan  String?      @map("contingency_plan")
  fallbackOption   String?      @map("fallback_option")
  criticalityLevel Int          @map("criticality_level")
  executionRisk    Int          @map("execution_risk")
  createdByUserId  String?      @map("created_by_user_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([engagementId, status])
  @@map("action_records")
}

model ActionDependencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  actionId    String   @map("action_id") @db.Uuid
  dependsOnId String   @map("depends_on_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([actionId, dependsOnId])
  @@map("action_dependency_records")
}

// ─── Module 3: KPI Tracking ─────────────────────────────────────────────────

enum KpiCategory {
  SURVIVAL
  EXECUTION
  STABILITY
  GROWTH_READINESS
}

model KpiDefinitionRecord {
  id                String      @id @default(uuid()) @db.Uuid
  engagementId      String      @map("engagement_id") @db.Uuid
  name              String
  category          KpiCategory
  unit              String
  targetDescription String?     @map("target_description")
  createdByUserId   String?     @map("created_by_user_id") @db.Uuid
  createdAt         DateTime    @default(now()) @map("created_at")

  @@index([engagementId, category])
  @@map("kpi_definition_records")
}

model KpiSnapshotRecord {
  id              String          @id @default(uuid()) @db.Uuid
  kpiDefinitionId String          @map("kpi_definition_id") @db.Uuid
  periodStart     DateTime?       @map("period_start")
  periodEnd       DateTime?       @map("period_end")
  value           Float
  sourceNote      String?         @map("source_note")
  confidenceLabel ConfidenceLabel @map("confidence_label")
  recordedAt      DateTime        @default(now()) @map("recorded_at")
  createdByUserId String?         @map("created_by_user_id") @db.Uuid

  @@index([kpiDefinitionId, recordedAt])
  @@map("kpi_snapshot_records")
}

// ─── Module 3: Deliverables ─────────────────────────────────────────────────

enum DeliverableState {
  DRAFT
  READY_FOR_REVIEW
  UNDER_REVIEW
  APPROVED
  ISSUED
  SUPERSEDED
  ARCHIVED
  WITHDRAWN
  RETURNED_FOR_REVISION
  CONDITIONALLY_APPROVED
}

model DeliverableRecord {
  id               String   @id @default(uuid()) @db.Uuid
  engagementId     String   @map("engagement_id") @db.Uuid
  deliverableType  String   @map("deliverable_type")
  currentVersionId String?  @map("current_version_id") @db.Uuid
  visibility       String
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([engagementId, deliverableType])
  @@map("deliverable_records")
}

model DeliverableVersionRecord {
  id              String           @id @default(uuid()) @db.Uuid
  deliverableId   String           @map("deliverable_id") @db.Uuid
  versionNumber   Int              @map("version_number")
  sourceManifest  Json             @map("source_manifest")
  payload         Json
  state           DeliverableState
  revisionType    String?          @map("revision_type")
  createdByUserId String?          @map("created_by_user_id") @db.Uuid
  createdAt       DateTime         @default(now()) @map("created_at")

  @@unique([deliverableId, versionNumber])
  @@map("deliverable_version_records")
}

// ─── Module 3: Stage Management ──────────────────────────────────────────────

enum StageState {
  DRAFT
  NOT_STARTED
  ACTIVE
  PENDING_INPUT
  AWAITING_CLIENT
  AWAITING_CONSULTANT
  AWAITING_VALIDATION
  AWAITING_APPROVAL
  BLOCKED
  DEFERRED
  PARTIALLY_COMPLETED
  COMPLETED
  CANCELLED
  REOPENED
  DISPUTED
  PROVISIONAL_OUTPUT_ONLY
  FORCED_CLOSURE_REVIEW
  DORMANT
}

model StageInstanceRecord {
  id           String     @id @default(uuid()) @db.Uuid
  engagementId String     @map("engagement_id") @db.Uuid
  stageKey     String     @map("stage_key")
  state        StageState
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@unique([engagementId, stageKey])
  @@map("stage_instance_records")
}

model StageBlockerRecord {
  id              String   @id @default(uuid()) @db.Uuid
  stageInstanceId String   @map("stage_instance_id") @db.Uuid
  severity        String
  summary         String
  resolved        Boolean  @default(false)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([stageInstanceId, resolved])
  @@map("stage_blocker_records")
}

// ─── Module 3: Governance & Approvals ────────────────────────────────────────

model ApprovalRecord {
  id              String   @id @default(uuid()) @db.Uuid
  engagementId    String   @map("engagement_id") @db.Uuid
  objectType      String   @map("object_type")
  objectId        String   @map("object_id") @db.Uuid
  decision        String
  reason          String?
  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([engagementId, objectType])
  @@map("approval_records")
}

model OverrideRecord {
  id               String   @id @default(uuid()) @db.Uuid
  engagementId     String   @map("engagement_id") @db.Uuid
  objectType       String   @map("object_type")
  objectId         String   @map("object_id") @db.Uuid
  reason           String
  approvedByUserId String?  @map("approved_by_user_id") @db.Uuid
  createdByUserId  String?  @map("created_by_user_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([engagementId, objectType])
  @@map("override_records")
}

// ─── Module 3: Review Cycles & Retainers ────────────────────────────────────

enum ReviewLens {
  SURVIVAL
  EXECUTION
  STABILITY
  GROWTH_READINESS
}

model ReviewCycleRecord {
  id              String     @id @default(uuid()) @db.Uuid
  engagementId    String     @map("engagement_id") @db.Uuid
  reviewLens      ReviewLens @map("review_lens")
  summary         String
  createdByUserId String?    @map("created_by_user_id") @db.Uuid
  createdAt       DateTime   @default(now()) @map("created_at")

  @@index([engagementId, reviewLens])
  @@map("review_cycle_records")
}

model RetainerRecord {
  id              String    @id @default(uuid()) @db.Uuid
  clientId        String    @map("client_id") @db.Uuid
  engagementId    String?   @map("engagement_id") @db.Uuid
  status          String
  cadence         String
  nextReviewAt    DateTime? @map("next_review_at")
  createdByUserId String?   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([clientId, status])
  @@map("retainer_records")
}

// ─── Module 3: Operations & Health ──────────────────────────────────────────

model NotificationRuleRecord {
  id           String   @id @default(uuid()) @db.Uuid
  engagementId String?  @map("engagement_id") @db.Uuid
  ruleKey      String   @map("rule_key")
  enabled      Boolean  @default(true)
  config       Json
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([engagementId, ruleKey])
  @@map("notification_rule_records")
}

enum HealthStatus {
  OK
  WARNING
  CRITICAL
}

enum HealthScope {
  SYSTEM
  ENGAGEMENT
  MODULE
}

model HealthCheckRecord {
  id String @id @default(uuid()) @db.Uuid

  scope   HealthScope
  status  HealthStatus
  details Json

  engagementId String?     @map("engagement_id") @db.Uuid
  engagement   Engagement? @relation(fields: [engagementId], references: [id])

  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  checkedAt DateTime @default(now()) @map("checked_at")

  @@index([scope, checkedAt])
  @@index([engagementId])
  @@map("health_check_records")
}
