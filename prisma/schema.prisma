  ownerRole             String                      @map("owner_role")
  status                String                      @default("proposed")
  priorityScore         Float                       @map("priority_score")
  effortScore           Float                       @map("effort_score")
  expectedImpactScore   Float                       @map("expected_impact_score")
  confidence            Float
  verificationMetric    String                      @map("verification_metric")
  verificationMethod    String                      @map("verification_method")
  expectedTimeframeDays Int                         @map("expected_timeframe_days")
  dueAt                 DateTime?                   @map("due_at")
  assignedTo            String?                     @map("assigned_to") @db.Uuid
