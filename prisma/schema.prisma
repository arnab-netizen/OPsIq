model Escalation {
  id             String    @id @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  taskId         String?   @map("task_id") @db.Uuid
  category       String
  severity       String
  assignedTarget String    @map("assigned_target")
  status         String    @default("OPEN")
  createdBy      String?   @map("created_by") @db.Uuid
  dueAt          DateTime? @map("due_at")
  resolutionNote String?   @map("resolution_note")
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, status])
  @@index([workspaceId, assignedTarget])
  @@map("escalations")
}

// ============================================================================
// Dynamic Budget, Capital Allocation & Profit Governance (Owner Mode)
// Workspace-scoped; parent is OwnerBusiness (no workspace FK, per owner-mode
// convention). Financial signals are reused from OwnerFinancialSnapshot — these
// tables persist budget structure, spend governance state, and immutable plan
// snapshots only (no duplicate finance storage).
// ============================================================================

model BudgetPeriod {
  id                       String   @id @db.Uuid
  workspaceId              String   @map("workspace_id") @db.Uuid
  businessId               String   @map("business_id") @db.Uuid
  label                    String
  periodStart              DateTime @map("period_start")
  periodEnd                DateTime @map("period_end")
  currency                 String
  approvedBudget           Float?   @map("approved_budget")
  cashReserveTarget        Float?   @map("cash_reserve_target")
  statutoryReserveRequired Float?   @map("statutory_reserve_required")
  ownerGoal                String?  @map("owner_goal")
  status                   String   @default("active")
  createdBy                String?  @map("created_by") @db.Uuid
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, businessId])
  @@index([workspaceId, businessId, status])
  @@map("budget_periods")
}

model BudgetLine {
  id                String    @id @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  periodId          String    @map("period_id") @db.Uuid
  label             String
  category          String
  plannedAmount     Float     @map("planned_amount")
  ownerRole         String?   @map("owner_role")
  approvalThreshold Float?    @map("approval_threshold")
  voidedAt          DateTime? @map("voided_at")
  voidReason        String?   @map("void_reason")
  createdBy         String?   @map("created_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, businessId])
  @@index([workspaceId, periodId])
  @@map("budget_lines")
}

model SpendEntry {
  id                String    @id @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  businessId        String    @map("business_id") @db.Uuid
  periodId          String?   @map("period_id") @db.Uuid
  budgetLineId      String?   @map("budget_line_id") @db.Uuid
  label             String
  category          String
  amount            Float
  state             String    @default("requested")
  sourceType        String    @default("MANUAL") @map("source_type")
  sourceRef         String?   @map("source_ref")
  obligationKind    String?   @map("obligation_kind")
  dueInDays         Int?      @map("due_in_days")
  requestedByUserId String?   @map("requested_by_user_id") @db.Uuid
  approvedByUserId  String?   @map("approved_by_user_id") @db.Uuid
  isNewVendor       Boolean   @default(false) @map("is_new_vendor")
  vendorBankChanged Boolean   @default(false) @map("vendor_bank_changed")
  vendorId          String?   @map("vendor_id") @db.Uuid
  invoiceHash       String?   @map("invoice_hash")
  proofStatus       String?   @map("proof_status")
  riskLevel         String?   @map("risk_level")
  voidedAt          DateTime? @map("voided_at")
  voidReason        String?   @map("void_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, businessId])
  @@index([workspaceId, businessId, state])
  @@map("spend_entries")
}

model BudgetReassessment {
  id             String   @id @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  periodId       String?  @map("period_id") @db.Uuid
  triggerEventId String   @map("trigger_event_id")
  triggerClass   String   @map("trigger_class")
  changeField    String?  @map("change_field")
  mode           String
  confidence     String
  topConstraint  String   @map("top_constraint")
  nextBestAction String   @map("next_best_action")
  decisionType   String   @map("decision_type")
  plan           Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, businessId, triggerEventId])
  @@index([workspaceId])
  @@index([workspaceId, businessId])
  @@map("budget_reassessments")
}

model BudgetPlanSnapshot {
  id             String   @id @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  periodId       String?  @map("period_id") @db.Uuid
  reassessmentId String?  @map("reassessment_id") @db.Uuid
  version        Int
  isCurrent      Boolean  @default(true) @map("is_current")
  mode           String
  confidence     String
  changeReason   String?  @map("change_reason")
  plan           Json
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([workspaceId, businessId])
  @@index([workspaceId, businessId, isCurrent])
  @@map("budget_plan_snapshots")
}

model OwnerBudgetOverride {
  id                     String    @id @db.Uuid
  workspaceId            String    @map("workspace_id") @db.Uuid
  businessId             String    @map("business_id") @db.Uuid
  reassessmentId         String?   @map("reassessment_id") @db.Uuid
  originalRecommendation String    @map("original_recommendation")
  riskWarning            String    @map("risk_warning")
  reason                 String
  affectedLines          Json      @default("[]") @map("affected_lines")
  expectedConsequence    String    @map("expected_consequence")
  reviewDate             DateTime? @map("review_date")
  actualOutcome          String?   @map("actual_outcome")
  outcomeClass           String?   @map("outcome_class")
  outcomeNote            String?   @map("outcome_note")
  createdBy              String?   @map("created_by") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, businessId])
  @@map("owner_budget_overrides")
}

model BudgetAuthority {
  id                  String    @id @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  businessId          String    @map("business_id") @db.Uuid
  subjectUserId       String?   @map("subject_user_id") @db.Uuid
  subjectRole         String?   @map("subject_role")
  scopeCategory       String?   @map("scope_category")
  status              String    @default("NORMAL")
  reason              String?
  triggeringEvidence  Json      @default("{}") @map("triggering_evidence")
  reviewDate          DateTime? @map("review_date")
  restorationCriteria String?   @map("restoration_criteria")
  createdBy           String?   @map("created_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, businessId])
  @@map("budget_authorities")
}

model VendorRecord {
  id             String    @id @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  businessId     String    @map("business_id") @db.Uuid
  name           String
  bankAccountRef String?   @map("bank_account_ref")
  bankVerified   Boolean   @default(false) @map("bank_verified")
  bankChangedAt  DateTime? @map("bank_changed_at")
  relatedParty   Boolean   @default(false) @map("related_party")
  createdBy      String?   @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, businessId])
  @@map("vendor_records")
}

model FundedInitiativeOutcome {
  id              String   @id @db.Uuid
  workspaceId     String   @map("workspace_id") @db.Uuid
  businessId      String   @map("business_id") @db.Uuid
  initiativeLabel String   @map("initiative_label")
  outcome         String
  nextStep        String   @map("next_step")
  safeForLearning Boolean  @map("safe_for_learning")
  expectedImpact  Float?   @map("expected_impact")
  actualImpact    Float?   @map("actual_impact")
  note            String?
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, businessId])
  @@map("funded_initiative_outcomes")
}

model OwnerBudgetAction {
  id                      String        @id @db.Uuid
  workspaceId             String        @map("workspace_id") @db.Uuid
  businessId              String        @map("business_id") @db.Uuid
  periodId                String?       @map("period_id") @db.Uuid
  reassessmentId          String?       @map("reassessment_id") @db.Uuid
  planSnapshotId          String?       @map("plan_snapshot_id") @db.Uuid
  sourceKey               String        @map("source_key")
  title                   String
  decisionType            String        @map("decision_type")
  accountableRole         String        @map("accountable_role")
  assignedTo              String?       @map("assigned_to") @db.Uuid
  dueAt                   DateTime?     @map("due_at")
  reviewInDays            Int           @map("review_in_days")
  requiredProof           String        @map("required_proof")
  expectedFinancialImpact String        @map("expected_financial_impact")
  verificationMethod      String        @map("verification_method")
  escalationPath          String        @map("escalation_path")
  killRule                String?       @map("kill_rule")
  status                  String        @default("proposed")
  completedAt             DateTime?     @map("completed_at")
  completionNotes         String?       @map("completion_notes")
  completionEvidence      Json?         @map("completion_evidence")
  outcomeClass            String?       @map("outcome_class")
  createdBy               String?       @map("created_by") @db.Uuid
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")
  business                OwnerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, businessId, sourceKey])
  @@index([workspaceId])
  @@index([workspaceId, businessId])
  @@index([status])
  @@map("owner_budget_actions")
}

/// Owner working-capital ageing line item (Dynamic Budget ageing slice).
/// Manual / import-ready source data (NOT a live bank/accounting feed). Drives
/// receivable/payable ageing buckets feeding Dynamic Budget reassessment.
model OwnerWorkingCapitalItem {
  id              String        @id @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  businessId      String        @map("business_id") @db.Uuid
  kind            String // "receivable" | "payable"
  counterparty    String // customer (receivable) or vendor (payable) label
  amount          Float
  dueDate         DateTime?     @map("due_date")
  status          String        @default("open")
  sourceType      String        @default("MANUAL") @map("source_type") // MANUAL | IMPORT (never live feed)
  sourceRef       String?       @map("source_ref")
  confidenceState String        @default("unverified") @map("confidence_state")
  createdBy       String?       @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  business        OwnerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, businessId])
  @@index([workspaceId, businessId, kind])
  @@map("owner_working_capital_items")
}

/// Owner archetype operational metric (Dynamic Budget archetype-metrics slice).
/// Manual / import-ready operational figures (chemical cost, load count, travel time,
/// recurring contract terms, …) that feed the archetype budget packs through
/// reassessment. NOT a live feed. Workspace-scoped; cascades with the business.
model OwnerArchetypeMetric {
  id              String        @id @db.Uuid
  workspaceId     String        @map("workspace_id") @db.Uuid
  businessId      String        @map("business_id") @db.Uuid
  archetype       String // "laundry" | "housekeeping" | "generic"
  metricType      String        @map("metric_type")
  metricDate      DateTime      @map("metric_date")
  value           Float
  unit            String?
  sourceType      String        @default("MANUAL") @map("source_type") // MANUAL | IMPORT (never live feed)
  sourceRef       String?       @map("source_ref")
  confidenceState String        @default("unverified") @map("confidence_state")
  createdBy       String?       @map("created_by") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  business        OwnerBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, businessId])
  @@index([workspaceId, businessId, archetype])
  @@index([metricType])
  @@map("owner_archetype_metrics")
}
