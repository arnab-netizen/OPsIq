  @@index([workspaceId])
  @@index([workspaceId, stage])
  @@map("sales_deal_records")
}

// ─── Growth: Revenue Stream Persistence ──────────────────────────────────────
// Replaces the BUILT_VOLATILE in-memory creation in RevenueEngine.
// Each row stores one revenue stream definition for a workspace.
