model DelegatedTask {
  id                          String    @id @db.Uuid
  workspaceId                 String    @map("workspace_id") @db.Uuid
  workOrderId                 String?   @map("work_order_id") @db.Uuid
  assignedUserId              String?   @map("assigned_user_id") @db.Uuid
  assignedRole                String?   @map("assigned_role")
  title                       String
  description                 String?
  status                      String    @default("DRAFT")
  priority                    String?
  dueAt                       DateTime? @map("due_at")
  // Server-trusted time the task first transitioned to IN_PROGRESS (work actually started). Nullable +
  // backfill-safe: null until a governed start; copied onto the task's Proof at submission so the
  // fast-completion signal can measure a trusted duration. Never fabricated (no start → TIMING_MISSING).
  workStartedAt               DateTime? @map("work_started_at")
  estimatedDurationMin        Int?      @map("estimated_duration_min")
  effortLevel                 String?   @map("effort_level")
  requiresTravel              Boolean   @default(false) @map("requires_travel")
  requiresCustomerInteraction Boolean   @default(false) @map("requires_customer_interaction")
  requiresManagerReview       Boolean   @default(false) @map("requires_manager_review")
  approvedBoundaryId          String?   @map("approved_boundary_id") @db.Uuid
  approvedBoundaryVersion     Int?      @map("approved_boundary_version")
  boundaryContentHash         String?   @map("boundary_content_hash")
  proofRequirementId          String?   @map("proof_requirement_id") @db.Uuid
  expectedOutcomeId           String?   @map("expected_outcome_id") @db.Uuid
  financialBoundaryId         String?   @map("financial_boundary_id") @db.Uuid
  createdByUserId             String?   @map("created_by_user_id") @db.Uuid
  // Traceability: optional link back to the OperatorItem (AI recommendation) that originated this task.
  sourceOperatorItemId        String?   @map("source_operator_item_id") @db.Uuid
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @default(now()) @map("updated_at")

  @@index([workspaceId, status])
  @@index([workspaceId, assignedUserId])
  @@map("delegated_tasks")
}

