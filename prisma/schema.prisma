  @@unique([workspaceId, staffRef, skill])
  @@index([workspaceId, staffRef])
  @@map("owner_staff_skill")
}

/// Jarvis 360 Slice 6 — observed-gap training recommendation. Every recommendation
/// must cite observed evidence (no generic training); effectiveness is rechecked.
model OwnerTrainingRecommendation {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  staffRef            String    @map("staff_ref")
  reasonCode          String    @map("reason_code")
