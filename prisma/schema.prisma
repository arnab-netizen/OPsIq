  description String
  metadata    Json?
  timestamp   DateTime @default(now())

  session BrowserImportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([eventType])
  @@index([timestamp])
  @@map("browser_import_events")
}

model BrowserExtractedTable {
  id               String    @id
  sessionId        String    @map("session_id")
  tableName        String    @map("table_name")
  columnHeaders    String[]  @map("column_headers")
  dataRows         Json      @map("data_rows") // Array of objects
  extractionMethod String    @map("extraction_method") // manual_copy|file_export|screenshot
  confidence       Decimal   @default(0.7) // User's confidence 0.0-1.0
  status           String    @default("draft") // draft|approved|rejected
  recordCount      Int       @default(0) @map("record_count")
  createdAt        DateTime  @default(now()) @map("created_at")
  approvedAt       DateTime? @map("approved_at")
  approvedBy       String?   @map("approved_by")
  rejectionReason  String?   @map("rejection_reason")

  session BrowserImportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([status])
  @@index([createdAt])
  @@map("browser_extracted_tables")
}

model BrowserImportConsent {
  id                String   @id
  sessionId         String   @unique @map("session_id")
  workspaceId       String   @map("workspace_id") @db.Uuid
  userId            String   @map("user_id")
  statementAccepted Boolean  @map("statement_accepted")
  statement         String
  acceptedAt        DateTime @default(now()) @map("accepted_at")
  ipAddress         String   @map("ip_address")
  userAgent         String   @map("user_agent")

  workspace Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session   BrowserImportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sessionId])
  @@map("browser_import_consents")
}

// B15: Real-World Case-Study Benchmark Library
model CaseStudy {
  id          String @id
  title       String
  description String @db.Text

  // Business context
  industry      String
  businessModel String @map("business_model")
  businessSize  String @map("business_size") // startup|small|medium|large|enterprise
  year          Int
  yearStart     Int    @map("year_start")
  yearEnd       Int    @map("year_end")

  // Case data
  symptoms      Json // CaseStudySymptom[]
  availableData Json @map("available_data") // CaseStudyEvidence[]

  // Hidden vs expert causes (for blind testing)
  hiddenRootCauses       Json    @map("hidden_root_causes") // RootCause[]
  hiddenCausesSummary    String? @map("hidden_causes_summary") @db.Text
  expertIdentifiedCauses Json    @map("expert_identified_causes") // RootCause[]
  expertCausesSummary    String? @map("expert_causes_summary") @db.Text

  // Actions and outcomes
  actionsTaken  Json @map("actions_taken") // ImplementedAction[]
  actualOutcome Json @map("actual_outcome") // CaseStudyOutcome

  // Source transparency (CRITICAL)
  sources             Json // CaseStudySource[]
  licenseOrAllowedUse String @map("license_or_allowed_use") @db.Text

  // Confidence metrics
  confidence       Decimal @default(0.7) // 0.0-1.0
  dataCompleteness Decimal @default(0.7) @map("data_completeness") // 0.0-1.0
  expertValidated  Boolean @default(false) @map("expert_validated")

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  benchmarks CaseBenchmarkResult[]

  @@index([industry])
  @@index([businessSize])
  @@index([year])
  @@index([confidence])
  @@map("case_studies")
}

model CaseBenchmarkResult {
  id          String @id
  caseId      String @map("case_id")
  diagnosisId String @map("diagnosis_id")

  // What was identified
  identifiedCauses Json @map("identified_causes") // RootCause[]
  confidenceScores Json @map("confidence_scores") // Array of {cause, engineConfidence, actualConfidence}

  // Scores
  accuracyScore  Decimal @map("accuracy_score") // 0.0-1.0
  precisionScore Decimal @map("precision_score") // 0.0-1.0
  recallScore    Decimal @map("recall_score") // 0.0-1.0

  // Analysis
  performanceNotes String? @map("performance_notes") @db.Text
  falsePositives   Json?   @map("false_positives") // Array of strings
  falseNegatives   Json?   @map("false_negatives") // Array of strings

  // Timestamp
  testedAt DateTime @default(now()) @map("tested_at")

  caseStudy CaseStudy @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([diagnosisId])
  @@index([testedAt])
  @@map("case_benchmark_results")
}

// B16-S1: Public Dataset Test Harness — Deterministic Calculation Tests
model PublicDataset {
  id          String  @id
  name        String
  datasetType String  @map("dataset_type") // retail|ecommerce|restaurant|saas|marketing|cashflow|inventory|financial_statement
  description String  @db.Text
  rawData     Json    @map("raw_data") // Array of transaction/record objects
  sourceUrl   String? @map("source_url")
  licenseType String  @map("license_type")
  allowedUse  String  @map("allowed_use") @db.Text
  rowCount    Int     @map("row_count")

  createdAt DateTime @default(now()) @map("created_at")

  calculations DatasetCalculation[]

  @@index([datasetType])
  @@index([createdAt])
  @@map("public_datasets")
}

model DatasetCalculation {
  id              String @id
  datasetId       String @map("dataset_id")
  calculationType String @map("calculation_type") // revenue_sum|average_transaction|growth_rate|margin_percent|churn_rate|conversion_rate|inventory_turnover|cash_position
  description     String @db.Text

  // Test definition
  input          Json // { filters?: {...}, parameters?: {...} }
  expectedOutput Json @map("expected_output") // { value: number|string|boolean, tolerance?: number }

  // Test result
  actualOutput Json?    @map("actual_output") // { value: number|string|boolean, calculatedAt: Date }
  passed       Boolean?
  errorMessage String?  @map("error_message") @db.Text

  testedAt        DateTime? @map("tested_at")
  executionTimeMs Int?      @map("execution_time_ms")

  dataset PublicDataset    @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  logs    CalculationLog[]

  @@index([datasetId])
  @@index([calculationType])
  @@index([passed])
  @@index([testedAt])
  @@map("dataset_calculations")
}

model CalculationLog {
  id              String  @id
  calculationId   String  @map("calculation_id")
  executionTimeMs Int     @map("execution_time_ms")
  memoryUsedMb    Int?    @map("memory_used_mb")
  notes           String? @db.Text

  recordedAt DateTime @default(now()) @map("recorded_at")

  calculation DatasetCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  @@index([calculationId])
  @@index([recordedAt])
  @@map("calculation_logs")
}

model PrivateModeAccess {
