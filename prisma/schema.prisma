  ideaId              String   @map("idea_id") @db.Uuid
  objectiveId         String   @map("objective_id") @db.Uuid
  label               String // human-readable initiative name
  scope               String   @db.Text // what is included/excluded
  accountableOwnerId  String   @map("accountable_owner_id") @db.Uuid
  status              String   @default("ACTIVE") @map("status") // ACTIVE | PAUSED | COMPLETED | CANCELLED | SUPERSEDED
  budgetCents         BigInt?  @map("budget_cents")
  approvalDecisionId  String?  @map("approval_decision_id") @db.Uuid // FK → StartupOwnerDecision
  approvalPackageHash String?  @map("approval_package_hash") // snapshot of hash at initiative creation
  createdAt           DateTime @default(now()) @map("created_at")
  createdBy           String   @map("created_by") @db.Uuid
  updatedAt           DateTime @updatedAt @map("updated_at")

  session    OwnerStartupSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  idea       StartupIdeaRecord           @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  blueprints StartupExecutionBlueprint[]

  @@index([workspaceId, sessionId])
  @@index([workspaceId, ideaId])
  @@index([workspaceId, status])
  @@map("startup_initiatives")
}

/// G13/G14: Verification Window — date-bounded period during which initiative outcomes are measured.
model StartupVerificationWindow {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  initiativeId        String    @map("initiative_id") @db.Uuid
  sessionId           String    @map("session_id") @db.Uuid
  ideaId              String    @map("idea_id") @db.Uuid
  windowLabel         String    @map("window_label") // e.g. "Month 1 validation"
  startsAt            DateTime  @map("starts_at")
  endsAt              DateTime  @map("ends_at") // date-bounded — not open-ended
  successCriteria     Json      @default("[]") @map("success_criteria") // string[]
  failureCriteria     Json      @default("[]") @map("failure_criteria") // string[]
  metricsToMeasure    Json      @default("[]") @map("metrics_to_measure") // string[]
  derivationRationale String?   @map("derivation_rationale") @db.Text // how duration was derived
  provisional         Boolean   @default(false) @map("provisional") // true = insufficient timing evidence; owner must verify
  evidenceRequired    Json      @default("[]") @map("evidence_required") // string[] — what must be acquired before window closes
  reassessmentTrigger String?   @map("reassessment_trigger") // condition that should trigger window reassessment
  confidence          Int?      @map("confidence") // 0-100 confidence in duration accuracy
  outcome             String?   @map("outcome") // PASSED | FAILED | INCONCLUSIVE | PENDING
  outcomeRecordedAt   DateTime? @map("outcome_recorded_at")
  outcomeRecordedBy   String?   @map("outcome_recorded_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           String    @map("created_by") @db.Uuid

  @@index([workspaceId, initiativeId])
  @@index([workspaceId, sessionId])
  @@index([workspaceId, endsAt])
  @@map("startup_verification_windows")
}

/// G-ExecutionPlan: Ordered execution plan derived from an approved initiative.
/// Links Initiative → ordered list of tasks extracted from the blueprint.
model StartupExecutionPlan {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  sessionId           String    @map("session_id") @db.Uuid
  ideaId              String    @map("idea_id") @db.Uuid
  initiativeId        String    @unique @map("initiative_id") @db.Uuid // one plan per initiative
  blueprintId         String    @map("blueprint_id") @db.Uuid
  ownerDecisionId     String    @map("owner_decision_id") @db.Uuid
  status              String    @default("DRAFT") @map("status") // DRAFT | ACTIVE | PAUSED | COMPLETED | CANCELLED | SUPERSEDED
  supersededById      String?   @map("superseded_by_id") @db.Uuid // R8: points to the plan that replaced this one
  planVersion         Int       @default(1) @map("plan_version")
  tasks               Json      @default("[]") @map("tasks") // ordered array of {taskId, label, sequenceOrder, dependsOn[], status}
  milestones          Json      @default("[]") @map("milestones") // [{label, targetDate, successCriteria}]
  // G4: Governance fields — execution boundaries
  startDate           DateTime? @map("start_date") // when execution may begin
  targetDate          DateTime? @map("target_date") // completion target
  spendingLimitCents  BigInt?   @map("spending_limit_cents") // hard ceiling per plan
  stopConditions      Json      @default("[]") @map("stop_conditions") // string[] — conditions that must halt execution
  rollbackConditions  Json      @default("[]") @map("rollback_conditions") // string[] — conditions triggering rollback
  approvalPackageHash String?   @map("approval_package_hash") // hash at plan creation — revalidated on every execution action
  approvedAt          DateTime? @map("approved_at")
  approvedBy          String?   @map("approved_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           String    @map("created_by") @db.Uuid
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, sessionId])
  @@index([workspaceId, ideaId])
  @@index([workspaceId, blueprintId])
  @@map("startup_execution_plans")
}

/// G6: StartupIdeaGenerationBatch — persists NEED_OPTIONS generated candidates with full provenance.
/// Candidates are not ideas until the owner accepts them — this record is the authoritative
/// source for what the system proposed, preventing rediscovery without new evidence.
model StartupIdeaGenerationBatch {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String   @map("workspace_id") @db.Uuid
  sessionId        String   @map("session_id") @db.Uuid
  generationMethod String   @map("generation_method") // DOMAIN_HEURISTIC | PROVIDER | STATIC_STUB
  providerStatus   String   @map("provider_status") // NEED_OPTIONS_PROVIDER_AVAILABLE | NEED_OPTIONS_PRODUCTION_PROVIDER_UNAVAILABLE
  profileSnapshot  Json     @default("{}") @map("profile_snapshot") // GenerationProfile at generation time
  evidenceCount    Int      @default(0) @map("evidence_count")
  concepts         Json     @default("[]") @map("concepts") // IdeaGenerationConcept[]
  conceptCount     Int      @default(0) @map("concept_count")
  available        Boolean  @default(false) @map("available") // true if production provider used
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")

  session    OwnerStartupSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  candidates StartupIdeaCandidate[]

  @@index([workspaceId, sessionId])
  @@index([workspaceId, sessionId, createdAt(sort: Desc)])
  @@map("startup_idea_generation_batches")
}

/// G6b: StartupIdeaCandidate — owner's accept/reject decision on a generated concept.
/// Once accepted, creates a governed StartupIdeaRecord. Rejection with rationale prevents
/// rediscovery of the same concept without new evidence.
model StartupIdeaCandidate {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId        String   @map("workspace_id") @db.Uuid
  sessionId          String   @map("session_id") @db.Uuid
  batchId            String   @map("batch_id") @db.Uuid
  conceptIndex       Int      @map("concept_index") // index into batch.concepts[]
  conceptSnapshot    Json     @default("{}") @map("concept_snapshot") // IdeaGenerationConcept at decision time
  decision           String   @map("decision") // ACCEPTED | REJECTED | PENDING
  rejectionRationale String?  @map("rejection_rationale") @db.Text
  acceptedIdeaId     String?  @map("accepted_idea_id") @db.Uuid // FK → startup_idea_records.id when ACCEPTED
  decidedBy          String   @map("decided_by") @db.Uuid
  decidedAt          DateTime @default(now()) @map("decided_at")

  batch StartupIdeaGenerationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, conceptIndex])
  @@index([workspaceId, sessionId])
  @@index([acceptedIdeaId])
  @@map("startup_idea_candidates")
}

// ─── Phase 5: Owner Goal + Trajectory Engine ─────────────────────────────────
// Owner declares a financial goal; system computes trajectory and scores
// recommendations by how many weeks each accelerates goal attainment.
// workspaceId is a plain UUID matching Workspace.id (canonical context).
model OwnerGoal {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId    String               @map("workspace_id") @db.Uuid
  actorId        String               @map("actor_id") @db.Uuid
  targetType     String               @map("target_type") // PROFIT | REVENUE | NET_WORTH | MULTIPLE
  targetAmount   Float                @map("target_amount")
  targetCurrency String               @default("USD") @map("target_currency")
  targetDate     DateTime             @map("target_date")
  baselineAmount Float?               @map("baseline_amount")
  baselineDate   DateTime?            @map("baseline_date")
  status         String               @default("ACTIVE") // ACTIVE | ACHIEVED | REVISED
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  milestones     OwnerGoalMilestone[]

  @@index([workspaceId, status])
  @@map("owner_goals")
}

model OwnerGoalMilestone {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goalId       String    @map("goal_id") @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  description  String
  targetAmount Float?    @map("target_amount")
  targetDate   DateTime  @map("target_date")
  achievedAt   DateTime? @map("achieved_at")
  status       String    @default("pending") // pending | achieved | missed
  createdAt    DateTime  @default(now()) @map("created_at")
  goal         OwnerGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([workspaceId])
  @@map("owner_goal_milestones")
}

// ─── Phase 4: Waste / Leakage Detection ──────────────────────────────────────
// Persistent events for detected operational/financial/quality leakage.
// Each event: detected → investigating → confirmed → recovering → verified.
// Recovery savings are recorded only after owner verification.
// workspaceId is a plain UUID matching Workspace.id (canonical context).
model WasteLeakageEvent {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId          String    @map("workspace_id") @db.Uuid
  category             String // DISCOUNT_LEAK | REWORK | OVERDUE_PAYMENT | UNDERPRICING | IDLE_CAPACITY | SUPPLIER_OVERCHARGE | OTHER
  source               String // finance | operations | quality | supplier | sales
  amount               Float? // estimated monetary impact in workspace currency; null when unknown
  currency             String    @default("USD")
  evidenceId           String?   @map("evidence_id") @db.Uuid // optional link to proof record
  detectedAt           DateTime  @map("detected_at")
  status               String    @default("detected") // detected | investigating | confirmed | recovering | verified | dismissed
  materialityThreshold Float?    @map("materiality_threshold") // owner-configured minimum to act on
  confidenceLevel      String    @default("LOW") @map("confidence_level") // LOW | MEDIUM | HIGH
  recoveryAmount       Float?    @map("recovery_amount") // actual savings once verified
  verifiedAt           DateTime? @map("verified_at")
  verifiedBy           String?   @map("verified_by") @db.Uuid
  dismissalReason      String?   @map("dismissal_reason")
  recurrenceCount      Int       @default(0) @map("recurrence_count")
  description          String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, category])
  @@index([workspaceId, detectedAt])
  @@map("waste_leakage_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// Founder / Owner-Only Real-Business Recovery Mode
// Self-contained models (relations only among themselves). Workspace isolation
// is enforced at the service layer via the workspace_id scalar. These models
// intentionally do NOT reuse the broken Action/verification primitives.
// ─────────────────────────────────────────────────────────────────────────────

model OwnerBusiness {
  id                      String                        @id @db.Uuid
  workspaceId             String                        @map("workspace_id") @db.Uuid
  name                    String
  businessType            String                        @map("business_type")
  location                String?
  currency                String                        @default("INR")
  operatingModel          String?                       @map("operating_model")
  b2cSupported            Boolean                       @default(true) @map("b2c_supported")
  b2bSupported            Boolean                       @default(false) @map("b2b_supported")
  isActive                Boolean                       @default(true) @map("is_active")
  createdBy               String?                       @map("created_by") @db.Uuid
  version                 Int                           @default(1)
  createdAt               DateTime                      @default(now()) @map("created_at")
  updatedAt               DateTime                      @updatedAt @map("updated_at")
  snapshots               OwnerMetricSnapshot[]
  cycles                  RecoveryCycle[]
  financeSnapshots        OwnerFinancialSnapshot[]
  financeCycles           OwnerFinanceCycle[]
  financeFindings         OwnerFinanceFinding[]
  financeActions          OwnerFinanceAction[]
  budgetActions           OwnerBudgetAction[]
  workingCapitalItems     OwnerWorkingCapitalItem[]
  archetypeMetrics        OwnerArchetypeMetric[]
  financeVerifications    OwnerFinanceVerification[]
  cashflowSnapshots       OwnerCashflowSnapshot[]
  cashflowCycles          OwnerCashflowCycle[]
  cashflowFindings        OwnerCashflowFinding[]
  cashflowActions         OwnerCashflowAction[]
  cashflowVerifications   OwnerCashflowVerification[]
  salesSnapshots          OwnerSalesSnapshot[]
  salesCycles             OwnerSalesCycle[]
  salesFindings           OwnerSalesFinding[]
  salesActions            OwnerSalesAction[]
  salesVerifications      OwnerSalesVerification[]
  operationsSnapshots     OwnerOperationsSnapshot[]
  operationsCycles        OwnerOperationsCycle[]
  operationsFindings      OwnerOperationsFinding[]
  operationsActions       OwnerOperationsAction[]
  operationsVerifications OwnerOperationsVerification[]
  sopSnapshots            OwnerSopSnapshot[]
  sopCycles               OwnerSopCycle[]
  sopFindings             OwnerSopFinding[]
  sopActions              OwnerSopAction[]
  sopVerifications        OwnerSopVerification[]
  marketingSnapshots      OwnerMarketingSnapshot[]
  marketingCycles         OwnerMarketingCycle[]
  marketingFindings       OwnerMarketingFinding[]
  marketingActions        OwnerMarketingAction[]
  marketingVerifications  OwnerMarketingVerification[]
  strategySnapshots       OwnerStrategySnapshot[]
  strategyCycles          OwnerStrategyCycle[]
  strategyFindings        OwnerStrategyFinding[]
  strategyActions         OwnerStrategyAction[]
  strategyVerifications   OwnerStrategyVerification[]
  dataIntakes             OwnerDataIntake[]

  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@map("owner_businesses")
}

model OwnerMetricSnapshot {
  id                     String          @id @db.Uuid
  businessId             String          @map("business_id") @db.Uuid
  workspaceId            String          @map("workspace_id") @db.Uuid
  periodStart            DateTime        @map("period_start")
  periodEnd              DateTime        @map("period_end")
  currency               String
  revenue                Float?
  totalCosts             Float?          @map("total_costs")
  grossProfit            Float?          @map("gross_profit")
  netProfit              Float?          @map("net_profit")
  orderCount             Float?          @map("order_count")
  kgProcessed            Float?          @map("kg_processed")
  piecesProcessed        Float?          @map("pieces_processed")
  b2cRevenue             Float?          @map("b2c_revenue")
  b2bRevenue             Float?          @map("b2b_revenue")
  newCustomers           Float?          @map("new_customers")
  repeatCustomers        Float?          @map("repeat_customers")
  dormantContacted       Float?          @map("dormant_contacted")
  averageOrderValue      Float?          @map("average_order_value")
  discountAmount         Float?          @map("discount_amount")
  refundAmount           Float?          @map("refund_amount")
  rewashCount            Float?          @map("rewash_count")
  complaintCount         Float?          @map("complaint_count")
  receivables            Float?
  staffCost              Float?          @map("staff_cost")
  rentCost               Float?          @map("rent_cost")
  utilitiesCost          Float?          @map("utilities_cost")
  materialCost           Float?          @map("material_cost")
  deliveryCost           Float?          @map("delivery_cost")
  marketingSpend         Float?          @map("marketing_spend")
  campaignConversions    Float?          @map("campaign_conversions")
  averageTurnaroundHours Float?          @map("average_turnaround_hours")
  staffProductivity      Float?          @map("staff_productivity")
  notes                  String?
  createdBy              String?         @map("created_by") @db.Uuid
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  business               OwnerBusiness   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cycles                 RecoveryCycle[]

  @@unique([businessId, periodStart, periodEnd])
  @@index([businessId])
  @@index([workspaceId])
  @@map("owner_metric_snapshots")
}

model RecoveryCycle {
  id              String              @id @db.Uuid
  businessId      String              @map("business_id") @db.Uuid
  workspaceId     String              @map("workspace_id") @db.Uuid
  snapshotId      String              @map("snapshot_id") @db.Uuid
  previousCycleId String?             @map("previous_cycle_id") @db.Uuid
  cycleNumber     Int                 @map("cycle_number")
  status          String              @default("open")
  healthStatus    String              @map("health_status")
  healthScore     Float               @map("health_score")
  summary         String?
  createdBy       String?             @map("created_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  business        OwnerBusiness       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  snapshot        OwnerMetricSnapshot @relation(fields: [snapshotId], references: [id])
  previousCycle   RecoveryCycle?      @relation("CycleHistory", fields: [previousCycleId], references: [id])
  nextCycles      RecoveryCycle[]     @relation("CycleHistory")
  findings        RecoveryFinding[]
  actions         RecoveryAction[]

  @@index([businessId])
  @@index([workspaceId])
  @@map("recovery_cycles")
}

model RecoveryFinding {
  id                 String           @id @db.Uuid
  cycleId            String           @map("cycle_id") @db.Uuid
  businessId         String           @map("business_id") @db.Uuid
  workspaceId        String           @map("workspace_id") @db.Uuid
  code               String
  title              String
  sourceMetric       String           @map("source_metric")
  currentValue       Float?           @map("current_value")
  comparisonValue    Float?           @map("comparison_value")
  threshold          Float?
  severity           String
  evidence           String
  whyItMatters       String           @map("why_it_matters")
  impactEstimate     Float?           @map("impact_estimate")
  impactCurrency     String?          @map("impact_currency")
  confidence         Float
  recommendedAction  String           @map("recommended_action")
  verificationMetric String           @map("verification_metric")
  createdAt          DateTime         @default(now()) @map("created_at")
  cycle              RecoveryCycle    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  actions            RecoveryAction[]

  @@index([cycleId])
  @@index([workspaceId])
  @@map("recovery_findings")
}

model RecoveryAction {
  id                     String                 @id @db.Uuid
  cycleId                String                 @map("cycle_id") @db.Uuid
  findingId              String?                @map("finding_id") @db.Uuid
  businessId             String                 @map("business_id") @db.Uuid
  workspaceId            String                 @map("workspace_id") @db.Uuid
  title                  String
  description            String
  assignedToRole         String                 @map("assigned_to_role")
  assignedToUserId       String?                @map("assigned_to_user_id") @db.Uuid
  priority               String
  status                 String                 @default("proposed")
  dueAt                  DateTime?              @map("due_at")
  expectedOutcome        String                 @map("expected_outcome")
  metricToMove           String                 @map("metric_to_move")
  baselineValue          Float?                 @map("baseline_value")
  targetValue            Float?                 @map("target_value")
  verificationWindowDays Int                    @map("verification_window_days")
  effort                 String
  confidence             Float
  completionCriteria     String                 @map("completion_criteria")
  direction              String                 @default("up")
  startedAt              DateTime?              @map("started_at")
  completedAt            DateTime?              @map("completed_at")
  completionNotes        String?                @map("completion_notes")
  actualOutcome          String?                @map("actual_outcome")
  version                Int                    @default(1)
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  cycle                  RecoveryCycle          @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  finding                RecoveryFinding?       @relation(fields: [findingId], references: [id])
  verifications          RecoveryVerification[]

  @@index([cycleId])
  @@index([workspaceId])
  @@index([status])
  @@map("recovery_actions")
}

model RecoveryVerification {
  id                     String         @id @db.Uuid
  actionId               String         @map("action_id") @db.Uuid
  cycleId                String         @map("cycle_id") @db.Uuid
  workspaceId            String         @map("workspace_id") @db.Uuid
  metric                 String
  baselineValue          Float          @map("baseline_value")
  targetValue            Float          @map("target_value")
  afterValue             Float?         @map("after_value")
  direction              String         @default("up")
  verificationWindowDays Int            @map("verification_window_days")
  actualMovement         Float?         @map("actual_movement")
  status                 String         @default("unverified")
  evidence               String?
  verifiedBy             String?        @map("verified_by") @db.Uuid
  verifiedAt             DateTime?      @map("verified_at")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")
  action                 RecoveryAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId])
  @@index([workspaceId])
  @@map("recovery_verifications")
}

// === Module 2 — Financial Intelligence (finance-specific, additive) ===
// Separate from recovery_* tables (per MODULE2_SLICE0_SCHEMA_DECISION_NOTE.md).
// Reuses OwnerBusiness; does not mutate any recovery_* or owner_metric_snapshots.

model OwnerFinancialSnapshot {
  id                  String              @id @db.Uuid
  workspaceId         String              @map("workspace_id") @db.Uuid
  businessId          String              @map("business_id") @db.Uuid
  periodStart         DateTime            @map("period_start")
  periodEnd           DateTime            @map("period_end")
  currency            String
  businessModelType   String?             @map("business_model_type")
  industryTemplate    String?             @map("industry_template")
  revenue             Float?
  costOfGoods         Float?              @map("cost_of_goods")
  fixedCosts          Float?              @map("fixed_costs")
  variableCosts       Float?              @map("variable_costs")
  rent                Float?
  payroll             Float?
  utilities           Float?
  deliveryCost        Float?              @map("delivery_cost")
  marketingSpend      Float?              @map("marketing_spend")
  discountAmount      Float?              @map("discount_amount")
  refundReworkCost    Float?              @map("refund_rework_cost")
  debtPayments        Float?              @map("debt_payments")
  cashOnHand          Float?              @map("cash_on_hand")
  receivables         Float?
  overdueReceivables  Float?              @map("overdue_receivables")
  payables            Float?
  overduePayables     Float?              @map("overdue_payables")
  ownerWithdrawals    Float?              @map("owner_withdrawals")
  inventoryCashLock   Float?              @map("inventory_cash_lock")
  orderCount          Float?              @map("order_count")
  customerCount       Float?              @map("customer_count")
  repeatCustomerCount Float?              @map("repeat_customer_count")
  b2bRevenue          Float?              @map("b2b_revenue")
  b2cRevenue          Float?              @map("b2c_revenue")
  notes               String?
  dataConfidenceScore Float               @map("data_confidence_score")
  missingCriticalData Json                @map("missing_critical_data")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  business            OwnerBusiness       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  cycles              OwnerFinanceCycle[]

  @@unique([businessId, periodStart, periodEnd])
  @@index([workspaceId])
  @@index([businessId])
  @@index([periodEnd])
  @@map("owner_financial_snapshots")
}

model OwnerFinanceCycle {
  id                     String                 @id @db.Uuid
  workspaceId            String                 @map("workspace_id") @db.Uuid
  businessId             String                 @map("business_id") @db.Uuid
  snapshotId             String                 @map("snapshot_id") @db.Uuid
  sequenceNumber         Int                    @map("sequence_number")
  status                 String                 @default("open")
  overallHealthScore     Float                  @map("overall_health_score")
  survivalRiskScore      Float                  @map("survival_risk_score")
  growthOpportunityScore Float                  @map("growth_opportunity_score")
  dataConfidenceScore    Float                  @map("data_confidence_score")
  survivalState          String                 @map("survival_state")
  generatedAt            DateTime               @map("generated_at")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  business               OwnerBusiness          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  snapshot               OwnerFinancialSnapshot @relation(fields: [snapshotId], references: [id])
  findings               OwnerFinanceFinding[]
  actions                OwnerFinanceAction[]

  @@unique([businessId, sequenceNumber])
  @@index([workspaceId])
