generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters", "partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Action {
  id              String      @id @db.Uuid
  engagementId    String      @db.Uuid @map("engagement_id")
  stageId         String?     @db.Uuid @map("stage_id")
  recommendationId String?     @db.Uuid @map("recommendation_id")
  title           String
  description     String?
  status          String
  assignedTo      String?     @db.Uuid @map("assigned_to")
  dueAt           DateTime?   @map("due_at")
  startedAt       DateTime?   @map("started_at")
  completedAt     DateTime?   @map("completed_at")
  verifiedAt      DateTime?   @map("verified_at")
  metadata        Json?
  version         Int         @default(1)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @map("updated_at")
  engagement      Engagement  @relation(fields: [engagementId], references: [id])
  stage           Stage?      @relation(fields: [stageId], references: [id])

  @@index([engagementId])
  @@index([recommendationId])
  @@index([stageId])
  @@index([status])
  @@map("actions")
}

model AIProposalSandbox {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId     String    @db.Uuid @map("workspace_id")
  recommendationId String    @db.Uuid @map("recommendation_id")
  sourceModel     String    @map("source_model")
  confidenceLevel String    @map("confidence_level")
  isApproved      Boolean   @default(false) @map("is_approved")
  approvedBy      String?   @db.Uuid @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  rejectedReason  String?   @map("rejected_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @map("updated_at")

  @@index([isApproved])
  @@index([recommendationId])
  @@index([sourceModel])
  @@index([workspaceId])
  @@map("ai_proposal_sandboxes")
}

model AuditEvent {
  id             String   @id @db.Uuid
  eventName      String   @map("event_name")
  actorId        String?  @db.Uuid @map("actor_id")
  actorType      String   @default("user") @map("actor_type")
  entityType     String?  @map("entity_type")
  entityId       String?  @db.Uuid @map("entity_id")
  payload        Json?
  correlationId  String?  @map("correlation_id")
  visibility     String   @default("internal")
  occurredAt     DateTime @default(now()) @map("occurred_at")
  previousHash   String?  @db.VarChar(64) @map("previous_hash")
  workspaceId    String?  @db.Uuid @map("workspace_id")
  actor          User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([correlationId])
  @@index([entityType, entityId])
  @@index([eventName])
  @@index([occurredAt])
  @@index([workspaceId, occurredAt], map: "idx_audit_events_workspace_occurred_at")
  @@map("audit_events")
}

model BillingAccount {
  id               String        @id @db.Uuid
  workspaceId      String        @unique @db.Uuid @map("workspace_id")
  provider         String        @default("stripe")
  providerCustomerId String       @map("provider_customer_id")
  status           String        @default("active")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @map("updated_at")
  stripeCustomerId String?       @unique(map: "uk_stripe_customer_id") @map("stripe_customer_id")
  subscription     Subscription?

  @@index([status])
  @@map("billing_accounts")
}

model BusinessConditionProfile {
  id                      String     @id @db.Uuid
  engagementId            String     @db.Uuid @map("engagement_id")
  workspaceId             String     @db.Uuid @map("workspace_id")
  businessStatus          String     @map("business_status")
  severityScore           Int        @map("severity_score")
  urgencyLevel            String     @map("urgency_level")
  cashPressureLevel       String     @map("cash_pressure_level")
  marginPressureLevel     String     @map("margin_pressure_level")
  clientConcentrationRisk String     @map("client_concentration_risk")
  ownerDependencyRisk     String     @map("owner_dependency_risk")
  keyPersonDependencyRisk String     @map("key_person_dependency_risk")
  processMaturityLevel    String     @map("process_maturity_level")
  managementMaturityLevel String     @map("management_maturity_level")
  executionCapacityLevel  String     @map("execution_capacity_level")
  moralFragilityLevel     String     @map("morale_fragility_level")
  resilienceLevel         String     @map("resilience_level")
  growthReadinessLevel    String     @map("growth_readiness_level")
  notes                   String?
  assessedBy              String?    @db.Uuid @map("assessed_by")
  conditionScore          Int        @default(50) @map("condition_score")
  ownerHealthScore        Int        @default(50) @map("owner_health_score")
  teamHealthScore         Int        @default(50) @map("team_health_score")
  customerHealthScore     Int        @default(50) @map("customer_health_score")
  financialHealthScore    Int        @default(50) @map("financial_health_score")
  riskFactors             Json       @default("[]") @map("risk_factors")
  strengths               Json       @default("[]") @map("strengths")
  diagnosisId             String?    @db.Uuid @map("diagnosis_id")
  version                 Int        @default(1)
  isCurrent               Boolean    @default(true) @map("is_current")
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @map("updated_at")
  engagement              Engagement @relation(fields: [engagementId], references: [id])

  @@index([engagementId])
  @@index([engagementId, isCurrent])
  @@index([workspaceId])
  @@index([diagnosisId])
  @@map("business_condition_profiles")
}

model CalibrationRecord {
  id              String       @id @db.Uuid
  operatorItemId  String       @db.Uuid @map("operator_item_id")
  predictedImpact Decimal      @db.Decimal(15, 2) @map("predicted_impact")
  actualImpact    Decimal      @db.Decimal(15, 2) @map("actual_impact")
  confidence      Decimal      @db.Decimal(3, 2)
  deviation       Decimal      @db.Decimal(5, 2)
  createdAt       DateTime     @default(now()) @map("created_at")
  operatorItem    OperatorItem @relation(fields: [operatorItemId], references: [id], onDelete: Cascade)

  @@unique([operatorItemId, createdAt])
  @@index([createdAt])
  @@index([operatorItemId])
  @@map("calibration_records")
}

model CanonicalEvent {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  aggregateId               String   @map("aggregate_id")
  aggregateType             String   @map("aggregate_type")
  eventType                 String   @map("event_type")
  eventVersion              Int      @default(1) @map("event_version")
  eventNumber               Int      @map("event_number")
  payload                   Json
  actorId                   String   @db.Uuid @map("actor_id")
  workspaceId               String   @db.Uuid @map("workspace_id")
  causationId               String   @map("causation_id")
  correlationId             String   @map("correlation_id")
  idempotencyKey            String?  @map("idempotency_key")
  visibilityScope           String   @default("internal") @map("visibility_scope")
  sensitivityClassification String   @default("standard") @map("sensitivity_classification")
  occurredAt                DateTime @map("occurred_at")
  recordedAt                DateTime @default(now()) @map("recorded_at")
  createdAt                 DateTime @default(now()) @map("created_at")

  @@unique([idempotencyKey, workspaceId])
  @@unique([aggregateId, aggregateType, workspaceId, eventNumber], map: "unique_event_number_per_aggregate")
  @@index([actorId])
  @@index([aggregateId, aggregateType, workspaceId])
  @@index([workspaceId, eventType])
  @@index([workspaceId, recordedAt])
  @@map("canonical_events")
}

model ClientAccount {
  id             String         @id @db.Uuid
  name           String
  legalName      String?        @map("legal_name")
  industry       String?
  size           String?
  status         String         @default("active")
  website        String?
  address        String?
  notes          String?
  version        Int            @default(1)
  visibility     String         @default("internal")
  createdBy      String?        @db.Uuid @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @map("updated_at")
  archivedAt     DateTime?      @map("archived_at")
  clientContacts ClientContact[]
  engagements    Engagement[]
  leadRecords    LeadRecord[]

  @@index([status])
  @@map("client_accounts")
}

model ClientContact {
  id            String         @id @db.Uuid
  clientId      String         @db.Uuid @map("client_id")
  name          String
  email         String?
  phone         String?
  role          String?
  isPrimary     Boolean        @default(false) @map("is_primary")
  isActive      Boolean        @default(true) @map("is_active")
  notes         String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @map("updated_at")
  clientAccount ClientAccount  @relation(fields: [clientId], references: [id])
  evidenceItems EvidenceItem[]

  @@index([clientId, isActive])
  @@map("client_contacts")
}

model DecisionSnapshot {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  engagementId    String     @db.Uuid @map("engagement_id")
  decisionInput   Json       @map("decision_input")
  decisionOutput  Json       @map("decision_output")
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @db.Timestamp(6) @map("created_at")
  engagement      Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([createdAt], map: "idx_decision_snapshots_created_at")
  @@index([engagementId], map: "idx_decision_snapshots_engagement_id")
  @@map("decision_snapshots")
}

model Deliverable {
  id               String     @id @db.Uuid
  stageId          String     @db.Uuid @map("stage_id")
  engagementId     String     @db.Uuid @map("engagement_id")
  title            String
  description      String?
  status           String     @default("draft")
  version          Int        @default(1)
  submittedBy      String?    @db.Uuid @map("submitted_by")
  submittedAt      DateTime?  @map("submitted_at")
  approvedBy       String?    @db.Uuid @map("approved_by")
  approvedAt       DateTime?  @map("approved_at")
  rejectionReason  String?    @map("rejection_reason")
  createdBy        String?    @db.Uuid @map("created_by")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @map("updated_at")
  engagement       Engagement @relation(fields: [engagementId], references: [id])
  stage            Stage      @relation(fields: [stageId], references: [id])

  @@index([engagementId])
  @@index([stageId])
  @@index([status])
  @@map("deliverables")
}

model EngagementMembership {
  id            String      @id @db.Uuid
  userId        String      @db.Uuid @map("user_id")
  engagementId  String      @db.Uuid @map("engagement_id")
  role          String
  addedBy       String?     @db.Uuid @map("added_by")
  addedAt       DateTime    @default(now()) @map("added_at")
  removedAt     DateTime?   @map("removed_at")
  isActive      Boolean     @default(true) @map("is_active")
  engagement    Engagement  @relation(fields: [engagementId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@unique([userId, engagementId, role])
  @@index([engagementId, isActive])
  @@index([userId, isActive])
  @@map("engagement_memberships")
}

model Engagement {
  id                       String                        @id @db.Uuid
  code                     String                        @unique
  title                    String
  clientId                 String                        @db.Uuid @map("client_id")
  serviceTier              String                        @map("service_tier")
  engagementMode           String                        @map("engagement_mode")
  status                   String                        @default("draft")
  healthStatus             String                        @default("healthy") @map("health_status")
  interventionMode         String                        @default("recovery") @map("intervention_mode")
  interventionPhase        String                        @default("triage") @map("intervention_phase")
  description              String?
  startDate                DateTime?                     @map("start_date")
  targetEndDate            DateTime?                     @map("target_end_date")
  actualEndDate            DateTime?                     @map("actual_end_date")
  ownerId                  String?                       @db.Uuid @map("owner_id")
  assignedConsultantId     String?                       @db.Uuid @map("assigned_consultant_id")
  currentScopeVersionId    String?                       @db.Uuid @map("current_scope_version_id")
  parentEngagementId       String?                       @db.Uuid @map("parent_engagement_id")
  version                  Int                           @default(1)
  visibility               String                        @default("internal")
  createdBy                String?                       @db.Uuid @map("created_by")
  createdAt                DateTime                      @default(now()) @map("created_at")
  updatedAt                DateTime                      @map("updated_at")
  isBlocked                Boolean                       @default(false) @map("is_blocked")
  blockerReason            String?                       @map("blocker_reason")
  blockedAt                DateTime?                     @map("blocked_at")
  workspaceId              String?                       @db.Uuid @map("workspace_id")
  actions                  Action[]
  businessConditionProfiles BusinessConditionProfile[]
  decisionSnapshots        DecisionSnapshot[]
  deliverables             Deliverable[]
  engagementMemberships    EngagementMembership[]
  clientAccount            ClientAccount                 @relation(fields: [clientId], references: [id])
  parentEngagement         Engagement?                   @relation("engagementsToengagements", fields: [parentEngagementId], references: [id], onDelete: Restrict)
  childEngagements         Engagement[]                  @relation("engagementsToengagements")
  workspace                Workspace?                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  evidence                 Evidence[]
  evidenceBundles          EvidenceBundle[]
  evidenceItems            EvidenceItem[]
  findings                 Finding[]
  interventionStates       InterventionState?
  kpis                     KPI[]
  leadRecords              LeadRecord[]
  recommendations          Recommendation[]
  risks                    Risk[]
  shockEvents              ShockEvent[]
  stages                   Stage[]

  @@index([clientId])
  @@index([isBlocked])
  @@index([ownerId])
  @@index([parentEngagementId])
  @@index([status])
  @@map("engagements")
}

model Entity {
  id         String       @id @db.Uuid
  name       String
  type       String
  externalId String?      @map("external_id")
  createdBy  String       @db.Uuid @map("created_by")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @map("updated_at")
  creator    User         @relation(fields: [createdBy], references: [id])
  entityLinks EntityLink[]

  @@index([createdBy])
  @@index([externalId])
  @@index([type])
  @@map("entities")
}

model EntityLink {
  id            String       @id @db.Uuid
  entityId      String       @db.Uuid @map("entity_id")
  operatorItemId String       @db.Uuid @map("operator_item_id")
  linkType      String
  createdAt     DateTime     @default(now()) @map("created_at")
  entity        Entity       @relation(fields: [entityId], references: [id], onDelete: Cascade)
  operatorItem  OperatorItem @relation(fields: [operatorItemId], references: [id], onDelete: Cascade)

  @@unique([entityId, operatorItemId])
  @@index([operatorItemId])
  @@map("entity_links")
}

model Evidence {
  id               String       @id @db.Uuid
  engagementId     String       @db.Uuid @map("engagement_id")
  stageId          String?      @db.Uuid @map("stage_id")
  title            String
  description      String
  source           String
  status           String
  evidenceType     String?      @map("evidence_type")
  severityRating   String?      @map("severity_rating")
  collectedAt      DateTime?    @map("collected_at")
  validatedAt      DateTime?    @map("validated_at")
  rejectionReason  String?      @map("rejection_reason")
  metadata         Json?
  submittedBy      String?      @db.Uuid @map("submitted_by")
  validatedBy      String?      @db.Uuid @map("validated_by")
  version          Int          @default(1)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @map("updated_at")
  engagement       Engagement   @relation(fields: [engagementId], references: [id])
  stage            Stage?       @relation(fields: [stageId], references: [id])
  findings         Finding[]

  @@index([engagementId])
  @@index([stageId])
  @@index([status])
  @@map("evidence")
}

model EvidenceBundleItem {
  id             String         @id @db.Uuid
  bundleId       String         @db.Uuid @map("bundle_id")
  evidenceItemId String         @db.Uuid @map("evidence_item_id")
  addedBy        String?        @db.Uuid @map("added_by")
  addedAt        DateTime       @default(now()) @map("added_at")
  removedAt      DateTime?      @map("removed_at")
  evidenceBundle EvidenceBundle @relation(fields: [bundleId], references: [id])
  evidenceItem   EvidenceItem   @relation(fields: [evidenceItemId], references: [id])

  @@unique([bundleId, evidenceItemId])
  @@index([bundleId])
  @@index([evidenceItemId])
  @@map("evidence_bundle_items")
}

model EvidenceBundle {
  id                  String             @id @db.Uuid
  engagementId        String             @db.Uuid @map("engagement_id")
  title               String
  description         String?
  status              String             @default("active")
  createdBy           String?            @db.Uuid @map("created_by")
  version             Int                @default(1)
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @map("updated_at")
  evidenceBundleItems EvidenceBundleItem[]
  engagement          Engagement         @relation(fields: [engagementId], references: [id])

  @@index([engagementId])
  @@index([status])
  @@map("evidence_bundles")
}

model EvidenceItem {
  id                  String             @id @db.Uuid
  engagementId        String             @db.Uuid @map("engagement_id")
  category            evidence_category
  evidenceType        evidence_type      @map("evidence_type")
  sourceType          evidence_source_type @map("source_type")
  sourceLabel         String             @map("source_label")
  sourceContactId     String?            @db.Uuid @map("source_contact_id")
  captureMethod       evidence_capture_method @map("capture_method")
  title               String
  description         String?
  content             String?
  validationStatus    evidence_validation_status @default(PENDING) @map("validation_status")
  traceabilityStatus  evidence_traceability_status @map("traceability_status")
  visibility          evidence_visibility @default(INTERNAL)
  createdBy           String?            @db.Uuid @map("created_by")
  version             Int                @default(1)
  capturedAt          DateTime           @map("captured_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @map("updated_at")
  evidenceBundleItems EvidenceBundleItem[]
  engagement          Engagement         @relation(fields: [engagementId], references: [id])
  sourceContact       ClientContact?     @relation(fields: [sourceContactId], references: [id])
  fileBlob            FileBlob?

  @@index([category])
  @@index([engagementId])
  @@index([validationStatus])
  @@index([visibility])
  @@map("evidence_items")
}

model FileBlob {
  id            String       @id @db.Uuid
  evidenceItemId String       @unique @db.Uuid @map("evidence_item_id")
  fileName      String       @map("file_name")
  mimeType      String       @map("mime_type")
  sizeBytes     BigInt       @map("size_bytes")
  storageKey    String       @map("storage_key")
  createdBy     String?      @db.Uuid @map("created_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  evidenceItem  EvidenceItem @relation(fields: [evidenceItemId], references: [id])

  @@index([evidenceItemId])
  @@map("file_blobs")
}

model FinancialBaseline {
  id            String   @id @db.Uuid
  engagementId  String?  @db.Uuid @map("engagement_id")
  revenue       Decimal  @db.Decimal(15, 2)
  costs         Decimal  @db.Decimal(15, 2)
  currency      String   @default("USD")
  source        String
  assumptions   Json
  createdBy     String   @db.Uuid @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  validUntil    DateTime? @map("valid_until")
  creator       User     @relation(fields: [createdBy], references: [id])

  @@index([engagementId])
  @@index([source])
  @@map("financial_baselines")
}

model Finding {
  id               String         @id @db.Uuid
  engagementId     String         @db.Uuid @map("engagement_id")
  stageId          String?        @db.Uuid @map("stage_id")
  primaryEvidenceId String         @db.Uuid @map("primary_evidence_id")
  title            String
  summary          String
  severity         String
  impactArea       String         @map("impact_area")
  status           String         @default("identified")
  confidenceScore  Float?         @map("confidence_score")
  priorityScore    Float?         @map("priority_score")
  hypothesis       String?
  rootCause        String?        @map("root_cause")
  consequence      String?
  ownerId          String?        @db.Uuid @map("owner_id")
  dueAt            DateTime?      @map("due_at")
  validatedAt      DateTime?      @map("validated_at")
  resolvedAt       DateTime?      @map("resolved_at")
  dismissedAt      DateTime?      @map("dismissed_at")
  metadata         Json?
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @map("updated_at")
  archivedAt       DateTime?      @map("archived_at")
  engagement       Engagement     @relation(fields: [engagementId], references: [id])
  evidence         Evidence       @relation(fields: [primaryEvidenceId], references: [id])
  stage            Stage?         @relation(fields: [stageId], references: [id])
  recommendations  Recommendation[]

  @@index([archivedAt])
  @@index([engagementId])
  @@index([engagementId, severity])
  @@index([engagementId, status])
  @@index([primaryEvidenceId])
  @@index([severity])
  @@index([stageId])
  @@index([status])
  @@map("findings")
}

model IdempotencyRecord {
  id              String    @id @db.Uuid
  idempotencyKey  String    @unique @map("idempotency_key")
  operationName   String    @map("operation_name")
  status          String    @default("pending")
  responseCode    Int?      @map("response_code")
  responseBody    Json?     @map("response_body")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")
  expiresAt       DateTime  @map("expires_at")
  payload         String?

  @@index([expiresAt])
  @@index([idempotencyKey])
  @@map("idempotency_records")
}

model InterventionState {
  id             String     @id @db.Uuid
  engagementId   String     @unique @db.Uuid @map("engagement_id")
  currentPhase   String     @map("current_phase")
  previousPhase  String?    @map("previous_phase")
  version        Int        @default(1)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @map("updated_at")
  engagement     Engagement @relation(fields: [engagementId], references: [id])

  @@index([engagementId])
  @@map("intervention_states")
}

model KPISnapshot {
  id         String   @id @db.Uuid
  kpiId      String   @db.Uuid @map("kpi_id")
  value      Float
  recordedAt DateTime @default(now()) @map("recorded_at")
  recordedBy String?  @db.Uuid @map("recorded_by")
  kpi        KPI      @relation(fields: [kpiId], references: [id])

  @@index([kpiId])
  @@index([recordedAt])
  @@map("kpi_snapshots")
}

model KPI {
  id              String        @id @db.Uuid
  engagementId    String        @db.Uuid @map("engagement_id")
  name            String
  description     String?
  target          Float?
  currentValue    Float?        @map("current_value")
  measurementDate DateTime?     @map("measurement_date")
  direction       String        @default("up")
  version         Int           @default(1)
  createdBy       String?       @db.Uuid @map("created_by")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @map("updated_at")
  kpiSnapshots    KPISnapshot[]
  engagement      Engagement    @relation(fields: [engagementId], references: [id])

  @@index([engagementId])
  @@map("kpis")
}

model LeadRecord {
  id                  String         @id @db.Uuid
  companyName         String         @map("company_name")
  contactName         String?        @map("contact_name")
  contactEmail        String?        @map("contact_email")
  contactPhone        String?        @map("contact_phone")
  source              String?
  status              String         @default("new")
  notes               String?
  estimatedValue      Float?         @map("estimated_value")
  convertedToClientId String?        @db.Uuid @map("converted_to_client_id")
  engagementId        String?        @db.Uuid @map("engagement_id")
  assignedTo          String?        @db.Uuid @map("assigned_to")
  createdBy           String?        @db.Uuid @map("created_by")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @map("updated_at")
  clientAccount       ClientAccount? @relation(fields: [convertedToClientId], references: [id], onDelete: Restrict, map: "lead_records_client_id_fkey")
