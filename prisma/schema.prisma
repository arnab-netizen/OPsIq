model Proof {
  id                  String    @id @db.Uuid
  workspaceId         String    @map("workspace_id") @db.Uuid
  businessId          String?   @map("business_id") @db.Uuid
  taskId              String?   @map("task_id") @db.Uuid
  proofRequirementId  String?   @map("proof_requirement_id") @db.Uuid
  proofType           String    @map("proof_type")
  status              String    @default("REQUIRED")
  submittedByUserId   String?   @map("submitted_by_user_id") @db.Uuid
  fileHash            String?   @map("file_hash")
  duplicateFlagged    Boolean   @default(false) @map("duplicate_flagged")
  tamperSuspected     Boolean   @default(false) @map("tamper_suspected")
  // Server-trusted time the operator was dispatched / marked work started for this proof's job.
  // Nullable + backfill-safe: legacy rows are null → the fast-completion signal treats them as
  // TIMING_MISSING (fail-visible), never fabricating a start time. Paired with submittedAt this
  // yields a trusted measured duration (never inferred from user-supplied text).
  workStartedAt       DateTime? @map("work_started_at")
  submittedAt         DateTime? @map("submitted_at")
  reviewReason        String?   @map("review_reason")
  reviewedByUserId    String?   @map("reviewed_by_user_id") @db.Uuid
  reviewedAt          DateTime? @map("reviewed_at")
  resubmissionOfId    String?   @map("resubmission_of_id") @db.Uuid
  ownerOverrideStatus String?   @map("owner_override_status")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @map("updated_at")

  @@index([workspaceId, status])
  @@index([workspaceId, fileHash])
  @@index([workspaceId, businessId])
  @@index([workspaceId, tamperSuspected])
  @@map("proofs")
}

/// Governed owner/reviewer decision about a flagged proof-risk finding (reused-hash, fake/suspicious
/// anti-gaming signal, reused-proof credibility concern, or a suspicious/fake proof dispute). It
/// records the decision fairly and auditably — it does NOT accuse fraud/theft, hold a hidden score,
/// delete evidence, or rewrite proof status (that stays in the governed dispute flow). The unique
/// (workspace_id, idempotency_key) makes repeated submission idempotent. Additive, backfill-safe.
model ProofRiskAdjudication {
  id                    String   @id @db.Uuid
  workspaceId           String   @map("workspace_id") @db.Uuid
  idempotencyKey        String   @map("idempotency_key")
  sourceType            String   @map("source_type") // REUSED_HASH_FINDING | ANTI_GAMING_SIGNAL | CREDIBILITY_CONCERN | PROOF_DISPUTE
  sourceRef             String   @map("source_ref")
  proofIds              String[] @map("proof_ids") @db.Uuid
  actorIds              String[] @map("actor_ids") @db.Uuid
  adjudicatedByUserId   String?  @map("adjudicated_by_user_id") @db.Uuid
  adjudicatedByRole     String?  @map("adjudicated_by_role")
  outcome               String // REQUIRE_FRESH_PROOF | ACCEPT_AS_VALID | DISMISS_FALSE_POSITIVE | CONFIRM_SUSPICIOUS_PATTERN | ESCALATE_FOR_TRAINING | ESCALATE_FOR_OWNER_REVIEW | MARK_INCONCLUSIVE_NEEDS_DATA
  reason                String   @db.Text
  ownerActionRequired   Boolean  @default(false) @map("owner_action_required")
  recommendedNextAction String   @map("recommended_next_action")
  status                String   @default("ACTIVE") // ACTIVE | CLEARED | CONFIRMED | INCONCLUSIVE | TRAINING | OWNER_REVIEW
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @map("updated_at")

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, sourceType])
  @@map("proof_risk_adjudications")
}

/// Structured external opportunity signal — a REAL owner/manager/system-submitted opportunity lead that
/// feeds the External Opportunity Intelligence loop (classify → dedupe → tender-screen → promote) live,
/// instead of only DB-sim/injected data. Controlled structured intake only: OpsIQ never scrapes, contacts
/// anyone, auto-submits a tender, or spends. Qualitative bands are the submitter's own honest assessment;
/// numeric value/exposure are stored for the record only and are never turned into profit/impact.
model ExternalOpportunitySignal {
  id                       String    @id @db.Uuid
  workspaceId              String    @map("workspace_id") @db.Uuid
  idempotencyKey           String    @map("idempotency_key")
  dedupeKey                String    @map("dedupe_key")
  rawSignalType            String    @map("raw_signal_type")
  sourceName               String?   @map("source_name")
  sourceChannel            String?   @map("source_channel")
  sourceRef                String?   @map("source_ref")
  submittedByUserId        String?   @map("submitted_by_user_id") @db.Uuid
  submittedByRole          String?   @map("submitted_by_role")
  rawDescription           String    @map("raw_description") @db.Text
  extractedBusinessNeed    String?   @map("extracted_business_need") @db.Text
  targetCustomerSegment    String?   @map("target_customer_segment")
  locationContext          String?   @map("location_context")
  deadlineAt               DateTime? @map("deadline_at")
  tenderOrProcurementValue Float?    @map("tender_or_procurement_value")
  eligibilityRequirements  String?   @map("eligibility_requirements") @db.Text
  complianceRequirements   String?   @map("compliance_requirements") @db.Text
  estimatedCashExposure    Float?    @map("estimated_cash_exposure")
  cashExposureBand         String    @default("UNKNOWN") @map("cash_exposure_band")
  relevanceBand            String    @default("MODERATE") @map("relevance_band")
  ownerWorkloadBand        String    @default("LOW") @map("owner_workload_band")
  ownerWorkloadNotes       String?   @map("owner_workload_notes") @db.Text
  hasUnitEconomics         Boolean   @default(false) @map("has_unit_economics")
  sourceQuality            String    @default("UNKNOWN") @map("source_quality")
  requiredDocuments        String[]  @map("required_documents")
  missingDocuments         String[]  @map("missing_documents")
  discoveredAt             DateTime? @map("discovered_at")
  lastVerifiedAt           DateTime? @map("last_verified_at")
  staleAfterDays           Int?      @map("stale_after_days")
  evidenceRefs             String[]  @map("evidence_refs")
  missingData              String[]  @map("missing_data")
  initialStatus            String    @map("initial_status") // RAW | NEEDS_DATA | CANDIDATE | PARKED | REJECTED | DUPLICATE | IRRELEVANT
  classification           String    @map("classification")
  status                   String    @default("ACTIVE") @map("status") // ACTIVE | ARCHIVED
  /// Phase 4: optional link to BusinessObjective this opportunity serves
  linkedObjectiveId        String?   @map("linked_objective_id") @db.Uuid
  submittedAt              DateTime  @default(now()) @map("submitted_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @default(now()) @map("updated_at")

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status])
  @@map("external_opportunity_signals")
}

/// Persisted validation-experiment outcome — what actually happened when an opportunity was tested, so the
/// live Opportunity Portfolio can move past NOT_STARTED and make real kill/park/scale-candidate decisions on
/// evidence. Governance: PASSED requires evidence (else INCONCLUSIVE); a stop-loss trigger can never be a
/// PASS; scaling stays gated behind PASSED + safe guardrails + owner approval; no fabricated revenue/
/// conversion/profit. Numeric fields are the owner's recorded results, never invented. Additive, non-
/// destructive; UNIQUE (workspace_id, idempotency_key) makes re-recording idempotent.
model OpportunityValidationOutcome {
  id                      String    @id @db.Uuid
  workspaceId             String    @map("workspace_id") @db.Uuid
  idempotencyKey          String    @map("idempotency_key")
  experimentKey           String    @map("experiment_key")
  opportunityKey          String    @map("opportunity_key")
  status                  String // NOT_STARTED | RUNNING | COMPLETED | CANCELLED | NEEDS_DATA
  result                  String // PASSED | FAILED | INCONCLUSIVE | NOT_EVALUATED
  startedAt               DateTime? @map("started_at")
  completedAt             DateTime? @map("completed_at")
  actualCost              Float?    @map("actual_cost")
  actualOwnerTimeMinutes  Int?      @map("actual_owner_time_minutes")
  leadsGenerated          Int?      @map("leads_generated")
  responses               Int?      @map("responses")
  conversions             Int?      @map("conversions")
  revenueEvidence         String?   @map("revenue_evidence") @db.Text
  marginEvidence          String?   @map("margin_evidence") @db.Text
  customerFeedback        String?   @map("customer_feedback") @db.Text
  operationalIssues       String?   @map("operational_issues") @db.Text
  cashImpactNotes         String?   @map("cash_impact_notes") @db.Text
  proofEvidenceRefs       String[]  @map("proof_evidence_refs")
  successMetricResult     String?   @map("success_metric_result") @db.Text
  failureMetricResult     String?   @map("failure_metric_result") @db.Text
  stopLossTriggered       Boolean   @default(false) @map("stop_loss_triggered")
  ownerVisibleSummary     String    @map("owner_visible_summary") @db.Text
  nextRecommendedDecision String    @map("next_recommended_decision") // KILL | PARK | MODIFY | RETEST | SCALE_CANDIDATE | NEEDS_DATA
  approvalLevel           String    @map("approval_level")
  recordedByUserId        String?   @map("recorded_by_user_id") @db.Uuid
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @default(now()) @map("updated_at")

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, opportunityKey])
  @@map("opportunity_validation_outcomes")
}

/// Governed opportunity execution task — the trackable, delegated unit of work derived from an opportunity's
/// prep checklist / tender readiness / proof-pack / validation action / portfolio decision, with an action
/// owner and completion evidence. OpsIQ only drafts/recommends: it never submits a tender, contacts a
/// customer, spends, signs, or certifies. Owner-approval tasks can never be auto-completed; evidence-required
/// tasks cannot COMPLETE without evidence. Additive, non-destructive; UNIQUE (workspace_id, task_key) makes
/// updates idempotent per task.
model OpportunityExecutionTask {
  id                String    @id @db.Uuid
  workspaceId       String    @map("workspace_id") @db.Uuid
  taskKey           String    @map("task_key")
  opportunityKey    String    @map("opportunity_key")
  sourceType        String    @map("source_type")
  sourceKey         String    @map("source_key")
  taskType          String    @map("task_type")
  nextActionOwner   String    @map("next_action_owner")
  status            String    @default("PROPOSED")
  approvalLevel     String    @map("approval_level")
  evidenceRefs      String[]  @map("evidence_refs")
  linkedProofIds    String[]  @map("linked_proof_ids") @db.Uuid
  blockingReason    String?   @map("blocking_reason") @db.Text
  outcomeSummary    String?   @map("outcome_summary") @db.Text
  completedByUserId String?   @map("completed_by_user_id") @db.Uuid
  completedByRole   String?   @map("completed_by_role")
  completedAt       DateTime? @map("completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @default(now()) @map("updated_at")

  @@unique([workspaceId, taskKey])
  @@index([workspaceId, opportunityKey])
  @@map("opportunity_execution_tasks")
}

/// Process-Correction Execution Bridge (PASS 20) — persists the governed execution route derived from a
/// process-intelligence / cash-profit cockpit finding, so a diagnosis becomes a trackable task with an owner,
/// approval level, required evidence, completion state, and a reassessment link. Distinct entity from
/// OpportunityExecutionTask (process findings are not opportunities). Governance enforced in code: owner-approval
/// tasks can never be auto-completed; evidence-required routes cannot COMPLETE without evidence; a completed
/// task links to the reassessment it triggered. UNIQUE (workspace_id, task_key) makes updates idempotent.
model ProcessExecutionTask {
  id                       String    @id @db.Uuid
  workspaceId              String    @map("workspace_id") @db.Uuid
  taskKey                  String    @map("task_key")
  sourceFamily             String    @map("source_family")
  sourceFindingKey         String    @map("source_finding_key")
  executionRoute           String    @map("execution_route")
  actionOwner              String    @map("action_owner")
  approvalLevel            String    @map("approval_level")
  status                   String    @default("PROPOSED")
  requiredEvidence         String[]  @map("required_evidence")
  evidenceRefs             String[]  @map("evidence_refs")
  completionCriteria       String    @map("completion_criteria") @db.Text
  reassessmentTrigger      String    @map("reassessment_trigger") @db.Text
  riskIfIgnored            String    @map("risk_if_ignored") @db.Text
  ownerVisibleSummary      String    @map("owner_visible_summary") @db.Text
  severity                 String
  priorityRank             Int       @map("priority_rank")
  notes                    String?   @db.Text
  completedByUserId        String?   @map("completed_by_user_id") @db.Uuid
  completedByRole          String?   @map("completed_by_role")
  completedAt              DateTime? @map("completed_at")
  reassessmentId           String?   @map("reassessment_id") @db.Uuid
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @default(now()) @map("updated_at")
  // Phase 3 — lifecycle timestamps
  workStartedAt            DateTime? @map("work_started_at")
  acknowledgedByUserId     String?   @map("acknowledged_by_user_id") @db.Uuid
  acknowledgedAt           DateTime? @map("acknowledged_at")
  // Phase 3 — structured execution plan fields
  expectedBenefit          String?   @map("expected_benefit") @db.Text
  costEstimate             Decimal?  @map("cost_estimate") @db.Decimal(14, 2)
  baselineMetricName       String?   @map("baseline_metric_name")
  baselineValue            Float?    @map("baseline_value")
  targetMetricName         String?   @map("target_metric_name")
  targetValue              Float?    @map("target_value")
  verificationWindowDays   Int?      @map("verification_window_days")
  stopCondition            String?   @map("stop_condition") @db.Text
  rollbackCondition        String?   @map("rollback_condition") @db.Text
  // Phase 3 — outcome linkage (cuid() on OwnerActionOutcome — no @db.Uuid)
  outcomeId                String?   @map("outcome_id")
  outcomeRecordedAt        DateTime? @map("outcome_recorded_at")
  // Phase 3 — approval binding
  approvalMemoryId         String?   @map("approval_memory_id") @db.Uuid
  // G3: Startup Mode link fields — populated for sourceFamily=STARTUP_MODE tasks; NULL for all other tasks
  linkedStartupSessionId   String?   @map("linked_startup_session_id") @db.Uuid
  linkedStartupBlueprintId String?   @map("linked_startup_blueprint_id") @db.Uuid
  linkedStartupPlanId      String?   @map("linked_startup_plan_id") @db.Uuid

  @@unique([workspaceId, taskKey])
  @@index([workspaceId, status])
  @@index([workspaceId, outcomeId])
  @@index([workspaceId, linkedStartupSessionId])
  @@map("process_execution_tasks")
}

/// Phase 3 — Immutable structured progress history for a ProcessExecutionTask.
/// Each progress update creates a new row. Rows are never mutated after creation.
model ProcessExecutionTaskProgress {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  taskId        String    @map("task_id") @db.Uuid
  actorId       String    @map("actor_id") @db.Uuid
  progressPct   Int?      @map("progress_pct")
  stage         String?
  note          String?   @db.Text
  evidenceRef   String?   @map("evidence_ref")
  blockerActive Boolean   @default(false) @map("blocker_active")
  blockerReason String?   @map("blocker_reason") @db.Text
  nextStep      String?   @map("next_step") @db.Text
  revisedDueAt  DateTime? @map("revised_due_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, taskId])
  @@index([workspaceId, taskId, createdAt])
  @@map("process_execution_task_progress")
}

/// Minimal per-event operational complaint/rework record (one generic model handles both via
/// eventType — no ambiguity). Links accepted proof to the real complaint/rework that contradicted
/// it so the business impact of bad accepted work becomes measurable. Deliberately NOT a CRM/
/// ticketing/refund/customer-profile model. createdAt is the server-trusted time; occurredAt is
/// the (untrusted) user-reported time.
model OperationalEvent {
  id                    String    @id @db.Uuid
  workspaceId           String    @map("workspace_id") @db.Uuid
  eventType             String    @map("event_type") // COMPLAINT | REWORK
  relatedProofId        String?   @map("related_proof_id") @db.Uuid
  relatedActionId       String?   @map("related_action_id") @db.Uuid
  businessId            String?   @map("business_id") @db.Uuid
  category              String
  severity              String    @default("MEDIUM")
  status                String    @default("OPEN") // OPEN | IN_REVIEW | RESOLVED | DISMISSED | DUPLICATE
  source                String    @default("owner") // owner | manager | staff | customer_reported | system
  description           String    @db.Text
  reportedByUserId      String?   @map("reported_by_user_id") @db.Uuid
  occurredAt            DateTime? @map("occurred_at")
  resolvedAt            DateTime? @map("resolved_at")
  resolvedByUserId      String?   @map("resolved_by_user_id") @db.Uuid
  resolutionNote        String?   @map("resolution_note") @db.Text
  outcome               String? // RESOLVED_FIXED | DISMISSED_NOT_VALID | DUPLICATE | ...
  estimatedImpactAmount Float?    @map("estimated_impact_amount")
  impactCurrency        String?   @map("impact_currency")
  impactConfidence      String    @default("NEEDS_DATA") @map("impact_confidence") // MEASURED | ESTIMATED | NEEDS_DATA
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @map("updated_at")

  @@index([workspaceId, eventType])
  @@index([workspaceId, relatedProofId])
  @@map("operational_events")
}

model Escalation {
  id             String    @id @db.Uuid
  workspaceId    String    @map("workspace_id") @db.Uuid
  taskId         String?   @map("task_id") @db.Uuid
  category       String
  severity       String
  assignedTarget String    @map("assigned_target")
  status         String    @default("OPEN")
  createdBy      String?   @map("created_by") @db.Uuid
  dueAt          DateTime? @map("due_at")
  // Server-trusted acknowledgement timing — set when the assigned manager/owner first acknowledges
  // (OPEN → ACKNOWLEDGED/IN_REVIEW). Nullable + backfill-safe: legacy rows are null. Combined with
  // dueAt/resolvedAt this yields trusted ack/resolution latency for the manager-ignores-escalation
  // signal (never inferred from user-supplied text; a null ack past dueAt = unacknowledged).
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedBy String?   @map("acknowledged_by") @db.Uuid
  resolutionNote String?   @map("resolution_note")
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  resolvedAt     DateTime? @map("resolved_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, status])
  @@index([workspaceId, assignedTarget])
  @@map("escalations")
}

