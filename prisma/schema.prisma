model OwnerActionOutcome {
  id                       String        @id @default(cuid())
  workspaceId              String        @db.Uuid
  businessId               String
  recommendationId         String?
  actionId                 String?
  outcomeStatus            String // worked | partially_worked | did_not_work | made_worse | not_measurable | too_early_to_judge | invalid_test | executed_differently | external_event_interference
  ownerReportedResult      String?       @db.Text
