  workspaceId            String              @map("workspace_id") @db.Uuid
  ownerUserId            String?             @map("owner_user_id") @db.Uuid
  createdByUserId        String?             @map("created_by_user_id") @db.Uuid
  lastUpdatedByUserId    String?             @map("last_updated_by_user_id") @db.Uuid
  assignedToUserId       String?             @map("assigned_to_user_id") @db.Uuid
  reviewedByUserId       String?             @map("reviewed_by_user_id") @db.Uuid
  recommendationId       String?             @map("recommendation_id") @db.Uuid
  problem                String
  action                 String
  impactExpected         Float
  impactLow              Float
  impactHigh             Float
  confidence             Float
  priorityScore          Float
  status                 String              @default("pending")
  dueAt                  DateTime?           @map("due_at")
  expectedOutcome        String?             @map("expected_outcome")
  actualOutcome          String?             @map("actual_outcome")
  explanation            Json?
  decisionHash           String?             @map("decision_hash")
  engineVersion          String              @default("v1.0.0") @map("engine_version")
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @map("updated_at")
  signature              String?
  signatureAlgo          String?             @map("signature_algo")
  publicKeyId            String?             @map("public_key_id")
  blockingDependencies   Json?               @map("blocking_dependencies")
  inputsSnapshot         Json?               @map("inputs_snapshot")
  signedHash             String?             @map("signed_hash")
  actualOutcomeValue     Float?              @map("actual_outcome_value")
  outcomeNotes           String?             @map("outcome_notes")
  startedAt              DateTime?           @map("started_at")
  completedAt            DateTime?           @map("completed_at")
  executionStatus        String              @default("not_started") @map("execution_status")
  completedBy            String?             @map("completed_by") @db.Uuid
  verifiedBy             String?             @map("verified_by") @db.Uuid
  blockStage             String?             @map("block_stage")
  blockReason            String?             @map("block_reason")
  controlLayerViolations Json?               @map("control_layer_violations")
  gateResult             Json?               @map("gate_result")
  guardrailResult        Json?               @map("guardrail_result")
  verificationStatus     String              @default("unverified") @map("verification_status")
  verificationMethod     String?             @map("verification_method")
  verificationEvidence   Json?               @map("verification_evidence")
  verificationConfidence Float?              @map("verification_confidence")
  verifiedAt             DateTime?           @map("verified_at")
  auditTrail             Json?               @map("audit_trail")
  calibrationRecords     CalibrationRecord[]
  entityLinks            EntityLink[]
  completedByUser        User?               @relation("operator_items_completed_byTousers", fields: [completedBy], references: [id])
  createdByUser          User?               @relation("operator_items_created_by_user_idTousers", fields: [createdByUserId], references: [id], onDelete: Restrict, map: "operator_items_created_by_fkey")
  verifiedByUser         User?               @relation("operator_items_verified_byTousers", fields: [verifiedBy], references: [id])
  recommendation         Recommendation?     @relation(fields: [recommendationId], references: [id])
  approvalRequests       ApprovalRequest[]
  overrideRecords        OverrideRecord[]
  webhookDeliveries      WebhookDelivery[]

  @@index([blockStage])
  @@index([createdAt])
  @@index([createdByUserId], map: "operator_items_created_by_idx")
  @@index([decisionHash])
  @@index([executionStatus])
  @@index([priorityScore], map: "operator_items_priority_score_idx")
  @@index([publicKeyId])
  @@index([signedHash])
  @@index([status])
  @@index([workspaceId, blockStage], map: "operator_items_workspace_block_stage_idx")
  @@map("operator_items")
}

