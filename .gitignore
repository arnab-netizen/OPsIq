# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment files - never commit real secrets
.env
.env.local
.env.test
.env.development
.env.production
.env.staging
.env.*.local

# Keep examples/templates tracked
!.env.example
!.env.sample
!.env.template

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# uploads (local storage dev)
/uploads
test.db
*.db

# v8 reference architecture (not for production)
/v8

# asymmetric signing keys (sensitive - never commit)
/.keys/
.claude/worktrees/

# Playwright artifacts
test-results/
playwright-report/
dbenv.sh

# Generated simulation run outputs (produced by test/simulation harnesses)
*.run.json

# Runtime harness logs (produced by scripts/phase-e-runtime-harness.sh and similar)
/logs/

# Local benchmark/hardening-baseline scratch output (regeneratable, not a fixture)
/artifacts/

# Production acceptance test evidence output (tests/production/helpers/evidence.ts writes here)
/production-test-results/

# Generated test/vitest console output logs (produced by `npm test` redirects)
full-test-output.log
test-full-output.log
*-test-output.log

# ESLint JSON report consumed by scripts/lint-ratchet.mjs (CI artifact, never committed)
eslint-report.json

# Shadow-read governance scanner output (regenerated by npm run governance:scan-shadow-reads /
# governance:classify-shadows; the persisted ratchet baseline lives in .governance/ instead)
/shadow_read_violations.json
/shadow_read_classification.json
