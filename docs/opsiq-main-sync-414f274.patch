+    if (!experiment) {
+      return Response.json(
+        { error: "Experiment not found" },
+        { status: 404 }
+      );
+    }
+
+    const archived = await captureLearning(experiment, validated, workspaceId, session.user.id);
+    experimentStore.set(experimentId, archived);
+
