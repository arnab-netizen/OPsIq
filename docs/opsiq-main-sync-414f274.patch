+        engagementCount: 1,
+        healthyEngagements: 1,
+        atRiskEngagements: 0,
+        criticalEngagements: 0,
+        activeKPICount: 10,
+        onTrackKPICount: 8,
+        actionQueueSize: 5,
+        overdueActionCount: 0,
+        averageExecutionCertainty: 75,
+        engagementHealthSnapshots: [],
+        topRisks: [],
+        recommendedActions: [],
+      };
+
+      const actionQueue = {
