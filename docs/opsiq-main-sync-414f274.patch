+
+  describe("Optimize Price", () => {
+    const tier = {
+      id: "pt-1",
+      workspaceId,
+      name: "Standard",
+      entryPrice: 99,
+      maxPrice: 299,
+      targetMargin: 0.6,
+      features: ["Feature1"],
