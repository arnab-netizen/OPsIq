{
  "name": "opsiq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "node scripts/release/production-migration-gate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "validate:deployment": "tsx scripts/validate-deployment.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "OPSIQ_DB_TARGET=local prisma migrate dev",
    "db:migrate:deploy": "OPSIQ_DB_TARGET=local prisma migrate deploy",
    "db:push": "OPSIQ_DB_TARGET=local prisma db push",
    "db:studio": "OPSIQ_DB_TARGET=local prisma studio",
    "db:reset": "OPSIQ_DB_TARGET=local prisma migrate reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "TEST_WITH_DB=true vitest run",
    "test:merge": "vitest run",
    "test:ci": "vitest run --maxWorkers 1",
    "test:integration": "vitest run --include='**/*.integration.test.ts' --exclude='**/*.placeholder.test.ts'",
    "test:mvp": "vitest run src/__tests__/mvp-operational-flow.test.ts",
    "test:db": "TEST_WITH_DB=true vitest run --testNamePattern='\\[db\\]'",
    "test:stripe-sim": "vitest run src/tests/stripe-sim/stripe-simulation.test.ts",
    "test:owner-real-world-smb": "vitest run tests/owner-mode/real-world-smb-cases",
    "test:owner-real-world-simulation": "vitest run tests/owner-mode/real-world-simulation",
    "dev:backbone": "vitest run src/__tests__/backbone.test.ts",
    "governance:scan-shadow-reads": "tsx src/governance/auth-shadow-read-scanner.ts",
    "governance:classify-shadows": "tsx src/governance/shadow-read-classifier.ts",
    "governance:ci-gate": "tsx src/governance/ci-shadow-read-gate.ts",
    "governance:phase-g2": "node scripts/phase-g2-compiler-hardening.js",
    "governance:scan": "tsx scripts/governance-scan.ts",
    "governance:scan:strict": "tsx scripts/governance-scan.ts --strict",
    "governance:scan:auth": "tsx scripts/auth-governance-scanner.ts",
    "smoke:prod": "tsx scripts/smoke-tests.ts",
    "smoke:staging": "tsx scripts/smoke-tests.ts --env=staging",
    "deployment:preflight": "node scripts/deployment-preflight.mjs",
    "deployment:smoke": "node scripts/production-smoke.mjs",
    "support:diagnostics": "node scripts/support-diagnostics.mjs",
    "demo:seed": "node scripts/seed-demo-workspace.mjs",
    "audit:wrapped-handlers": "node scripts/audit-wrapped-handlers.js audit",
    "audit:wrapped-handlers:ratchet": "node scripts/audit-wrapped-handlers.js ratchet",
    "audit:wrapped-handlers:update-baseline": "node scripts/audit-wrapped-handlers.js update-baseline",
    "governance:scan:a77": "tsx scripts/a77-prevention-gates.ts",
    "evidence:validate": "node scripts/validate-evidence-artifacts.mjs",
    "evidence:validate:strict": "node scripts/validate-evidence-artifacts.mjs --require-accepted --require-provenance"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "@prisma/adapter-neon": "^7.7.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "@sentry/nextjs": "^10.56.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/functions": "^3.9.3",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "next": "16.3.5",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.1.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "glob": "^13.0.6",
    "js-yaml": "^4.1.0",
    "jscodeshift": "^0.14.0",
    "jsdom": "^29.0.2",
    "playwright": "^1.60.0",
    "prisma": "^7.7.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "undici": "7.29.0",
    "vite": "8.1.4",
    "hono": "4.12.28",
    "mysql2": "3.23.1",
    "deepmerge-ts": "8.0.0"
  }
}
