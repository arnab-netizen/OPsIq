{
  "name": "opsiq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "validate:deployment": "tsx scripts/validate-deployment.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "TEST_WITH_DB=true vitest run",
    "test:merge": "vitest run",
    "test:ci": "vitest run --maxWorkers 1",
    "test:integration": "vitest run --include='**/*.integration.test.ts' --exclude='**/*.placeholder.test.ts'",
    "test:mvp": "vitest run src/__tests__/mvp-operational-flow.test.ts",
    "test:db": "TEST_WITH_DB=true vitest run --testNamePattern='\\[db\\]'",
    "test:stripe-sim": "vitest run src/tests/stripe-sim/stripe-simulation.test.ts",
    "dev:backbone": "vitest run src/__tests__/backbone.test.ts",
    "governance:scan-shadow-reads": "tsx src/governance/auth-shadow-read-scanner.ts",
    "governance:classify-shadows": "tsx src/governance/shadow-read-classifier.ts",
    "governance:ci-gate": "tsx src/governance/ci-shadow-read-gate.ts",
    "governance:phase-g2": "node scripts/phase-g2-compiler-hardening.js",
    "governance:scan": "tsx scripts/governance-scan.ts",
    "governance:scan:strict": "tsx scripts/governance-scan.ts --strict",
    "smoke:prod": "tsx scripts/smoke-tests.ts",
    "smoke:staging": "tsx scripts/smoke-tests.ts --env=staging"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.0",
    "@prisma/adapter-neon": "^7.7.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.1.0",
    "next": "16.2.3",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.1.0",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "js-yaml": "^4.1.0",
    "jscodeshift": "^0.14.0",
    "jsdom": "^29.0.2",
    "playwright": "^1.60.0",
    "prisma": "^7.7.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.9",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.4"
  }
}
