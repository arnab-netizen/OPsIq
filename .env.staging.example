# R2 Staging Environment Configuration

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/opsiq_staging

# Application
NODE_ENV=staging
NEXT_PUBLIC_API_URL=http://localhost:3001
PORT=3001

# Auth (test credentials)
AUTH_SECRET=test-secret-staging-only

# Stripe (Stripe Test Mode)
STRIPE_SECRET_KEY=sk_test_xxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_test_xxxxxxx

# Session
SESSION_EXPIRY_HOURS=24

# Features
ENABLE_READINESS_ENFORCEMENT=true
ENABLE_AUDIT_LOGGING=true
ENABLE_IDEMPOTENCY_CHECKING=true
ENABLE_RATE_LIMITING=false

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Observability
ENABLE_METRICS_ENDPOINT=true
ENABLE_REQUEST_TRACING=true
CORRELATION_ID_HEADER=x-correlation-id

# Test Data
SEED_TEST_USERS=true
SEED_TEST_WORKSPACES=true
SEED_TEST_ENGAGEMENTS=true
