# OpsIQ Environment Configuration
# Copy to .env.local (development) or configure via secrets manager (production)
#
# This file is the SINGLE SOURCE OF TRUTH for the environment contract.
#
# MINIMAL CONTRACT TO BOOT AND SERVE (stranger-safe customer journey):
#   - DATABASE_URL        (required)
#   - NODE_ENV            (required; controls prod cookie/security behavior)
#   - NEXT_PUBLIC_APP_URL (required in production for correct absolute links)
# Everything else below is OPTIONAL. In particular, Stripe is NOT required to
# boot: signup, login, and diagnosis have no payment dependency, and the Stripe
# clients are lazily initialized. Missing Stripe => billing disabled (a warning),
# never a startup failure.

# ============================================================================
# 1. DATABASE - REQUIRED FOR ALL ENVIRONMENTS
# ============================================================================
# Format: postgresql://user:password@host:port/database?sslmode=require
#
# Neon has TWO endpoint types and they are used for DIFFERENT purposes:
#   - POOLED  (host contains "-pooler"): runtime app connections (DATABASE_URL).
#   - DIRECT  (host WITHOUT "-pooler"):  schema migrations (MIGRATION_DATABASE_URL).
# Using a pooler URL for migrations can break Prisma (advisory locks / DDL).
#
# DATABASE_URL = pooled runtime URL for the app (REQUIRED for build + runtime).
# For local development: use localhost:5432. For Neon: use the pooler URL.
DATABASE_URL="postgresql://user:password@localhost:5432/opsiq_dev?schema=public"

# MIGRATION_DATABASE_URL = DIRECT (non-pooler) URL used ONLY by the Prisma CLI
# for migrations. Set this in the deploy/CI environment (never commit a real
# value). If unset, the Prisma CLI falls back to DATABASE_URL (fine for local).
# For Neon, this MUST be the direct endpoint (host WITHOUT "-pooler").
# MIGRATION_DATABASE_URL="postgresql://user:password@ep-xxxx.REGION.aws.neon.tech/dbname?sslmode=require"

# Optional: separate test database (defaults to DATABASE_URL if not set)
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/opsiq_test?schema=public"
# DATABASE_URL_TEST="postgresql://user:password@localhost:5432/opsiq_test?schema=public"

# DEPRECATED / AMBIGUOUS: DIRECT_URL is not read by prisma.config.ts. Do not rely
# on it for migrations. Use MIGRATION_DATABASE_URL (true non-pooler direct URL).
# DIRECT_URL=  # deprecated — prefer MIGRATION_DATABASE_URL

# ============================================================================
# 2. NODE ENVIRONMENT
# ============================================================================
# Values: development | staging | production
NODE_ENV="development"

# ============================================================================
# 3. AUTHENTICATION - OPTIONAL (session/cookie based; no secret required)
# ============================================================================
# OpsIQ uses a database-backed session cookie (no NextAuth, no JWT). The core
# auth flow (signup/login/session) requires NO signing secret.
# AUTH_SECRET: optional — present in config schema for diagnostic presence checks
# and optional future integrations. Leave blank to skip; does NOT affect session auth.
# (NEXTAUTH_SECRET / NEXTAUTH_URL are NOT used by this application.)
# Generate (only if you have an integration that needs it): openssl rand -base64 32
AUTH_SECRET=""
# AUTH_URL: REMOVED — was never read by any runtime code. Use NEXT_PUBLIC_APP_URL instead.

# ============================================================================
# 4. APPLICATION URLs - NEXT_PUBLIC_APP_URL REQUIRED FOR PRODUCTION
# ============================================================================
NEXT_PUBLIC_APP_NAME="OpsIQ"

# Public URL where application is accessible from browser (CANONICAL).
# Development: http://localhost:3000
# Staging: https://staging.opsiq.example.com
# Production: https://opsiq.example.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NEXT_PUBLIC_API_URL is a LEGACY ALIAS for NEXT_PUBLIC_APP_URL. It is not read
# by the application; set NEXT_PUBLIC_APP_URL instead. Retained only so older
# deployment scripts that still reference it continue to validate.
# NEXT_PUBLIC_API_URL="http://localhost:3000"

# ============================================================================
# 5. STRIPE - OPTIONAL (billing only; NOT required to boot or serve)
# ============================================================================
# Get these from: https://dashboard.stripe.com/apikeys
# For DEVELOPMENT: use sk_test_* and pk_test_*
# For PRODUCTION: use sk_live_* and pk_live_*
# If unset, billing is simply disabled (a warning) — the app still boots and the
# customer journey (signup/login/diagnosis) works normally.

# Stripe Secret Key (server-side only, never expose to browser) — CANONICAL name.
# Legacy alias: STRIPE_API_KEY is still accepted if STRIPE_SECRET_KEY is unset.
STRIPE_SECRET_KEY=""
# STRIPE_API_KEY=""  # legacy alias for STRIPE_SECRET_KEY (optional)

# Stripe Webhook Signing Secret (from Webhooks page in Stripe dashboard)
STRIPE_WEBHOOK_SECRET=""

# Stripe Publishable Key (safe to expose to browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ----------------------------------------------------------------------------
# External-system OAuth token encryption (B13) — REQUIRED before any external
# connector stores a token. Master key for authenticated AES-256-GCM at rest;
# a per-workspace key is HKDF-derived from it. Must decode to >= 32 bytes
# (base64 or hex). If unset, token encrypt/decrypt FAIL CLOSED (they throw) —
# there is no insecure base64 fallback. Generate with: openssl rand -base64 32
OAUTH_TOKEN_ENCRYPTION_KEY=""

# ----------------------------------------------------------------------------
# AI / LLM Provider (optional — deterministic fallback active when absent)
# Obtain from: https://platform.openai.com/api-keys
# When set, the governed advisory copilot uses live LLM analysis (advisory-only,
# fail-closed). When unset, the system falls back to its deterministic engine.
OPENAI_API_KEY=""

# Anthropic Claude (alternative AI provider — optional, same fail-closed guarantee)
# Obtain from: https://console.anthropic.com/settings/api-keys
# Models: claude-haiku-4-5-20251001 (cheap), claude-sonnet-5 (strong)
ANTHROPIC_API_KEY=""

# ----------------------------------------------------------------------------
# Live Connectors (optional — PLACEHOLDER_ONLY until credentials configured)
# All connectors are fail-closed: missing credentials → connector disabled,
# deterministic fallback active, no startup failure.

# Google Sheets / Google OAuth (import & export connector)
# Obtain from: https://console.cloud.google.com/apis/credentials
# Required scopes: spreadsheets.readonly (import) / spreadsheets (export)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"

# HubSpot CRM Connector (optional — customer & lead data import)
# Obtain from: https://developers.hubspot.com/docs/api/overview
# Required scopes: contacts, companies, deals
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI="http://localhost:3000/api/integrations/hubspot/callback"

# QuickBooks Accounting Connector (optional — financial data import)
# Obtain from: https://developer.intuit.com/app/developer/qbo/docs/develop
# Required scopes: com.intuit.quickbooks.accounting
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_REDIRECT_URI="http://localhost:3000/api/integrations/quickbooks/callback"
QUICKBOOKS_ENVIRONMENT="sandbox"  # sandbox | production

# Slack Notifications Connector (optional — owner alert delivery)
# Obtain from: https://api.slack.com/apps (Bot Token Scopes: chat:write)
SLACK_BOT_TOKEN=""
SLACK_DEFAULT_CHANNEL=""

# ============================================================================
# 6. STORAGE - Optional (defaults to local storage)
# ============================================================================
# Options: local | s3
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"

# For S3 storage (optional):
# STORAGE_S3_BUCKET="opsiq-uploads"
# STORAGE_S3_REGION="us-east-1"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# ============================================================================
# 7. EMAIL TRANSPORT - Required for alert email delivery (Stage 3E)
# ============================================================================
# Get your API key from https://resend.com/api-keys
# Without RESEND_API_KEY the system falls back to in-app-only alert delivery.
# All alerts are still created and visible in-app; no data is lost.
RESEND_API_KEY=           # e.g. re_xxxxxxxxxxxxxxxxxxxx

# Sender address shown on alert emails. Must be a verified Resend domain.
# Defaults to alerts@opsiq.app if not set.
ALERT_FROM_EMAIL=         # e.g. alerts@yourbusiness.com

# ============================================================================
# 8. SCHEDULER - Optional (defaults to in-memory)
# ============================================================================
# Options: in-memory | database
# - in-memory: tasks are lost on cold start (default; safe for development).
# - database: tasks are persisted in the ScheduledTask table (requires Stage 7
#   migrations applied). The Vercel Cron driver at /api/internal/cron/scheduler
#   always uses DatabaseSchedulerProvider regardless of this setting.
# Note: "redis" is accepted by config schema but has no implementation — do NOT
# set SCHEDULER_PROVIDER=redis (causes runtime throw).
SCHEDULER_PROVIDER="in-memory"

# CRON_SECRET: Bearer token that Vercel injects automatically into cron invocations.
# Set this in Vercel project settings (not in .env.local). The cron route at
# /api/internal/cron/scheduler is fail-closed: returns 401 if CRON_SECRET is absent.
# Generate with: openssl rand -base64 32
# CRON_SECRET=""

# ============================================================================
# 8. LOGGING - REQUIRED FOR PRODUCTION
# ============================================================================
# Levels: debug | info | warn | error | critical
LOG_LEVEL="debug"

# For structured logging:
LOG_FORMAT="json"

# ============================================================================
# 9. OBSERVABILITY & MONITORING - Recommended for production
# ============================================================================

# Sentry Error Tracking (optional but recommended)
SENTRY_DSN=""

# DECISION_SIGNING_SECRET: REQUIRED in production — signs governed decision hashes
# to detect tampering. If absent in production the signing module throws (fail-closed).
# Generate with: openssl rand -base64 32
DECISION_SIGNING_SECRET=""

# OPSIQ_DIAGNOSTIC_KEY (optional): gates internal diagnostic/ops endpoints
# (/api/internal/*, /api/ops/*) and protected error-detail responses. If unset,
# those support endpoints stay locked (fail-closed). Not required for the
# customer journey. Generate with: openssl rand -base64 32
OPSIQ_DIAGNOSTIC_KEY=""

# Datadog APM & Metrics (optional)
# DATADOG_API_KEY=""
# DATADOG_SITE="datadoghq.com"

# New Relic APM (optional)
# NEW_RELIC_LICENSE_KEY=""

# Custom Tracing (optional)
ENABLE_REQUEST_TRACING="false"
CORRELATION_ID_HEADER="x-correlation-id"

# ============================================================================
# 10. FEATURE FLAGS - For controlled rollouts
# ============================================================================
ENABLE_AUDIT_LOGGING="true"
ENABLE_READINESS_ENFORCEMENT="true"
ENABLE_IDEMPOTENCY_CHECKING="true"
ENABLE_RATE_LIMITING="false"

# ============================================================================
# 11. METRICS ENDPOINT - For Prometheus/monitoring
# ============================================================================
ENABLE_METRICS_ENDPOINT="true"

# ============================================================================
# 12. SESSION MANAGEMENT
# ============================================================================
SESSION_EXPIRY_HOURS="24"

# ============================================================================
# 13. PRIVATE DEPLOYMENT — single-operator private build only
# ============================================================================
# NEVER set these in multi-tenant production.
#
# OPSIQ_PRIVATE_WORKSPACE_ID: scoped to one workspace only; required together
# with OPSIQ_PRIVATE_OWNER_USER_ID for a private deployment. When set, the named
# workspace receives ENTERPRISE entitlement without a Stripe subscription. The
# same UUID is used for both Workspace.id and ClientAccount.id in the private
# deployment (see scripts/seed-private-owner.ts).
OPSIQ_PRIVATE_WORKSPACE_ID=""
#
# OPSIQ_PRIVATE_OWNER_USER_ID: used by the seed script and authorization checks
# only. Not consumed by getSubscriptionTier (entitlement tier logic is keyed on
# workspaceId, not userId).
OPSIQ_PRIVATE_OWNER_USER_ID=""

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
# ✓ DATABASE_URL points to production PostgreSQL database
# ✓ NODE_ENV=production
# ✓ AUTH_SECRET is random 32+ char string (use: openssl rand -base64 32)
# ✓ STRIPE_SECRET_KEY is sk_live_* (not sk_test_*)
# ✓ STRIPE_WEBHOOK_SECRET is configured in Stripe dashboard
# ✓ NEXT_PUBLIC_APP_URL matches production domain
# ✓ LOG_LEVEL is 'info' or 'warn' (not 'debug')
# ✓ SENTRY_DSN configured (for error tracking)
# ✓ No secrets hardcoded in this file (use secrets manager)
# ✓ Run: npm run validate:deployment (verifies all required vars)
# ✓ Run: npx prisma migrate deploy (applies database migrations)
# ✓ Run smoke tests after deployment
#
# See docs/DEPLOYMENT_READINESS.md for complete checklist
