# OpsIQ Environment Configuration
# Copy to .env and fill in values

# Database
# PostgreSQL connection string for development
DATABASE_URL="postgresql://user:password@localhost:5432/opsiq_dev?schema=public"
DATABASE_PROVIDER="postgresql"

# PostgreSQL connection string for tests (optional, defaults to DATABASE_URL if not set)
# LOCAL: Copy to .env and set this for local testing
# CI: Set DATABASE_URL_TEST secret in GitHub environment:test for database integration tests
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/opsiq_test?schema=public"

# Note: Tests automatically use SQLite (file:./test.db) unless DATABASE_URL is set to PostgreSQL

# Auth
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="OpsIQ"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storage
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"
# STORAGE_S3_BUCKET=""
# STORAGE_S3_REGION=""

# Scheduler
SCHEDULER_PROVIDER="in-memory"

# Logging
LOG_LEVEL="debug"
