# ============================================================
# OPSIQ LOCAL ENVIRONMENT — NEON + PRISMA
# DO NOT COMMIT THIS FILE
# ============================================================

# ------------------------------------------------------------
# Runtime mode
# ------------------------------------------------------------
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# ------------------------------------------------------------
# Database mode control
# ------------------------------------------------------------
# IMPORTANT:
# TEST_WITH_DB=true means DB-backed tests are allowed to touch Neon/Postgres.
# TEST_WITH_DB=false means unit tests must NOT touch Prisma/Postgres.
#
# For normal local DB debugging with Claude, keep this true.
TEST_WITH_DB=true

# ------------------------------------------------------------
# Neon PostgreSQL — Prisma Client / app runtime
# ------------------------------------------------------------
# Use the POOLED Neon URL here.
# The hostname usually contains "-pooler".
#
# Example shape:
# postgresql://USER:PASSWORD@ep-xxxxx-pooler.region.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
#
DATABASE_URL="postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_POOLED_HOST/REPLACE_DB?sslmode=require&channel_binding=require"

# ------------------------------------------------------------
# Neon PostgreSQL — Prisma migrations / direct DB access
# ------------------------------------------------------------
# Use the DIRECT Neon URL here.
# The hostname usually does NOT contain "-pooler".
#
# Example shape:
# postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
#
DIRECT_URL="postgresql://neondb_owner:npg_SKxszIhoN73i@ep-muddy-rain-ao1oysm0-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ------------------------------------------------------------
# Test database URL
# ------------------------------------------------------------
# Strong recommendation:
# Use a separate Neon TEST branch/database.
# Do NOT use production DB for automated tests.
#
# Safer option:
# DATABASE_URL_TEST should point to the DIRECT test DB URL.
#
DATABASE_URL_TEST="postgresql://neondb_owner:npg_Ep1Tkt5zIrqw@ep-ancient-mountain-anjvs7x0.c-6.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ------------------------------------------------------------
# Prisma
# ------------------------------------------------------------
PRISMA_HIDE_UPDATE_MESSAGE=true

# Optional, useful when debugging Prisma:
# DEBUG=prisma:*

# ------------------------------------------------------------
# App URL
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# ------------------------------------------------------------
# Auth/session placeholders
# Replace with real local dev values if your app requires them.
# ------------------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-local-secret-at-least-32-chars"
NEXTAUTH_SECRET="replace-with-a-long-random-local-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------
# Stripe placeholders
# Keep dummy/test values unless running real Stripe flows.
# Do NOT use live keys locally.
# ------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"

# ------------------------------------------------------------
# OpsIQ safety defaults
# ------------------------------------------------------------
ALLOW_TEST_AUTH=true
ALLOW_LOCAL_DEV_AUTH=true
ENABLE_AUDIT_HASH_CHAIN=true
ENABLE_IDEMPOTENCY=true
ENABLE_WORKSPACE_GUARDS=true