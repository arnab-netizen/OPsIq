# PostgreSQL configuration for production/validation
DATABASE_URL="postgresql://user:password@localhost:5432/opsiq_dev?schema=public"
DATABASE_PROVIDER="postgresql"
NODE_ENV="development"
AUTH_SECRET="dev-secret-key"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="OpsIQ"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"
SCHEDULER_PROVIDER="in-memory"
LOG_LEVEL="debug"
