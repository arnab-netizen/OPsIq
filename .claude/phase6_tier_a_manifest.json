## CURRENT PATTERNS (ALL TIER A ROUTES)

### Common Current Implementation

```typescript
import { withEnforcementFull } from "@/lib/enforced-route";
import { withAuth } from "@/lib/auth-guard";

export const GET = withEnforcementFull(async (request: NextRequest) => {
  // Pattern 1: Extract workspace from header
  const workspaceId = request.headers.get("x-workspace-id") || "system";

  // Pattern 2: Fetch session/policy
  const { session, policy } = await withAuth(undefined, workspaceId);

  // Pattern 3: Simple queries
  const data = await db.model.findMany({
    where: { workspaceId }
  });

  // Pattern 4: Return JSON
  return { data };
});
```

### Target Implementation (Canonical)

```typescript
import { withCanonicalEnforcement } from "@/lib/canonical-route-enforcement";

export const GET = withCanonicalEnforcement(
  async (ctx) => {
    // ctx.verifiedActorId, ctx.verifiedWorkspaceId, etc.

    const data = await db.model.findMany({
      where: { workspaceId: ctx.verifiedWorkspaceId }
    });

    return { data };
  },
  { requireWorkspace: true }
);
```

